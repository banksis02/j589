-- ============================================================
-- AE Carry v2 — ตัวแบก (อัดด้วย hook แบบเบา + เล่นซ้ำ)
--
-- ⏺ อัด: ดักคำสั่ง PlaceGameUnit ของตัวเอง (ได้ "เลขช่องจริง + พิกัดเป๊ะ")
--    - hook ติดตั้งครั้งแรกที่กดอัดเท่านั้น และในนั้นทำแค่ "จดใส่คิว" (เบาสุด)
--    - อัดเฉพาะของเรา (คำสั่งจาก client เราเอง — ของเพื่อนไม่ปน)
-- ▶ โหมดแบก: เจอด่านที่อัดไว้ → วางตามลำดับ+จังหวะเดิม → จบด่านกดรีเพล → วนไป
--    - รีเพลมี cooldown 10 วิ กันสแปมยิงจนโดนเตะ
-- ============================================================
local player = game:GetService("Players").LocalPlayer
local HttpService = game:GetService("HttpService")

local PLACE_OPCODES   = { 66, 64, 65, 67, 68, 69, 70 }
local RESTART_OPCODES = { 61, 58, 59, 60, 62, 63, 64 }
local MAX_STEP_WAIT   = 20

-- ---------- ด่านปัจจุบัน (ทุกโหมด) ----------
local function getCurrentStageKey()
    local found = nil
    pcall(function()
        for _, l in ipairs(player.PlayerGui:GetDescendants()) do
            if l:IsA("TextLabel") and l.Visible and #l.Text < 60 then
                local stage, act = l.Text:match("^%s*(.-)%s*%-%s*Act%s+(%S+)%s*$")
                if stage and #stage >= 3 then
                    found = { stage = stage, act = act }
                    return
                end
            end
        end
    end)
    return found
end

-- ⭐ ใส่ชื่อบัญชีในชื่อไฟล์ — รัน 2 จอ (2 บัญชี) บนเครื่องเดียวกัน ไฟล์จะไม่ทับกัน
local function keyToFile(info)
    return ("ae_carry_%s_%s_act_%s.txt")
        :format(player.Name:gsub("[^%w]", "_"),
                info.stage:gsub("[^%w]", "_"), tostring(info.act):gsub("[^%w]", "_"))
end

local function unitCount()
    local u = workspace:FindFirstChild("Units")
    return u and #u:GetChildren() or 0
end

-- ⭐ นับยูนิตใกล้จุดเป้าหมาย (รัศมี 5) — เช็ค "วางติดไหม" แบบไม่โดนตัวของเพื่อน
--    ที่วางที่อื่นพร้อมกันหลอก (สำคัญตอนแบก 2 จอ/มีเพื่อนวางด้วย)
local function unitCountNear(pos, radius)
    local u = workspace:FindFirstChild("Units")
    if not u then return 0 end
    local n = 0
    for _, m in ipairs(u:GetChildren()) do
        local ok, p = pcall(function() return m:GetPivot().Position end)
        if ok and p and (p - pos).Magnitude <= radius then
            n = n + 1
        end
    end
    return n
end

-- ---------- ยิงวาง ----------
local replayFiring = false
local function fireOne(op, slot, cf)
    local sig = game:GetService("ReplicatedStorage")
        :WaitForChild("RemoteEvents", 5):WaitForChild("ReplicaSignal", 5)
    replayFiring = true
    pcall(function()
        sig:FireServer(op, "PlaceGameUnit", slot, cf)
    end)
    replayFiring = false
end

-- ⭐ opcode ในห้องหลายคนพุ่งสูง (เจอถึง 75) และเปลี่ยนต่อเซสชัน
--    ระบบ: ลองยิงทีละเลข → เช็คว่าตัวโผล่ใกล้จุดจริง → เจอแล้ว "ล็อก" ใช้ยาว
local lockedOp = nil

local function unitCountNearFwd(pos, radius)  -- forward declare ใช้ใน tryPlace
    local u = workspace:FindFirstChild("Units")
    if not u then return 0 end
    local n = 0
    for _, m in ipairs(u:GetChildren()) do
        local ok, p = pcall(function() return m:GetPivot().Position end)
        if ok and p and (p - pos).Magnitude <= radius then
            n = n + 1
        end
    end
    return n
end

-- พยายามวางด้วยการไล่ opcode — คืน true ถ้าตัวโผล่ใกล้จุด
local function tryPlace(slot, cf, hintOp)
    local target = cf.Position
    local before = unitCountNearFwd(target, 5)
    local function attempt(op)
        fireOne(op, slot, cf)
        task.wait(0.7)
        if unitCountNearFwd(target, 5) > before then
            if lockedOp ~= op then
                lockedOp = op
                print("[Carry] 🔒 ล็อก opcode วาง = " .. op)
            end
            return true
        end
        return false
    end
    -- 1) เลขที่ล็อกไว้ก่อน
    if lockedOp then
        if attempt(lockedOp) then return true end
        if attempt(lockedOp + 1) then return true end
    end
    -- 2) เลขที่อัดไว้ (hint) และรอบๆ
    if hintOp then
        for _, op in ipairs({ hintOp, hintOp + 1, hintOp + 2, hintOp - 1 }) do
            if op ~= lockedOp and attempt(op) then return true end
        end
    end
    -- 3) ไล่ช่วงกว้าง 58-90 (ทีละเลข มี delay — ไม่ใช่ spray รัว)
    for op = 58, 90 do
        if op ~= lockedOp and op ~= hintOp then
            if attempt(op) then return true end
        end
    end
    return false
end

-- ============================================================
-- ⏺ Recorder (hook เบา — ติดตั้งครั้งแรกที่กดอัด)
-- ============================================================
local recording = false
local recSteps = {}
local recLastT = 0
local recKey = nil
local recPending = {}
local hookInstalled = false

local function installHook()
    if hookInstalled then return true end
    local ok = pcall(function()
        local replicaSig = game:GetService("ReplicatedStorage")
            :WaitForChild("RemoteEvents", 5):WaitForChild("ReplicaSignal", 5)
        local oldNC
        oldNC = hookmetamethod(game, "__namecall", function(self, ...)
            -- ⚠️ เบาที่สุด: จดใส่คิวแล้วปล่อยผ่านทันที ห้ามทำอย่างอื่นในนี้
            if recording and not replayFiring and self == replicaSig
               and getnamecallmethod() == "FireServer" then
                local a1, a2, a3, a4 = ...
                if a2 == "PlaceGameUnit" and typeof(a4) == "CFrame" then
                    recPending[#recPending + 1] = { op = a1, slot = a3, cf = a4, t = tick() }
                end
            end
            return oldNC(self, ...)
        end)
    end)
    hookInstalled = ok
    return ok
end

-- ตัวประมวลผลคิว (นอก hook)
task.spawn(function()
    while true do
        task.wait(0.3)
        while #recPending > 0 do
            local item = table.remove(recPending, 1)
            local dt = math.clamp(item.t - recLastT, 0, MAX_STEP_WAIT)
            recLastT = item.t
            table.insert(recSteps, {
                op = item.op,
                slot = item.slot,
                dt = math.floor(dt * 10) / 10,
                cf = { item.cf:GetComponents() },
            })
            print(("[Carry ⏺] #%d ช่อง %s (op %s) | หน่วง %.1fs")
                :format(#recSteps, tostring(item.slot), tostring(item.op), dt))
        end
    end
end)

local function startRecord()
    local info = getCurrentStageKey()
    if not info then
        warn("[Carry] ❌ ไม่รู้ว่าอยู่ด่านไหน — ต้องอัดตอนอยู่ในด่าน")
        return false
    end
    if not installHook() then
        warn("[Carry] ❌ ติดตั้งตัวดักไม่ได้ (executor ไม่รองรับ hookmetamethod)")
        return false
    end
    recKey = info
    recSteps = {}
    recPending = {}
    recLastT = tick()
    recording = true
    print(("[Carry ⏺] เริ่มอัด: %s - Act %s | วางตัวได้เลย"):format(info.stage, info.act))
    return true
end

local function stopRecord()
    recording = false
    local t0 = tick()
    while #recPending > 0 and tick() - t0 < 3 do
        task.wait(0.2)
    end
    task.wait(0.5)
    if not recKey or #recSteps == 0 then
        warn("[Carry] ⚠️ ไม่มีข้อมูลอัด — ไม่บันทึก")
        return false
    end
    local file = keyToFile(recKey)
    local ok = pcall(function()
        writefile(file, HttpService:JSONEncode({
            stage = recKey.stage,
            act = recKey.act,
            steps = recSteps,
        }))
    end)
    if ok then
        print(("[Carry 💾] บันทึกแล้ว: %s (%d ตัว)"):format(file, #recSteps))
    else
        warn("[Carry] ❌ เขียนไฟล์ไม่สำเร็จ")
    end
    return ok
end

local function loadRecord(info)
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(keyToFile(info)))
    end)
    if ok and type(data) == "table" and type(data.steps) == "table" and #data.steps > 0 then
        return data
    end
    return nil
end

-- ============================================================
-- ▶ Playback + Auto-Replay
-- ============================================================
local carryOn = false
local playedThisMatch = false
local lastUnitsSeen = 0

local function findRepeatBtn()
    local prompt = player.PlayerGui:FindFirstChild("Prompt")
    if not prompt then return nil end
    for _, btn in ipairs(prompt:GetDescendants()) do
        if btn:IsA("GuiButton") and btn.Visible then
            for _, l in ipairs(btn:GetDescendants()) do
                if l:IsA("TextLabel") and l.Text == "Repeat Stage" then
                    return btn
                end
            end
        end
    end
    return nil
end

-- ⭐ Restart: opcode ก็เลื่อนสูงได้ในห้องหลายคน — กวาดทีละหน้าต่าง 8 เลขต่อการกด
--    (กดครั้งแรก 58-65, ยังไม่ติดรออีก 10 วิ กด 66-73, ...) + เริ่มใกล้ lockedOp ถ้ารู้
local restartWinStart = nil
local function fireRestart()
    local sig = game:GetService("ReplicatedStorage")
        :WaitForChild("RemoteEvents", 5):WaitForChild("ReplicaSignal", 5)
    if not restartWinStart then
        restartWinStart = lockedOp and math.max(58, lockedOp - 6) or 58
    end
    replayFiring = true
    for op = restartWinStart, restartWinStart + 7 do
        pcall(function() sig:FireServer(op, "Restart") end)
        task.wait(0.05)
    end
    replayFiring = false
    print(("[Carry] 🔄 Restart opcodes %d-%d"):format(restartWinStart, restartWinStart + 7))
    restartWinStart = restartWinStart + 8
    if restartWinStart > 88 then restartWinStart = 58 end
end

local function playRecord(data)
    print(("[Carry ▶] วางตาม record: %s - Act %s (%d ตัว)")
        :format(data.stage, data.act, #data.steps))
    for i, step in ipairs(data.steps) do
        if not carryOn then return end
        task.wait(math.clamp(step.dt or 1, 0.3, MAX_STEP_WAIT))
        local cf = CFrame.new(unpack(step.cf))
        -- ⭐ tryPlace: ไล่หา opcode ที่ใช้ได้จริง (ล็อกไว้ → ตัวถัดไปเร็ว)
        if tryPlace(step.slot, cf, step.op) then
            print(("[Carry ▶] ✅ #%d ช่อง %d"):format(i, step.slot))
        else
            -- ยังไม่ติด (เงินไม่ทัน?) → รอ 3 วิ ลองอีกรอบ
            task.wait(3)
            if not carryOn then return end
            if tryPlace(step.slot, cf, step.op) then
                print(("[Carry ▶] ✅ #%d ช่อง %d (รอบ 2)"):format(i, step.slot))
            else
                warn(("[Carry ▶] ⚠️ #%d ช่อง %d วางไม่ติด — ข้าม"):format(i, step.slot))
            end
        end
    end
    print("[Carry ▶] ✅ วางครบตาม record แล้ว")
end

-- ลูปรีเพล — ⭐ cooldown 10 วิ/ครั้ง กันสแปมยิงจนโดนเตะ
local lastRestartTry = 0
task.spawn(function()
    while true do
        task.wait(2)
        if carryOn and not recording then
            local btn = findRepeatBtn()
            if btn and tick() - lastRestartTry > 10 then
                lastRestartTry = tick()
                print("[Carry] 🔄 จบด่าน → กดรีเพล")
                fireRestart()
                task.wait(3)
                local b2 = findRepeatBtn()
                if b2 then
                    pcall(function()
                        for _, c in ipairs(getconnections(b2.MouseButton1Click)) do c:Fire() end
                        for _, c in ipairs(getconnections(b2.Activated)) do c:Fire() end
                    end)
                end
            end
        end
    end
end)

-- ลูปวาง
task.spawn(function()
    while true do
        task.wait(2)
        if carryOn and not recording then
            local info = getCurrentStageKey()
            if not info then
                playedThisMatch = false
            else
                local units = unitCount()
                if playedThisMatch and units == 0 and lastUnitsSeen > 0 then
                    print("[Carry] 🔄 ตัวในสนามหาย (ตาใหม่) → วางรอบใหม่")
                    playedThisMatch = false
                end
                lastUnitsSeen = units
                if not playedThisMatch and not findRepeatBtn() then
                    local data = loadRecord(info)
                    if data then
                        playedThisMatch = true
                        task.wait(2)
                        playRecord(data)
                    else
                        print(("[Carry] ⚠️ ยังไม่เคยอัดด่าน %s - Act %s")
                            :format(info.stage, info.act))
                        playedThisMatch = true
                    end
                end
            end
        end
    end
end)


-- ============================================================
-- AE Carry — ตัวแบก (สคริปต์แยกเทส ยังไม่รวมสคริปต์หลัก)
--
-- คอนเซ็ปต์: "อัดครั้งเดียว เล่นซ้ำได้ตลอด"
--   1. เข้าด่านที่จะแบก → กด ⏺ อัด → วางตัวเองแบบละเอียดจนพอใจ → กดหยุดอัด
--      สคริปต์จำ: ชื่อยูนิต + ตำแหน่ง + จังหวะเวลาระหว่างวาง ผูกกับชื่อด่าน
--   2. เปิด ▶ โหมดแบก → เจอด่านที่เคยอัดไว้ → วางตามที่อัดอัตโนมัติทุกตา
--      (จับ restart ด้วย: ตัวในสนามหาย → วางใหม่)
--
-- บันทึกไฟล์: ae_carry_<ด่าน>_act_<แอค>.txt (JSON) — อัดทับได้ตลอด
-- ============================================================
local player = game:GetService("Players").LocalPlayer
local HttpService = game:GetService("HttpService")

-- ================== CONFIG ==================
local PLACE_OPCODES = { 66, 64, 65, 67, 68, 69, 70 }
local MAX_STEP_WAIT = 20     -- จังหวะรอระหว่างวางสูงสุด (วิ) — กันอัดตอนเผลอทิ้งช่วงนาน
-- ============================================

-- ---------- สถานะปัจจุบัน: ด่าน + Act ----------
-- ⭐ ไม่ฟิคลิสต์ด่าน — จับ label "<ชื่อด่านอะไรก็ได้> - Act <X>" จาก HUD
--    รองรับทุกโหมด: Story (School Grounds - Act 1), Raid (Spirit City - Act 1) ฯลฯ
local function getCurrentStageKey()
    local found = nil
    pcall(function()
        for _, l in ipairs(player.PlayerGui:GetDescendants()) do
            if l:IsA("TextLabel") and l.Visible and #l.Text < 60 then
                local stage, act = l.Text:match("^%s*(.-)%s*%-%s*Act%s+(%S+)%s*$")
                if stage and stage ~= "" and #stage >= 3 then
                    found = { stage = stage, act = act }
                    return
                end
            end
        end
    end)
    return found
end

local function keyToFile(info)
    return ("ae_carry_%s_act_%s.txt")
        :format(info.stage:gsub("[^%w]", "_"), tostring(info.act):gsub("[^%w]", "_"))
end

-- ---------- hotbar: slot <-> ชื่อยูนิต ----------
local GENERIC = { Model = true, AnimSaves = true, WorldModel = true, Folder = true }
local function getSlotButtons()
    local bh = player.PlayerGui:FindFirstChild("BottomHUD")
    if not bh then return {} end
    local slots = {}
    for _, tb in ipairs(bh:GetDescendants()) do
        if tb:IsA("TextButton") then
            for _, d in ipairs(tb:GetDescendants()) do
                if d:IsA("ViewportFrame") then
                    table.insert(slots, tb)
                    break
                end
            end
        end
    end
    return slots
end

local function slotUnitName(slotIndex)
    local slots = getSlotButtons()
    local tb = slots[slotIndex]
    if not tb then return nil end
    for _, d in ipairs(tb:GetDescendants()) do
        if d:IsA("Model") and not GENERIC[d.Name] then
            return d.Name
        end
    end
    return nil
end

local function findSlotByUnitName(name)
    local lower = name:lower()
    for i, tb in ipairs(getSlotButtons()) do
        for _, d in ipairs(tb:GetDescendants()) do
            if d.Name:lower():find(lower, 1, true) then
                return i
            end
        end
    end
    return nil
end

local function unitCount()
    local u = workspace:FindFirstChild("Units")
    return u and #u:GetChildren() or 0
end

-- ---------- ยิงวาง ----------
local replayFiring = false
local function firePlace(slot, cf)
    local sig = game:GetService("ReplicatedStorage")
        :WaitForChild("RemoteEvents", 5):WaitForChild("ReplicaSignal", 5)
    replayFiring = true
    for _, op in ipairs(PLACE_OPCODES) do
        pcall(function()
            sig:FireServer(op, "PlaceGameUnit", slot, cf)
        end)
        task.wait(0.05)
    end
    replayFiring = false
end

-- ============================================================
-- โหมดอัด (Recorder)
-- ============================================================
local recording = false
local recSteps = {}
local recLastT = 0
local recKey = nil
local recPending = {}   -- ⭐ hook จดใส่คิวอย่างเดียว (เบาสุด) — ประมวลผลนอก hook

pcall(function()
    local replicaSig = game:GetService("ReplicatedStorage")
        :WaitForChild("RemoteEvents", 5):WaitForChild("ReplicaSignal", 5)
    local oldNC
    oldNC = hookmetamethod(game, "__namecall", function(self, ...)
        -- ⚠️ ห้ามทำงานหนักในนี้เด็ดขาด — แค่จดแล้วปล่อยผ่านทันที
        if recording and not replayFiring and self == replicaSig
           and getnamecallmethod() == "FireServer" then
            local _, a2, a3, a4 = ...
            if a2 == "PlaceGameUnit" and typeof(a4) == "CFrame" then
                recPending[#recPending + 1] = { slot = a3, cf = a4, t = tick() }
            end
        end
        return oldNC(self, ...)
    end)
end)

-- ⭐ ตัวประมวลผลคิว (นอก hook): หา ชื่อยูนิต + คำนวณ dt + print
task.spawn(function()
    while true do
        task.wait(0.3)
        while #recPending > 0 do
            local item = table.remove(recPending, 1)
            local dt = math.min(item.t - recLastT, MAX_STEP_WAIT)
            if dt < 0 then dt = 0 end
            recLastT = item.t
            local uname = "slot_" .. tostring(item.slot)
            pcall(function()
                uname = slotUnitName(item.slot) or uname
            end)
            table.insert(recSteps, {
                unit = uname,
                slot = item.slot,
                dt = math.floor(dt * 10) / 10,
                cf = { item.cf:GetComponents() },
            })
            print(("[Carry ⏺] #%d %s (slot %s) | หน่วง %.1fs")
                :format(#recSteps, uname, tostring(item.slot), dt))
        end
    end
end)

local function startRecord()
    local info = getCurrentStageKey()
    if not info then
        warn("[Carry] ❌ ไม่รู้ว่าอยู่ด่านไหน — ต้องอัดตอนอยู่ในด่าน")
        return false
    end
    recKey = info
    recSteps = {}
    recPending = {}
    recLastT = tick()
    recording = true
    print(("[Carry ⏺] เริ่มอัด: %s - Act %s | วางตัวได้เลย ทุกการวางจะถูกจำ")
        :format(info.stage, info.act))
    return true
end

local function stopRecord()
    recording = false
    -- รอคิวประมวลผลเก็บตกให้หมดก่อนบันทึก
    local t0 = tick()
    while #recPending > 0 and tick() - t0 < 3 do
        task.wait(0.2)
    end
    task.wait(0.5)
    if not recKey or #recSteps == 0 then
        warn("[Carry] ⚠️ ไม่มีข้อมูลอัด — ไม่บันทึก")
        return false
    end
    local file = keyToFile(recKey)
    local ok = pcall(function()
        writefile(file, HttpService:JSONEncode({
            stage = recKey.stage,
            act = recKey.act,
            steps = recSteps,
        }))
    end)
    if ok then
        print(("[Carry 💾] บันทึกแล้ว: %s (%d ตัว)"):format(file, #recSteps))
    else
        warn("[Carry] ❌ เขียนไฟล์ไม่สำเร็จ")
    end
    return ok
end

local function loadRecord(info)
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(keyToFile(info)))
    end)
    if ok and type(data) == "table" and type(data.steps) == "table" and #data.steps > 0 then
        return data
    end
    return nil
end

-- ============================================================
-- ⭐ Auto-Replay: จบด่านแล้วกดรีเพลเอง (เฉพาะตอนโหมดแบก ON)
-- ============================================================
local RESTART_OPCODES = { 61, 58, 59, 60, 62, 63, 64 }

local function findRepeatBtn()
    local prompt = player.PlayerGui:FindFirstChild("Prompt")
    if not prompt then return nil end
    for _, btn in ipairs(prompt:GetDescendants()) do
        if btn:IsA("GuiButton") and btn.Visible then
            for _, l in ipairs(btn:GetDescendants()) do
                if l:IsA("TextLabel") and l.Text == "Repeat Stage" then
                    return btn
                end
            end
        end
    end
    return nil
end

local function fireRestart()
    local sig = game:GetService("ReplicatedStorage")
        :WaitForChild("RemoteEvents", 5):WaitForChild("ReplicaSignal", 5)
    replayFiring = true
    for _, op in ipairs(RESTART_OPCODES) do
        pcall(function() sig:FireServer(op, "Restart") end)
        task.wait(0.05)
    end
    replayFiring = false
end

-- ============================================================
-- โหมดแบก (Playback)
-- ============================================================
local carryOn = false
local playedThisMatch = false
local lastUnitsSeen = 0

local function playRecord(data)
    print(("[Carry ▶] วางตาม record: %s - Act %s (%d ตัว)")
        :format(data.stage, data.act, #data.steps))
    for i, step in ipairs(data.steps) do
        if not carryOn then return end
        task.wait(math.clamp(step.dt or 1, 0.3, MAX_STEP_WAIT))
        -- หา slot จากชื่อยูนิต (กันกรณีสลับตำแหน่ง hotbar) — fallback slot ที่อัดไว้
        local slot = findSlotByUnitName(step.unit) or step.slot
        local cf = CFrame.new(unpack(step.cf))
        local before = unitCount()
        firePlace(slot, cf)
        task.wait(0.8)
        if unitCount() > before then
            print(("[Carry ▶] ✅ #%d %s (slot %d)"):format(i, step.unit, slot))
        else
            -- วางไม่ติด (เงิน/ลิมิต/จุดโดนทับ) — ลองซ้ำอีกครั้งเดียวแล้วไปต่อ
            task.wait(2)
            firePlace(slot, cf)
            task.wait(0.8)
            if unitCount() > before then
                print(("[Carry ▶] ✅ #%d %s (รอบ 2)"):format(i, step.unit))
            else
                warn(("[Carry ▶] ⚠️ #%d %s วางไม่ติด — ข้าม"):format(i, step.unit))
            end
        end
    end
    print("[Carry ▶] ✅ วางครบตาม record แล้ว")
end

-- ⭐ ลูปกดรีเพลตอนจบด่าน (แยกจากลูปวาง)
task.spawn(function()
    while true do
        task.wait(2)
        if carryOn and not recording then
            local btn = findRepeatBtn()
            if btn then
                print("[Carry] 🔄 จบด่าน → กดรีเพล")
                fireRestart()
                task.wait(3)
                -- ยังค้าง → กดปุ่ม Repeat Stage ตรงๆ (getconnections)
                local b2 = findRepeatBtn()
                if b2 then
                    pcall(function()
                        for _, c in ipairs(getconnections(b2.MouseButton1Click)) do c:Fire() end
                        for _, c in ipairs(getconnections(b2.Activated)) do c:Fire() end
                    end)
                    task.wait(3)
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(2)
        if carryOn and not recording then
            local info = getCurrentStageKey()
            if not info then
                playedThisMatch = false   -- ออกจากด่าน/ล็อบบี้ → พร้อมวางรอบใหม่
            else
                local units = unitCount()
                -- จับ restart: เคยวางแล้ว แต่ตัวในสนามหายเกลี้ยง → วางใหม่
                if playedThisMatch and units == 0 and lastUnitsSeen > 0 then
                    print("[Carry] 🔄 ตัวในสนามหาย (restart?) → วางรอบใหม่")
                    playedThisMatch = false
                end
                lastUnitsSeen = units
                if not playedThisMatch and not findRepeatBtn() then  -- ห้ามวางตอนหน้าจบเกมค้าง
                    local data = loadRecord(info)
                    if data then
                        playedThisMatch = true
                        task.wait(2)   -- รอด่านโหลดนิ่ง
                        playRecord(data)
                    else
                        print(("[Carry] ⚠️ ยังไม่เคยอัดด่าน %s - Act %s (อัดก่อนถึงใช้ได้)")
                            :format(info.stage, info.act))
                        playedThisMatch = true   -- กันสแปมเตือน (reset ตอนออกด่าน)
                    end
                end
            end
        end
    end
end)


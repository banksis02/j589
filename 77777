-- ============================================================
-- ⏺ Recorder (hook เบา — ติดตั้งครั้งแรกที่กดอัด)
-- ============================================================
-- ⭐ v11: เก็บเป็น "timeline" — ทุก action (วาง/ปรับการโจมตี/อัพเกรดมือ/ออโต้) จำเวลา+ลำดับจริง
--    event: { t=เวลาสัมพัทธ์(วิ), k="place"|"prio"|"up"|"auto", ... }
--      place: {t,k="place", slot, cf, uid}  (uid = id ยูนิตตอนอัด — bind ด้วยตำแหน่งทีหลัง)
--      prio : {t,k="prio",  uid, prio}   up: {t,k="up", uid}   auto: {t,k="auto", uid}
local recording = false
local recEvents = {}    -- timeline (เรียงตามเวลา)
local recStartT = 0
local recKey = nil
local recPending = {}   -- คิวดิบจาก hook → ประมวลผลนอก hook
local recPreIds = {}    -- id ยูนิตที่มีอยู่ "ก่อนเริ่มอัด" (ไม่เอามา bind ให้ place)
local hookInstalled = false

local function installHook()
    if hookInstalled then return true end
    local ok = pcall(function()
        local replicaSig = game:GetService("ReplicatedStorage")
            :WaitForChild("RemoteEvents", 5):WaitForChild("ReplicaSignal", 5)
        local oldNC
        oldNC = hookmetamethod(game, "__namecall", function(self, ...)
            -- ⚠️ เบาที่สุด: จดใส่คิวแล้วปล่อยผ่านทันที ห้ามทำอย่างอื่นในนี้
            if recording and not replayFiring and self == replicaSig
               and getnamecallmethod() == "FireServer" then
                local a1, a2, a3, a4 = ...
                if a2 == "PlaceGameUnit" and typeof(a4) == "CFrame" then
                    recPending[#recPending + 1] = { t = tick(), k = "place", slot = a3, cf = a4 }
                elseif a2 == "UpgradeGameUnit" and type(a3) == "string" then
                    recPending[#recPending + 1] = { t = tick(), k = "up", uid = a3 }
                elseif a2 == "ChangeGameUnitPriority" and type(a3) == "string" then
                    recPending[#recPending + 1] = { t = tick(), k = "prio", uid = a3, prio = a4 }
                elseif a2 == "ChangeGameUnitAutoUpgradePriority" and type(a3) == "string" then
                    recPending[#recPending + 1] = { t = tick(), k = "auto", uid = a3 }
                end
            end
            return oldNC(self, ...)
        end)
    end)
    hookInstalled = ok
    return ok
end

-- ตัวประมวลผลคิว (นอก hook): event ดิบ → recEvents (t = เวลาสัมพัทธ์จากเริ่มอัด)
task.spawn(function()
    while true do
        task.wait(0.2)
        while #recPending > 0 do
            local it = table.remove(recPending, 1)
            local ev = { t = math.max(0, it.t - recStartT), k = it.k }
            if it.k == "place" then
                ev.slot = it.slot
                ev.cf = { it.cf:GetComponents() }
                print(("[Carry ⏺] %.1fs วาง ช่อง %s"):format(ev.t, tostring(ev.slot)))
            else
                ev.uid = it.uid
                if it.prio then ev.prio = it.prio end
                local name = (it.k == "prio" and ("ปรับการโจมตี " .. tostring(it.prio)))
                          or (it.k == "up" and "อัพเกรดมือ") or "ออโต้อัพเกรด"
                print(("[Carry ⏺] %.1fs %s (id %s)"):format(ev.t, name, tostring(it.uid)))
            end
            recEvents[#recEvents + 1] = ev
        end
    end
end)

-- ⭐ bind uid ให้ event "place" (id ยูนิตตอนอัด) — จับด้วยตำแหน่ง (ตอนอัด replica ตรงพิกัดจริง)
--    ข้ามยูนิตที่มีอยู่ก่อนอัด (recPreIds) และที่ผูกไปแล้ว
local function bindPlaceUids()
    local units = getMyUnits()
    local assigned = {}
    for _, ev in ipairs(recEvents) do if ev.k == "place" and ev.uid then assigned[ev.uid] = true end end
    for _, ev in ipairs(recEvents) do
        if ev.k == "place" and not ev.uid then
            local target = CFrame.new(unpack(ev.cf)).Position
            local best, bestD
            for _, u in ipairs(units) do
                if u.pos and not recPreIds[u.id] and not assigned[u.id] then
                    local dd = (u.pos - target).Magnitude
                    if not bestD or dd < bestD then best, bestD = u, dd end
                end
            end
            if best then ev.uid = best.id; assigned[best.id] = true end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.5)
        if recording then pcall(bindPlaceUids) end
    end
end)

local function startRecord()
    local info = getCurrentStageKey()
    if not info then
        warn("[Carry] ❌ ไม่รู้ว่าอยู่ด่านไหน — ต้องอัดตอนอยู่ในด่าน")
        return false
    end
    if not installHook() then
        warn("[Carry] ❌ ติดตั้งตัวดักไม่ได้ (executor ไม่รองรับ hookmetamethod)")
        return false
    end
    recKey = info
    recEvents = {}
    recPending = {}
    recPreIds = {}
    for _, u in ipairs(getMyUnits()) do recPreIds[u.id] = true end  -- ยูนิตที่มีอยู่ก่อน = ไม่ใช่ของรอบอัดนี้
    recStartT = tick()
    recording = true
    print(("[Carry ⏺] เริ่มอัด: %s - Act %s | ทำได้เลย — จำ วาง/ปรับการโจมตี/อัพเกรด/ออโต้ ตามเวลา"):format(info.stage, info.act))
    return true
end

local function stopRecord()
    recording = false
    local t0 = tick()
    while #recPending > 0 and tick() - t0 < 3 do task.wait(0.2) end
    task.wait(0.4)
    for _ = 1, 5 do pcall(bindPlaceUids); task.wait(0.3) end   -- bind uid ให้ครบ (ยูนิตท้ายๆ เพิ่งลง registry)
    if not recKey or #recEvents == 0 then
        warn("[Carry] ⚠️ ไม่มีข้อมูลอัด — ไม่บันทึก")
        return false
    end
    local nPlace = 0
    for _, ev in ipairs(recEvents) do if ev.k == "place" then nPlace = nPlace + 1 end end
    print(("[Carry 💾] สรุป timeline %d events (%d วาง):"):format(#recEvents, nPlace))
    for _, ev in ipairs(recEvents) do
        if ev.k == "place" then
            print(("   %.1fs วาง ช่อง %s → id %s"):format(ev.t, tostring(ev.slot), tostring(ev.uid or "?")))
        else
            local name = (ev.k == "prio" and ("ปรับการโจมตี " .. tostring(ev.prio)))
                      or (ev.k == "up" and "อัพเกรดมือ") or "ออโต้อัพเกรด"
            print(("   %.1fs %s (id %s)"):format(ev.t, name, tostring(ev.uid)))
        end
    end
    local file = keyToFile(recKey)
    local ok = pcall(function()
        writefile(file, HttpService:JSONEncode({
            stage = recKey.stage, act = recKey.act, events = recEvents,
        }))
    end)
    if ok then print(("[Carry 💾] บันทึกแล้ว: %s"):format(file))
    else warn("[Carry] ❌ เขียนไฟล์ไม่สำเร็จ") end
    return ok
end

local function loadRecord(info)
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(keyToFile(info)))
    end)
    if ok and type(data) == "table" and type(data.events) == "table" and #data.events > 0 then
        return data
    end
    return nil   -- ไฟล์เก่า (steps) = ไม่รองรับ → ต้องอัดใหม่
end


local function mkBtn(text, posY, color)
    local b = Instance.new("TextButton", frame)
    b.Size = UDim2.new(1, -16, 0, 30)
    b.Position = UDim2.new(0, 8, 0, posY)
    b.BackgroundColor3 = color
    b.TextColor3 = Color3.fromRGB(230, 230, 230)
    b.Text = text; b.TextSize = 11
    b.Font = Enum.Font.GothamBold; b.BorderSizePixel = 0
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
    return b
end

local btnRec   = mkBtn("⏺ อัดการวาง (ด่านนี้)", 42, Color3.fromRGB(45, 35, 35))
local btnCarry = mkBtn("▶ โหมดแบก: OFF", 80, Color3.fromRGB(30, 45, 35))

btnRec.MouseButton1Click:Connect(function()
    if recording then
        stopRecord()
        btnRec.Text = "⏺ อัดการวาง (ด่านนี้)"
        btnRec.BackgroundColor3 = Color3.fromRGB(45, 35, 35)
    else
        if startRecord() then
            btnRec.Text = "⏹ หยุดอัด + บันทึก"
            btnRec.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        end
    end
end)

btnCarry.MouseButton1Click:Connect(function()
    carryOn = not carryOn
    playedThisMatch = false
    if carryOn then
        btnCarry.Text = "⏹ โหมดแบก: ON"
        btnCarry.BackgroundColor3 = Color3.fromRGB(30, 140, 70)
        print("[Carry] ▶ เปิดโหมดแบก — เจอด่านที่เคยอัดจะวางเอง")
    else
        btnCarry.Text = "▶ โหมดแบก: OFF"
        btnCarry.BackgroundColor3 = Color3.fromRGB(30, 45, 35)
        print("[Carry] ⏹ ปิดโหมดแบก")
    end
end)

-- อัปเดตสถานะบน UI
task.spawn(function()
    while true do
        task.wait(2)
        local info = getCurrentStageKey()
        if info then
            local has = loadRecord(info) ~= nil
            status.Text = ("📍 %s - Act %s %s"):format(
                info.stage, info.act, has and "(มี record ✅)" or "(ยังไม่อัด)")
        else
            status.Text = "📍 อยู่ Lobby / ไม่รู้ด่าน"
        end
    end
end)

-- Drag
local UIS = game:GetService("UserInputService")
local dragging, dragStart, frameStart
dragBar.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = UIS:GetMouseLocation()
        frameStart = frame.AbsolutePosition
    end
end)
UIS.InputChanged:Connect(function(i)
    if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
        local m = UIS:GetMouseLocation()
        frame.Position = UDim2.new(0, frameStart.X + m.X - dragStart.X, 0, frameStart.Y + m.Y - dragStart.Y)
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)

_G.AECARRY_STOP = function()
    carryOn = false
    recording = false
    print("[Carry] ⏹ หยุดทั้งหมด")
end

print("[Carry] ✅ พร้อมใช้ | ⏺ อัดในด่าน → ▶ เปิดโหมดแบก")

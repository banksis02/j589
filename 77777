-- ============================================================
-- AE Carry v2 — ตัวแบก (อัดด้วย hook แบบเบา + เล่นซ้ำ)
--
-- ⏺ อัด: ดักคำสั่ง PlaceGameUnit ของตัวเอง (ได้ "เลขช่องจริง + พิกัดเป๊ะ")
--    - hook ติดตั้งครั้งแรกที่กดอัดเท่านั้น และในนั้นทำแค่ "จดใส่คิว" (เบาสุด)
--    - อัดเฉพาะของเรา (คำสั่งจาก client เราเอง — ของเพื่อนไม่ปน)
-- ▶ โหมดแบก: เจอด่านที่อัดไว้ → วางตามลำดับ+จังหวะเดิม → จบด่านกดรีเพล → วนไป
--    - รีเพลมี cooldown 10 วิ กันสแปมยิงจนโดนเตะ
-- ============================================================
print("[Carry] ⏳ เริ่มโหลดสคริปต์...")

local player = game:GetService("Players").LocalPlayer
local HttpService = game:GetService("HttpService")
local RS = game:GetService("ReplicatedStorage")

local MAX_STEP_WAIT = 20

-- ============================================================
-- ⭐ ระบบ Replica — วาง/รีสตาร์ท ผ่าน replica:FireServer โดยตรง
--    (ไม่ต้องเดา opcode/id อีก — เกมจัดการ id เอง เลขพุ่งเท่าไหร่ก็ไม่มีผล)
--    replica ข้อมูลเกมของเรา = Token "GamePlayerData"
-- ============================================================
-- ⚠️ ทุกอย่างต้องมี pcall — ถ้า require พังสคริปต์จะตายเงียบทั้งตัว (ไม่มี UI)
local replicaRegistry = nil
local replicaReady = false
local function setupReplica()
    if replicaReady then return true end
    local ok = pcall(function()
        local shared = RS:FindFirstChild("Shared")
        local mod = shared and shared:FindFirstChild("ReplicaClient")
        if not mod then error("ไม่เจอ ReplicatedStorage.Shared.ReplicaClient") end
        local RC = require(mod)
        if not RC or not RC.FromId then error("ReplicaClient ไม่มี FromId") end
        if not debug or not debug.getupvalues then error("executor ไม่มี debug.getupvalues") end
        for _, up in pairs(debug.getupvalues(RC.FromId)) do
            if type(up) == "table" then
                for kk in pairs(up) do
                    if type(kk) == "number" then replicaRegistry = up; break end
                end
                if replicaRegistry then break end
            end
        end
        if not replicaRegistry then error("หา replica registry ไม่เจอ") end
    end)
    if ok and replicaRegistry then
        replicaReady = true
        print("[Carry] ✅ Replica พร้อม (วางแบบไม่ต้องเดา opcode)")
    end
    return replicaReady
end
-- ลองตั้งแต่โหลด (ถ้ายังไม่ได้ จะลองใหม่ตอนใช้งานจริง)
pcall(setupReplica)

local function getGameReplica()
    if not replicaRegistry then
        pcall(setupReplica)
        if not replicaRegistry then return nil end
    end
    local cand = {}
    for _, rep in pairs(replicaRegistry) do
        local ok, tok = pcall(function() return rep.Token end)
        if ok and tok == "GamePlayerData" then table.insert(cand, rep) end
    end
    if #cand <= 1 then return cand[1] end
    for _, rep in ipairs(cand) do
        if rawget(rep, "write_lib") then return rep end
    end
    return cand[1]
end

-- fallback: ยิง ReplicaSignal ตรงๆ ถ้าใช้ replica ไม่ได้ (ไล่ id กว้าง)
-- ⚠️ ห้ามใช้ ... ใน closure ซ้อน (Lua compile error) — ต้อง table.pack ก่อน
local FALLBACK_OPS = { 66, 65, 64, 67, 68, 69, 70, 61, 62, 63 }
local function fallbackFire(...)
    local args = table.pack(...)
    local ok = pcall(function()
        local sig = RS:WaitForChild("RemoteEvents", 5):WaitForChild("ReplicaSignal", 5)
        for _, op in ipairs(FALLBACK_OPS) do
            pcall(function()
                sig:FireServer(op, table.unpack(args, 1, args.n))
            end)
            task.wait(0.05)
        end
    end)
    return ok
end

-- ยิง action ใดๆ ผ่าน replica เกม (PlaceGameUnit / Restart / SelectSlot / ...)
local function replicaFire(...)
    local args = table.pack(...)
    local rep = getGameReplica()
    if rep then
        local ok = pcall(function()
            rep:FireServer(table.unpack(args, 1, args.n))
        end)
        if ok then return true end
    end
    warn("[Carry] ⚠️ replica ใช้ไม่ได้ → fallback ยิงตรง")
    return fallbackFire(table.unpack(args, 1, args.n))
end

-- ---------- ด่านปัจจุบัน (ทุกโหมด) ----------
local function getCurrentStageKey()
    local found = nil
    pcall(function()
        for _, l in ipairs(player.PlayerGui:GetDescendants()) do
            if l:IsA("TextLabel") and l.Visible and #l.Text < 60 then
                local stage, act = l.Text:match("^%s*(.-)%s*%-%s*Act%s+(%S+)%s*$")
                if stage and #stage >= 3 then
                    found = { stage = stage, act = act }
                    return
                end
            end
        end
    end)
    return found
end

-- ⭐ ใส่ชื่อบัญชีในชื่อไฟล์ — รัน 2 จอ (2 บัญชี) บนเครื่องเดียวกัน ไฟล์จะไม่ทับกัน
local function keyToFile(info)
    return ("ae_carry_%s_%s_act_%s.txt")
        :format(player.Name:gsub("[^%w]", "_"),
                info.stage:gsub("[^%w]", "_"), tostring(info.act):gsub("[^%w]", "_"))
end

local function unitCount()
    local u = workspace:FindFirstChild("Units")
    return u and #u:GetChildren() or 0
end

-- ⭐ นับยูนิตใกล้จุดเป้าหมาย (รัศมี 5) — เช็ค "วางติดไหม" แบบไม่โดนตัวของเพื่อน
--    ที่วางที่อื่นพร้อมกันหลอก (สำคัญตอนแบก 2 จอ/มีเพื่อนวางด้วย)
local function unitCountNear(pos, radius)
    local u = workspace:FindFirstChild("Units")
    if not u then return 0 end
    local n = 0
    for _, m in ipairs(u:GetChildren()) do
        local ok, p = pcall(function() return m:GetPivot().Position end)
        if ok and p and (p - pos).Magnitude <= radius then
            n = n + 1
        end
    end
    return n
end

-- ---------- ยิงวาง (ผ่าน replica) ----------
local replayFiring = false
local function firePlace(slot, cf)
    replayFiring = true
    replicaFire("PlaceGameUnit", slot, cf)
    replayFiring = false
end

-- ============================================================
-- ⏺ Recorder (hook เบา — ติดตั้งครั้งแรกที่กดอัด)
-- ============================================================
local recording = false
local recSteps = {}
local recLastT = 0
local recKey = nil
local recPending = {}
local hookInstalled = false

local function installHook()
    if hookInstalled then return true end
    local ok = pcall(function()
        local replicaSig = game:GetService("ReplicatedStorage")
            :WaitForChild("RemoteEvents", 5):WaitForChild("ReplicaSignal", 5)
        local oldNC
        oldNC = hookmetamethod(game, "__namecall", function(self, ...)
            -- ⚠️ เบาที่สุด: จดใส่คิวแล้วปล่อยผ่านทันที ห้ามทำอย่างอื่นในนี้
            if recording and not replayFiring and self == replicaSig
               and getnamecallmethod() == "FireServer" then
                local a1, a2, a3, a4 = ...
                if a2 == "PlaceGameUnit" and typeof(a4) == "CFrame" then
                    recPending[#recPending + 1] = { slot = a3, cf = a4, t = tick() }
                end
            end
            return oldNC(self, ...)
        end)
    end)
    hookInstalled = ok
    return ok
end

-- ตัวประมวลผลคิว (นอก hook)
task.spawn(function()
    while true do
        task.wait(0.3)
        while #recPending > 0 do
            local item = table.remove(recPending, 1)
            local dt = math.clamp(item.t - recLastT, 0, MAX_STEP_WAIT)
            recLastT = item.t
            table.insert(recSteps, {
                slot = item.slot,
                dt = math.floor(dt * 10) / 10,
                cf = { item.cf:GetComponents() },
            })
            print(("[Carry ⏺] #%d ช่อง %s | หน่วง %.1fs")
                :format(#recSteps, tostring(item.slot), dt))
        end
    end
end)

local function startRecord()
    local info = getCurrentStageKey()
    if not info then
        warn("[Carry] ❌ ไม่รู้ว่าอยู่ด่านไหน — ต้องอัดตอนอยู่ในด่าน")
        return false
    end
    if not installHook() then
        warn("[Carry] ❌ ติดตั้งตัวดักไม่ได้ (executor ไม่รองรับ hookmetamethod)")
        return false
    end
    recKey = info
    recSteps = {}
    recPending = {}
    recLastT = tick()
    recording = true
    print(("[Carry ⏺] เริ่มอัด: %s - Act %s | วางตัวได้เลย"):format(info.stage, info.act))
    return true
end

local function stopRecord()
    recording = false
    local t0 = tick()
    while #recPending > 0 and tick() - t0 < 3 do
        task.wait(0.2)
    end
    task.wait(0.5)
    if not recKey or #recSteps == 0 then
        warn("[Carry] ⚠️ ไม่มีข้อมูลอัด — ไม่บันทึก")
        return false
    end
    local file = keyToFile(recKey)
    local ok = pcall(function()
        writefile(file, HttpService:JSONEncode({
            stage = recKey.stage,
            act = recKey.act,
            steps = recSteps,
        }))
    end)
    if ok then
        print(("[Carry 💾] บันทึกแล้ว: %s (%d ตัว)"):format(file, #recSteps))
    else
        warn("[Carry] ❌ เขียนไฟล์ไม่สำเร็จ")
    end
    return ok
end

local function loadRecord(info)
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(keyToFile(info)))
    end)
    if ok and type(data) == "table" and type(data.steps) == "table" and #data.steps > 0 then
        return data
    end
    return nil
end

-- ============================================================
-- ▶ Playback + Auto-Replay
-- ============================================================
local carryOn = false
local playedThisMatch = false
local lastUnitsSeen = 0

local function findRepeatBtn()
    local prompt = player.PlayerGui:FindFirstChild("Prompt")
    if not prompt then return nil end
    for _, btn in ipairs(prompt:GetDescendants()) do
        if btn:IsA("GuiButton") and btn.Visible then
            for _, l in ipairs(btn:GetDescendants()) do
                if l:IsA("TextLabel") and l.Text == "Repeat Stage" then
                    return btn
                end
            end
        end
    end
    return nil
end

-- ⭐ Restart ผ่าน replica — ไม่ต้องเดา opcode
local function fireRestart()
    replayFiring = true
    replicaFire("Restart")
    replayFiring = false
    print("[Carry] 🔄 Restart (ผ่าน replica)")
end

local function playRecord(data)
    print(("[Carry ▶] วางตาม record: %s - Act %s (%d ตัว)")
        :format(data.stage, data.act, #data.steps))
    for i, step in ipairs(data.steps) do
        if not carryOn then return end
        task.wait(math.clamp(step.dt or 1, 0.3, MAX_STEP_WAIT))
        local cf = CFrame.new(unpack(step.cf))
        local target = cf.Position
        local before = unitCountNear(target, 5)
        firePlace(step.slot, cf)
        task.wait(0.8)
        if unitCountNear(target, 5) > before then
            print(("[Carry ▶] ✅ #%d ช่อง %d"):format(i, step.slot))
        else
            -- วางไม่ติด (เงินไม่ทัน?) → ลองซ้ำสูงสุด 3 รอบ รอบละ 3 วิ
            local placed = false
            for r = 1, 3 do
                task.wait(3)
                if not carryOn then return end
                firePlace(step.slot, cf)
                task.wait(0.8)
                if unitCountNear(target, 5) > before then
                    print(("[Carry ▶] ✅ #%d ช่อง %d (รอบ %d)"):format(i, step.slot, r + 1))
                    placed = true
                    break
                end
            end
            if not placed then
                warn(("[Carry ▶] ⚠️ #%d ช่อง %d วางไม่ติด — ข้าม"):format(i, step.slot))
            end
        end
    end
    print("[Carry ▶] ✅ วางครบตาม record แล้ว")
end

-- ลูปรีเพล — ⭐ cooldown 10 วิ/ครั้ง กันสแปมยิงจนโดนเตะ
local lastRestartTry = 0
task.spawn(function()
    while true do
        task.wait(2)
        if carryOn and not recording then
            local btn = findRepeatBtn()
            if btn and tick() - lastRestartTry > 10 then
                lastRestartTry = tick()
                print("[Carry] 🔄 จบด่าน → กดรีเพล")
                fireRestart()
                task.wait(3)
                local b2 = findRepeatBtn()
                if b2 then
                    pcall(function()
                        for _, c in ipairs(getconnections(b2.MouseButton1Click)) do c:Fire() end
                        for _, c in ipairs(getconnections(b2.Activated)) do c:Fire() end
                    end)
                end
            end
        end
    end
end)

-- ลูปวาง
task.spawn(function()
    while true do
        task.wait(2)
        if carryOn and not recording then
            local info = getCurrentStageKey()
            if not info then
                playedThisMatch = false
            else
                local units = unitCount()
                if playedThisMatch and units == 0 and lastUnitsSeen > 0 then
                    print("[Carry] 🔄 ตัวในสนามหาย (ตาใหม่) → วางรอบใหม่")
                    playedThisMatch = false
                end
                lastUnitsSeen = units
                if not playedThisMatch and not findRepeatBtn() then
                    local data = loadRecord(info)
                    if data then
                        playedThisMatch = true
                        task.wait(2)
                        playRecord(data)
                    else
                        print(("[Carry] ⚠️ ยังไม่เคยอัดด่าน %s - Act %s")
                            :format(info.stage, info.act))
                        playedThisMatch = true
                    end
                end
            end
        end
    end
end)


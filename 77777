-- ⭐ resolve "ยูนิตที่เพิ่งวาง" ตอนเล่นซ้ำ = id ใหม่ที่โผล่ (ไม่อยู่ใน beforeIds/usedReplay)
local function resolveNewUnit(beforeIds, usedReplay, target, stopped)
    for _ = 1, 25 do   -- รอ replica ~5 วิ
        if stopped() then return nil end
        local news = {}
        for _, u in ipairs(getMyUnits()) do
            if not beforeIds[u.id] and not usedReplay[u.id] then news[#news + 1] = u end
        end
        if #news == 1 then
            return news[1]
        elseif #news > 1 then
            local best, bestD
            for _, u in ipairs(news) do
                if u.pos then
                    local dd = (u.pos - target).Magnitude
                    if not bestD or dd < bestD then best, bestD = u, dd end
                end
            end
            return best or news[1]
        end
        task.wait(0.2)
    end
    return nil
end

-- ⭐ นับรอบเล่น — กันงานเบื้องหลังของรอบเก่าทำผิดรอบ
local playSession = 0

-- ▶ เล่นตาม timeline: เล่น event ตามเวลาสัมพัทธ์จริง + map uid(ตอนอัด) → id(ตอนเล่น)
local function playRecord(data)
    playSession = playSession + 1
    local mySession = playSession
    local events = data.events or {}
    print(("[Carry ▶] เล่น timeline: %s - Act %s (%d events)"):format(data.stage, data.act, #events))
    local idMap = {}         -- uid(อัด) → id(เล่น)
    local usedReplay = {}    -- id(เล่น) ที่จองแล้ว
    local t0 = tick()
    local baseT = events[1] and events[1].t or 0
    local lastRepChk, repSeen = 0, false
    local function stopped()   -- หยุดถ้า: ปิด carry / รอบใหม่ / จบด่าน (ปุ่ม Repeat โผล่)
        if (not carryOn) or mySession ~= playSession then return true end
        local now = tick()
        if now - lastRepChk > 0.5 then lastRepChk = now; repSeen = findRepeatBtn() ~= nil end
        return repSeen
    end
    local function waitReplayId(uid)   -- รอ place ตัวนั้น resolve id เสร็จ (~7 วิ)
        for _ = 1, 140 do
            if stopped() then return nil end
            if idMap[uid] then return idMap[uid] end
            task.wait(0.05)
        end
        return idMap[uid]
    end

    for _, ev in ipairs(events) do
        if stopped() then return end
        -- ⭐ รอจนถึง "เวลาสัมพัทธ์" ของ event นี้ (เล่นตาม timeline จริง)
        local targetElapsed = (ev.t or 0) - baseT
        while (tick() - t0) < targetElapsed do
            if stopped() then return end
            task.wait(0.03)
        end
        if ev.k == "place" then
            local cf = CFrame.new(unpack(ev.cf))
            local target = cf.Position
            local beforeIds = {}
            for _, u in ipairs(getMyUnits()) do beforeIds[u.id] = true end
            firePlace(ev.slot, cf)
            local evUid = ev.uid
            -- resolve id เบื้องหลัง (ไม่บล็อก timeline) → เก็บลง idMap ให้ event config ตัวหลังใช้
            task.spawn(function()
                local newU
                for _ = 1, 3 do
                    newU = resolveNewUnit(beforeIds, usedReplay, target, stopped)
                    if newU then break end
                    if stopped() then return end
                    firePlace(ev.slot, cf)   -- วางไม่ติด → ลองซ้ำ
                end
                if newU then
                    usedReplay[newU.id] = true
                    if evUid then idMap[evUid] = newU.id end
                    print(("[Carry ▶] ✅ วาง ช่อง %s (id %s)"):format(tostring(ev.slot), newU.id))
                else
                    warn(("[Carry ▶] ⚠️ วาง ช่อง %s ไม่ติด/หายูนิตไม่เจอ"):format(tostring(ev.slot)))
                end
            end)
        else
            -- config event → หา id ตอนเล่นจาก uid(ตอนอัด)
            local rid = ev.uid and waitReplayId(ev.uid) or nil
            if not rid then
                warn(("[Carry ▶] ⚠️ ข้าม %s — ยังไม่รู้ยูนิต (uid %s)"):format(ev.k, tostring(ev.uid)))
            elseif ev.k == "prio" then
                replicaFire("ChangeGameUnitPriority", rid, ev.prio)
                print(("[Carry ▶] 🎚️ ปรับการโจมตี %s (id %s)"):format(tostring(ev.prio), rid))
            elseif ev.k == "up" then
                replicaFire("UpgradeGameUnit", rid)
                print(("[Carry ▶] ⬆️ อัพเกรดมือ (id %s)"):format(rid))
            elseif ev.k == "auto" then
                replicaFire("ChangeGameUnitAutoUpgradePriority", rid)
                print(("[Carry ▶] 🔁 ออโต้อัพเกรด (id %s)"):format(rid))
            end
        end
    end
    print("[Carry ▶] ✅ เล่นครบ timeline แล้ว")
end

-- ลูปรีเพล — ⭐ cooldown 10 วิ/ครั้ง กันสแปมยิงจนโดนเตะ
local lastRestartTry = 0
task.spawn(function()
    while true do
        task.wait(2)
        if carryOn and not recording then
            local btn = findRepeatBtn()
            if btn and tick() - lastRestartTry > 10 then
                lastRestartTry = tick()
                print("[Carry] 🔄 จบด่าน → กดรีเพล")
                fireRestart()
                task.wait(3)
                local b2 = findRepeatBtn()
                if b2 then
                    pcall(function()
                        for _, c in ipairs(getconnections(b2.MouseButton1Click)) do c:Fire() end
                        for _, c in ipairs(getconnections(b2.Activated)) do c:Fire() end
                    end)
                end
            end
        end
    end
end)

-- ลูปวาง
task.spawn(function()
    local sawEnd = false   -- ⭐ เคยเห็นปุ่ม Repeat (จบด่าน) ในรอบนี้แล้วหรือยัง
    while true do
        task.wait(2)
        if carryOn and not recording then
            local info = getCurrentStageKey()
            local repeatBtn = findRepeatBtn()
            if repeatBtn then sawEnd = true end   -- จบด่าน → รอรีเพล
            if not info then
                playedThisMatch = false
                sawEnd = false
            else
                local units = unitCount()
                -- ⭐ รอบใหม่: ปุ่ม Repeat "หายหลังเคยโผล่" = เกมรีเพลเข้ารอบใหม่แล้ว → ต้องวางใหม่
                --    (แก้บั๊ก: เดิมป้ายด่านไม่หาย + ตัวไม่เป็น 0 พอดี → flag ค้าง ไม่วางหลังรีเพล)
                if sawEnd and not repeatBtn then
                    sawEnd = false
                    if playedThisMatch then
                        print("[Carry] 🔄 รอบใหม่เริ่ม (Repeat หาย) → วางใหม่")
                        playedThisMatch = false
                    end
                end
                -- สำรอง: ตัวในสนามหาย (ตาใหม่)
                if playedThisMatch and units == 0 and lastUnitsSeen > 0 then
                    print("[Carry] 🔄 ตัวในสนามหาย (ตาใหม่) → วางรอบใหม่")
                    playedThisMatch = false
                end
                lastUnitsSeen = units
                if not playedThisMatch and not repeatBtn then
                    local data = loadRecord(info)
                    if data then
                        playedThisMatch = true
                        task.wait(2)
                        playRecord(data)
                    else
                        print(("[Carry] ⚠️ ยังไม่เคยอัดด่าน %s - Act %s")
                            :format(info.stage, info.act))
                        playedThisMatch = true
                    end
                end
            end
        end
    end
end)


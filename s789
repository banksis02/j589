local function eachBtn(fn)
    for _,g in ipairs(player.PlayerGui:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled then
            for _,b in ipairs(g:GetDescendants()) do
                if (b:IsA("TextButton") or b:IsA("ImageButton")) and vis(b) then if fn(b) then return true end end
            end
        end
    end
    return false
end
local function findBtn(needle, exact)
    needle=tostring(needle); local found
    eachBtn(function(b)
        local ts={}
        if b:IsA("TextButton") and b.Text~="" then ts[#ts+1]=b.Text end
        for _,l in ipairs(b:GetDescendants()) do if l:IsA("TextLabel") and l.Visible and l.Text~="" then ts[#ts+1]=l.Text end end
        for _,t in ipairs(ts) do if (exact and t==needle) or (not exact and t:find(needle,1,true)) then found=b; return true end end
    end)

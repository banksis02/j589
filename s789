-- ===== replica GameState → อ่าน Wave =====
local registry
pcall(function()
    local RC=require(RS.Shared.ReplicaClient)
    for _,up in pairs(debug.getupvalues(RC.FromId)) do
        if type(up)=="table" then for kk in pairs(up) do if type(kk)=="number" then registry=up; break end end; if registry then break end end
    end
end)
local function repByToken(tok) if registry then for _,r in pairs(registry) do local ok,t=pcall(function() return r.Token end); if ok and t==tok then return r end end end end
-- หา TextLabel เลข wave บน HUD (ตรงกับที่โชว์บนจอ) — ทนหลายพาธ
local function waveFromHUD()
    -- 1) พาธตรง (จากสคริปต์หลัก)
    local ok,w = pcall(function()
        local n = player.PlayerGui.GameUI.HUD.Upper.WaveInformations.Container.Wave
        return tostring(n.Text):match("%d+")
    end)
    if ok and w then return tonumber(w) end
    -- 2) หา label ที่พ่อ/ปู่ชื่อมีคำว่า Wave แล้วข้อความเป็นเลขล้วนๆ
    local best
    for _,g in ipairs(player.PlayerGui:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled and (g.Name=="GameUI" or g.Name=="HUD") then
            for _,l in ipairs(g:GetDescendants()) do
                if l:IsA("TextLabel") and l.Visible then
                    local num = tostring(l.Text):match("^%s*(%d+)%s*$")
                    if num then
                        local p=l.Parent
                        for _=1,4 do if p and tostring(p.Name):lower():find("wave") then best=tonumber(num); break end; p=p and p.Parent end
                    end
                end
            end
        end
    end
    return best
end
local function curWave()
    local hud = waveFromHUD()
    if hud and hud>0 then return hud end
    -- ⭐ v9.49: ใช้ตัวอ่านของสคริปต์หลัก (aeGetReplica re-capture registry — เชื่อถือได้ทุกแมพ)
    if _G.AE_GET_STATS then local ok,_,_,w = pcall(_G.AE_GET_STATS); if ok and tonumber(w) and tonumber(w)>0 then return tonumber(w) end end
    local gs=repByToken("GameState"); local d=gs and gs.Data
    return d and tonumber(d.Wave) or 0
end
local function inStage()
    -- มีเลข wave บน HUD = อยู่ในด่าน
    if waveFromHUD() then return true end
    local gs=repByToken("GameState"); local d=gs and gs.Data
    if type(d)=="table" and (d.Active==true or tostring(d.CurrentGameState)=="InProgress" or (type(d.Parameters)=="table" and d.Parameters.MapName)) then return true end
    return false
end

-- ===== คลิกทน + หา/เลื่อน (จากตัวเทส enter ที่ผ่านแล้ว) =====
local function fireConns(b)
    local n=0
    pcall(function() for _,c in ipairs(getconnections(b.MouseButton1Click)) do c:Fire(); n=n+1 end end)
    if n==0 then pcall(function() for _,c in ipairs(getconnections(b.Activated)) do c:Fire(); n=n+1 end end) end
    return n
end
local function vimClick(b) pcall(function()
    local inset=GuiService:GetGuiInset(); local cx=b.AbsolutePosition.X+b.AbsoluteSize.X/2; local cy=b.AbsolutePosition.Y+b.AbsoluteSize.Y/2+inset.Y
    VIM:SendMouseButtonEvent(cx,cy,0,true,game,0); task.wait(0.06); VIM:SendMouseButtonEvent(cx,cy,0,false,game,0) end) end
local function clickBtn(b) if fireConns(b)==0 then vimClick(b) end end
local function vis(b) return b.Visible and b.AbsoluteSize.X>3 and b.AbsoluteSize.Y>3 end
local function findBtn(needle, exact) needle=tostring(needle)
    for _,g in ipairs(player.PlayerGui:GetChildren()) do if g:IsA("ScreenGui") and g.Enabled then
        for _,b in ipairs(g:GetDescendants()) do if (b:IsA("TextButton") or b:IsA("ImageButton")) and vis(b) then
            local ts={}; if b:IsA("TextButton") and b.Text~="" then ts[#ts+1]=b.Text end
            for _,l in ipairs(b:GetDescendants()) do if l:IsA("TextLabel") and l.Visible and l.Text~="" then ts[#ts+1]=l.Text end end
            for _,t in ipairs(ts) do if (exact and t==needle) or (not exact and t:find(needle,1,true)) then return b end end
        end end
    end end return nil end
local function clickText(needle, exact, timeout) local t0=tick()
    repeat local b=findBtn(needle,exact); if b then clickBtn(b); L("  ✅ กด '"..needle.."'"); return true end; task.wait(0.5)
    until tick()-t0>(timeout or 6); L("  ❌ ไม่เจอ '"..needle.."'"); return false end
local function tryClickLabel(mapName)
    for _,g in ipairs(player.PlayerGui:GetChildren()) do if g:IsA("ScreenGui") and g.Enabled then
        for _,l in ipairs(g:GetDescendants()) do if l:IsA("TextLabel") and l.Visible and l.Text==mapName then
            local p=l.Parent; while p and p~=g do if p:IsA("TextButton") or p:IsA("ImageButton") then clickBtn(p); L("  ✅ กดแมพ '"..mapName.."'"); return true end; p=p.Parent end
        end end
    end end return false end
local function clickStage(mapName)
    if tryClickLabel(mapName) then return true end
    local sfs={}; for _,g in ipairs(player.PlayerGui:GetDescendants()) do if g:IsA("ScrollingFrame") and g.Visible and g.AbsoluteSize.X>250 then sfs[#sfs+1]=g end end
    for _,sf in ipairs(sfs) do local maxX=math.max(sf.AbsoluteCanvasSize.X, sf.CanvasSize.X.Offset)
        for step=0,14 do pcall(function() sf.CanvasPosition=Vector2.new(step*220,sf.CanvasPosition.Y) end); task.wait(0.22)
            if tryClickLabel(mapName) then return true end; if step*220>maxX+300 then break end end
        pcall(function() sf.CanvasPosition=Vector2.new(0,sf.CanvasPosition.Y) end) end
    for _=1,6 do local nx=findBtn(">",true) or findBtn("Next",false); if not nx then break end; clickBtn(nx); task.wait(0.4); if tryClickLabel(mapName) then return true end end
    L("  ❌ ไม่เจอแมพ '"..mapName.."'"); return false end
-- วนหาปุ่มทุกอันใน PlayerGui (callback คืน true = หยุด)
local function eachBtn(fn)
    for _,g in ipairs(player.PlayerGui:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled then
            for _,b in ipairs(g:GetDescendants()) do
                if (b:IsA("TextButton") or b:IsA("ImageButton")) and vis(b) then
                    if fn(b) then return true end
                end
            end
        end
    end
    return false
end
local function hasLabel(b, txt)
    if b:IsA("TextButton") and b.Text==txt then return true end
    for _,l in ipairs(b:GetDescendants()) do
        if l:IsA("TextLabel") and l.Visible and l.Text==txt then return true end
    end
    return false
end
local function clickInfinite()
    -- หา M
    local mBtn
    eachBtn(function(b) if b.AbsoluteSize.X<=80 and hasLabel(b,"M") then mBtn=b; return true end end)
    if not mBtn then L("  ❌ ไม่เจอ M"); return false end
    local mx,my = mBtn.AbsolutePosition.X, mBtn.AbsolutePosition.Y
    -- ปุ่มเหนือ M ในคอลัมน์เดียวกัน ใกล้สุด = Infinite
    local best,bestY
    eachBtn(function(b)
        if b~=mBtn and b.AbsoluteSize.X<=90 then
            local bx,by = b.AbsolutePosition.X, b.AbsolutePosition.Y
            if math.abs(bx-mx)<45 and by<my-3 and (not bestY or by>bestY) then best,bestY=b,by end
        end
    end)
    if not best then L("  ❌ ไม่เจอปุ่ม Infinite"); return false end
    clickBtn(best); L("  ✅ กด Infinite"); return true
end

local function enterInfinite(mapName)
    L("⚔️ เข้า Infinite: "..mapName)
    clickText("Play",true,5); task.wait(1.5)
    clickText("Story",true,5); task.wait(1.5)
    if not clickStage(mapName) then return false end; task.wait(1.5)
    if not clickInfinite() then return false end; task.wait(1.2)
    clickText("Hard",false,6); task.wait(1)
    if not clickText("Select Stage",false,8) then return false end; task.wait(3)
    if not clickText("Start",false,12) then clickText("Select Stage",false,5); task.wait(2); if not clickText("Start",false,10) then return false end end
    return true
end

-- ===== RUN เต็ม =====
local running=false
_G.AE_INF_STOP=function() running=false; L("⏹ หยุด Infinite") end
_G.AE_INF_RUN=function(mapName, targetWave)
    mapName=mapName or "School Grounds"; targetWave=tonumber(targetWave) or 15
    if running then L("กำลังทำงานอยู่"); return end
    running=true
    -- ตัวเช็ค "อยู่ในด่าน" — ใช้ของสคริปต์หลักก่อน (แม่นสุด) แล้ว fallback ตัวเอง
    local function inGame()
        if inStage() then return true end   -- HUD wave = อยู่ในด่าน (แม่นสุดสำหรับ Infinite)
        if _G.AE_IN_GAME then local ok,r=pcall(_G.AE_IN_GAME); if ok and r then return true end end
        return false
    end
    task.spawn(function()
        -- ตั้งค่า (auto-skip/vote/upgrade เปิด) ครั้งเดียว
        if _G.AE_APPLY_SETTINGS then L("⚙️ ตั้งค่า auto-skip/vote/upgrade"); pcall(_G.AE_APPLY_SETTINGS); task.wait(1) end
        -- เข้าด่าน (best-effort — ไม่หยุดถ้า enter คืน false เพราะบางทีเข้าได้แต่ log ไม่ครบ)
        if not inGame() then enterInfinite(mapName) end
        -- รอเข้าด่านจริง (poll _G.AE_IN_GAME) — log ทุก 3 วิ
        local t0=tick()
        while running and not inGame() and tick()-t0<90 do
            L(("  ⏳ รอเข้าด่าน... %ds"):format(math.floor(tick()-t0))); task.wait(3)
        end
        if not inGame() then L("⚠️ ไม่เข้าด่านใน 90 วิ"); notify("⚔️ Infinite","ไม่เข้าด่าน",6); running=false; return end
        L("✅ อยู่ในด่านแล้ว → วางตัว (_G.AE_PLACE)")
        -- ⭐ v9.48: โหมดเควสวางแบบ Villain (วางทุกตัวที่ใส่ ทุกโหลดเอาต์) — fallback AE_PLACE
        if _G.AE_VILLAIN_PLACE then pcall(_G.AE_VILLAIN_PLACE) elseif _G.AE_PLACE then pcall(_G.AE_PLACE) end
        task.wait(3)
        -- เฝ้า wave
        L(("👀 เฝ้า wave → เป้า %d (%s)"):format(targetWave, mapName))
        local tick2=0
        while running and MYGEN==_G.AE_SCRIPT_GEN do
            if not inGame() then L("⚠️ ออกจากด่านแล้ว (แพ้?) → จบ"); notify("⚔️ Infinite","ออกจากด่าน (แพ้?)",6); break end
            local w=curWave()
            L(("  wave %d/%d"):format(w,targetWave))
            if w>=targetWave then
                L(("🏁 ถึง wave %d → ออกกลับล็อบบี้"):format(w))
                if _G.AE_BACK_TO_LOBBY then pcall(_G.AE_BACK_TO_LOBBY) end
                notify("⚔️ Infinite","✅ สำเร็จ! wave "..w.." "..mapName,6)
                break
            end
            -- วางซ้ำทุก ~12 วิ (กันตัวตาย/วางไม่ครบตอนแรก)
            tick2=tick2+1
            if tick2%4==0 then L("  🔁 วางซ้ำ"); if _G.AE_VILLAIN_PLACE then pcall(_G.AE_VILLAIN_PLACE) elseif _G.AE_PLACE then pcall(_G.AE_PLACE) end end
            task.wait(3)
        end
        running=false
    end)
end


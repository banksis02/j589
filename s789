                btn.BackgroundColor3=Color3.fromRGB(180,40,40); stroke.Color=Color3.fromRGB(255,80,80)
                saveFile(saveName,true)
                lp=task.spawn(function()
                    while isOn do
                        pcall(runFn)
                        task.wait(intervalSec)
                    end
                end)
            end
            local function stop()
                isOn=false; if lp then pcall(task.cancel, lp); lp=nil end
                btn.Text="▶ "..label
                btn.BackgroundColor3=Color3.fromRGB(30,30,50); stroke.Color=Color3.fromRGB(80,80,100)
                saveFile(saveName,false)
            end
            btn.MouseButton1Click:Connect(function() if not isOn then start() else stop() end end)
            return function() if loadFile(saveName) then print("[UI] Auto:", label); start() end end
        end


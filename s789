-- 📖 TOME — ใส่ให้ยูตะอัตโนมัติ
--   ลำดับจริง (จาก spy):  HotbarData:FireServer("SelectSlot", ช่องTome)
--                         <replica ที่เพิ่งเกิด>:FireServer("Response", "<GameUnit ID>")
--   replica ตัวตอบเป็นตัวชั่วคราว (id เปลี่ยนทุกครั้ง) → หาโดยเทียบ registry ก่อน/หลัง
-- ============================================================
local function findTomeSlot()
    for slot, i in pairs(scanSlots()) do
        if i.atype ~= "Unit" and tostring(i.asset):lower():find("tome", 1, true) then
            return slot, i.asset
        end
    end
    for slot, i in pairs(scanSlots()) do
        if tostring(i.atype):lower():find("tome", 1, true) then return slot, i.asset end
    end
    return nil
end

-- GameUnit ID ของตัวที่จะใส่ Tome (ข้ามโคลนซัมมอน)
local function findUnitIdFor(assets)
    local me = player.Name
    local best, bestScore
    for _, e in ipairs(eachReplica("GameUnit")) do
        local d = e.data
        if d and (tostring(d.Owner) == me) then
            local isClone = d.IsClone or d.Unupgradeable or d.HiddenUnitManager
            local asset = d.UnitData and tostring(d.UnitData.Asset) or ""
            if not isClone and asset ~= "" then
                local a = asset:lower()
                for _, want in ipairs(assets) do
                    local w = want:lower()
                    local score
                    if a == w then score = 10000
                    elseif a:sub(1, #w) == w then score = 5000 - #a
                    elseif a:find(w, 1, true) then score = 1000 - #a end
                    if score and (not bestScore or score > bestScore) then
                        best, bestScore = d.ID, score
                    end
                end
            end
        end
    end
    return best
end

local function registrySnapshot()
    local ids = {}
    if registry then for id in pairs(registry) do ids[id] = true end end
    return ids
end

_G.AE_TOME_USE = function(assets)
    assets = assets or TOME_TARGET
    local slot, tomeName = findTomeSlot()
    if not slot then return false end
    local unitId = findUnitIdFor(assets)
    if not unitId then
        print("[Tome] ⚠️ ยังไม่เจอตัวเป้าหมายในสนาม (" .. table.concat(assets, "/") .. ") — ยังไม่ใช้ Tome")
        return false
    end

    print(("[Tome] 📖 ใช้ %s (ช่อง %d) ใส่ให้ %s (ID %s)")
        :format(tostring(tomeName), slot, table.concat(assets, "/"), tostring(unitId)))

    local before = registrySnapshot()
    selectSlot(slot)
    task.wait(0.9)

    -- replica ที่เพิ่งเกิด = ตัวรับคำตอบ
    local fired = false
    if registry then
        for id, rep in pairs(registry) do
            if not before[id] then
                local ok = pcall(function() rep:FireServer("Response", tostring(unitId)) end)
                if ok then
                    local tk = select(2, pcall(function() return rep.Token end))
                    print(("[Tome]    📤 ตอบผ่าน replica id=%s Token=%s"):format(tostring(id), tostring(tk)))
                    fired = true
                end
            end
        end
    end
    -- สำรอง: ยิงใส่ replica ที่ token เกี่ยวกับ prompt/selection
    if not fired and registry then
        for _, rep in pairs(registry) do
            local ok, tk = pcall(function() return rep.Token end)
            if ok and tk then
                local t = tostring(tk):lower()
                if t:find("prompt") or t:find("select") or t:find("response") or t:find("request") then
                    pcall(function() rep:FireServer("Response", tostring(unitId)) end)
                    fired = true
                end
            end
        end
    end

    task.wait(1)
    if not findTomeSlot() then
        print("[Tome] ✅ ใส่ Tome สำเร็จ (ช่องหายแล้ว)")
        return true
    end
    print("[Tome] ⚠️ ยังมี Tome ค้างอยู่ — ปิดกล่องไว้ก่อน")
    closeTomePrompt()
    return false
end

-- ============================================================
-- 📖 TOME SPY — ดักวิธีใช้ (เผื่อเกมเปลี่ยนวิธี)
--    _G.AE_TOME_SPY()  → เริ่มดัก แล้วเปิด Tome ใส่ให้ยูตะด้วยมือ
--    _G.AE_TOME_STOP() → หยุด + คัดลอก log
-- ============================================================
local tomeQ, tomeOn, tomeLog = {}, false, {}
_G.AE_TOME_SPY = function()
    if tomeOn then print("[Tome] ดักอยู่แล้ว"); return end
    tomeOn = true
    table.clear(tomeQ); table.clear(tomeLog)
    local ev = RS:WaitForChild("RemoteEvents"):WaitForChild("ReplicaSignal")
    local old
    old = hookmetamethod(game, "__namecall", function(self, ...)
        if tomeOn and self == ev and getnamecallmethod() == "FireServer" then
            table.insert(tomeQ, { t = tick(), args = table.pack(...) })   -- เก็บคิวอย่างเดียว (กัน kick 267)
        end
        return old(self, ...)
    end)
    print("[Tome] 🔍 เริ่มดักแล้ว — ตอนนี้ทำมือ: กดใช้ Tome → เลือกยูตะ")
    print("[Tome]    เสร็จแล้วพิมพ์ _G.AE_TOME_STOP()")
    task.spawn(function()
        local t0 = tick()
        while tomeOn do
            while #tomeQ > 0 do
                local e = table.remove(tomeQ, 1)
                local parts = {}
                for i = 1, e.args.n do
                    local v = e.args[i]
                    parts[i] = (type(v) == "string") and ('"' .. v .. '"') or tostring(v)
                end
                local line = ("[TOME %5.1fs] %s"):format(e.t - t0, table.concat(parts, ", "))
                print(line); table.insert(tomeLog, line)
            end
            task.wait(0.2)
        end
    end)
end
_G.AE_TOME_STOP = function()
    tomeOn = false
    -- ช่อง Tome ที่มีตอนนี้ + ตัวที่วางอยู่ (เอาไว้แมพ id ใน log)
    table.insert(tomeLog, "--- ช่องตอนนี้ ---")
    for slot, i in pairs(scanSlots()) do
        table.insert(tomeLog, ("  ช่อง %d = %s [%s]"):format(slot, i.asset, i.atype))
    end
    table.insert(tomeLog, "--- GameUnit ที่วางอยู่ ---")
    for _, e in ipairs(eachReplica("GameUnit")) do
        local d = e.data
        if d then
            table.insert(tomeLog, ("  id=%s ID=%s Owner=%s Asset=%s")
                :format(tostring(e.id), tostring(d.ID), tostring(d.Owner),
                        tostring(d.UnitData and d.UnitData.Asset)))
        end
    end
    local s = table.concat(tomeLog, "\n")
    print(s); pcall(function() setclipboard(s) end)
    print("[Tome] 📋 คัดลอกแล้ว — ส่งมาให้ดู")
end


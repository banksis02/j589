pcall(function() ReplicaSignal = RS.RemoteEvents.ReplicaSignal end)

local function pdata()
    if not registry then return nil end
    for _,r in pairs(registry) do local ok,t=pcall(function() return r.Token end); if ok and t=="PlayerData" then return r.Data end end
end
local function gold()
    local d=pdata(); local g=d and d.ItemData and d.ItemData.Gold
    if type(g)=="table" then return tonumber(g.Amount) or 0 end
    return tonumber(g) or 0
end

-- หา replica ร้านทอง → คืน id + ตาราง Items
local function findShop()
    if not registry then return nil end
    for id,rep in pairs(registry) do
        local ok,t=pcall(function() return rep.Token end)
        if ok and t=="ShopData" then
            local okd,d=pcall(function() return rep.Data end)
            if okd and type(d)=="table" and d.DataKey==SHOP_DATAKEY then
                local shop = d.Shops and d.Shops[SHOP_KEY]
                if shop and type(shop.Items)=="table" then return id, shop.Items end
            end
        end
    end
    return nil
end

-- จำนวนที่ซื้อไปแล้ว restock นี้ (PurchaseHistory.GoldShop.GoldShop1[Name])
local function boughtCount(name)
    local d=pdata()
    local ph = d and d.ShopData and d.ShopData.PurchaseHistory
    ph = ph and ph[SHOP_DATAKEY] and ph[SHOP_DATAKEY][SHOP_KEY]
    return (ph and tonumber(ph[name])) or 0
end

local function buy(shopId, index, qty)
    if not ReplicaSignal then L("❌ ไม่เจอ ReplicaSignal"); return false end
    local ok,err = pcall(function() ReplicaSignal:FireServer(shopId, "PurchaseItem", SHOP_KEY, index, qty) end)
    if not ok then L("❌ buy error: "..tostring(err)) end
    return ok
end

function _G.AE_SHOP_BUY()
    local shopId, items = findShop()
    if not shopId then L("❌ ไม่เจอร้าน Gold Shop"); return false end
    L(("🛒 Gold Shop (id %s) | Gold %d | reserve %d"):format(tostring(shopId), gold(), RESERVE))

    -- เรียง index (1..N)
    local idxs = {}
    for k in pairs(items) do idxs[#idxs+1]=k end
    table.sort(idxs, function(a,b) return tonumber(a) < tonumber(b) end)

    local boughtAny, spent = 0, 0
    for _, idx in ipairs(idxs) do
        local it = items[idx]
        local name, price = it.Name, tonumber(it.Price) or 0
        local stock = tonumber(it.Stock)            -- nil = ไม่จำกัด (แต่ร้านทองมี Stock ทุกตัว)
        -- ⭐ v9.47 (user): ซื้อ "แค่ Trait Crystal" เท่านั้น (25/วัน = stock) ข้ามที่เหลือ
        if not tostring(name):lower():find("trait") then
            -- ข้ามไอเท็มอื่น
        elseif stock then
            local remain = stock - boughtCount(name)
            if remain > 0 and price >= 0 then
                -- ซื้อได้กี่ชิ้นโดยยังเหลือ > RESERVE
                local affordable = price > 0 and math.floor((gold() - RESERVE) / price) or remain
                local qty = math.min(remain, math.max(0, affordable))
                if qty > 0 then
                    if buy(shopId, idx, qty) then
                        boughtAny = boughtAny + 1; spent = spent + qty*price
                        L(("  ✅ #%s %s x%d (-%d)"):format(tostring(idx), tostring(name), qty, qty*price))
                        task.wait(0.35)
                    end
                elseif remain > 0 then
                    L(("  💰 ข้าม %s (gold ไม่พอ/ติด reserve)"):format(tostring(name)))
                end
            end
        end
    end
    L(("🛒 เสร็จ — ซื้อ %d รายการ ใช้ %d gold (เหลือ %d)"):format(boughtAny, spent, gold()))
    notify("🛒 Gold Shop", ("ซื้อ %d รายการ (-%d) เหลือ %d"):format(boughtAny, spent, gold()), 6)
    return true
end

-- ⭐ v9.53: Trait Crystal เหลือให้ซื้ออีกกี่ชิ้นวันนี้ (25/วัน - ที่ซื้อไปแล้ว) | -1 = อ่านไม่ได้ (ไม่อยู่ล็อบบี้)
_G.AE_SHOP_TRAIT_REMAIN = function()
    local _, items = findShop()
    if not items then return -1 end
    for _, it in pairs(items) do
        if tostring(it.Name):lower():find("trait") then
            local stock = tonumber(it.Stock) or 0
            return math.max(0, stock - boughtCount(it.Name))
        end
    end
    return 0
end


    -- ============================================================
    local DECO_KEYWORDS = {
        "tree","grass","bush","plant","flower","leaf","leaves",
        "rock","stone","decoration","decor","vegetation",
        "cloud","fog","sky","sun","moon"
    }
    local ENEMY_FOLDERS = {
        "Enemies","Mobs","Zombies","EnemyFolder","Enemy",
        "EnemiesFolder","MobFolder","ActiveEnemies",
        "Units","UnitFolder",  -- บาง UTDX เก็บใน Units

        -- ========== แก้มัด (ปุ่ม 10) — ปล่อย ProximityPrompt "Free Unit" / "ยูนิตฟรี" ==========
        local function isFreeUnitPrompt(obj)
            local at = obj.ActionText or ""
            local ot = obj.ObjectText or ""
            -- รองรับทุกภาษา + ตรวจ ObjectText ด้วย (เผื่อภาษาอื่น)
            if at == "Free Unit" or at == "ยูนิตฟรี" then return true end
            if at:lower():find("free") and at:lower():find("unit") then return true end
            if at:find("ยูนิตฟรี") or at:find("ฟรียูนิต") or at:find("ปลด") or at:find("แก้") then return true end
            -- ObjectText บอกว่าโดน effect (Mochi แข็งตัว, Frozen, ฯลฯ)
            if ot:find("แข็งตัว") or ot:lower():find("frozen") or ot:lower():find("trap") or ot:lower():find("bind") then return true end
            return false
        end


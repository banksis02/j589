                            if tick() - lastSentEndScreenTime > 20 then
                                local rewardsList = (#s.rewards > 0) and table.concat(s.rewards, ", ") or "N/A"
                                print("[AE Farm] 📤 " .. s.result .. " | " .. s.stage .. " | Rewards: " .. rewardsList)
                                sendAEDataToWeb(s)
                                lastSentEndScreenTime = tick()
                            else
                                print("[AE Farm] ⏭️ Skip send (watcher ส่งไปแล้ว)")
                            end

                            -- ⭐ v9.18: โหมด M นับเอง — 1 เกม = 5x (ไม่เปิดกระเป๋าในด่าน มันช้า/ต้องเลื่อน)
                            if farmMode == "actM" then
                                greyKnown = greyKnown + 5
                                print(("[AE Farm] 💿 Grey นับสะสม: %d/%d (+5/เกม)"):format(greyKnown, CRAFT_GREY_FULL))
                            end
                        elseif farmMode == "actM" then
                            greyKnown = greyKnown + 5   -- อ่าน endScreen ไม่ได้ก็บวก 5 (จบเกม = ได้ 5)
                            print(("[AE Farm] 💿 Grey นับสะสม: %d/%d"):format(greyKnown, CRAFT_GREY_FULL))
                        end
                        task.wait(0.5)

                        -- ⭐ v9.17: โหมด M กลับ Lobby "เฉพาะตอน Grey เต็ม 125 จริง" (อ่านจากกระเป๋า)
                        --    ไม่ใช้เงื่อนไข not greyKnownSynced อีก (มันบังคับกลับทุกรอบ = บัค)
                        if farmMode == "actM" and greyKnown >= CRAFT_GREY_FULL then
                            print("[AE Farm] 💿 Grey เต็มแล้ว (" .. greyKnown .. "/" .. CRAFT_GREY_FULL .. ") → กลับ Lobby ไปคราฟ")
                            backToLobby()
                            task.wait(8)  -- รอโหลดกลับ lobby (loop รอบหน้าจะคราฟ + เข้าด่านเอง)
                        else
                            fireRestart()

                            -- รอ Victory UI ปิด + กดปุ่ม Repeat ซ้ำเรื่อยๆ จนกว่าจะติด
                            -- ⭐ v9.14: กดซ้ำทุก 3 วิ (เดิมกดครั้งเดียว — ถ้ากระเป๋าบังจะไม่รีเพลเลย)
                            local waitClose = tick()
                            local lastClick = 0
                            while tick() - waitClose < 25 do
                                local prompt = player.PlayerGui:FindFirstChild("Prompt")
                                local rh = player.PlayerGui:FindFirstChild("RightGameHUD")
                                local promptClosed = not prompt or not prompt.Enabled
                                local gameReady = rh and rh.Enabled
                                if promptClosed and gameReady then break end
                                -- หลัง 4 วิ → กดปุ่ม Repeat ซ้ำทุก 3 วิ (ปิดกระเป๋าให้เองในฟังก์ชัน)
                                if tick() - waitClose > 4 and tick() - lastClick > 3 then
                                    lastClick = tick()
                                    if clickRepeatStageButton() then
                                        print("[AE Farm] 🖱️ กด Repeat Stage (ลองจนติด)")
                                    end
                                end
                                task.wait(0.3)
                            end
                            task.wait(1)
                        end
                    end
                end
            end
            print("[AE Farm] ⏹ หยุดฟาร์ม")
        end)
    end


                            { names={"Auto Skip Waves","ข้ามคลื่นอัตโนมัติ"}, want=true,  tab="Gameplay", tabTH="การเล่นเกม" },
                            { names={"Auto Vote Start","เริ่มโหวตอัตโนมัติ"}, want=true,  tab="Gameplay", tabTH="การเล่นเกม" },
                            { names={"Show Match End Rewards","แสดงผลรางวัลการจบการแข่งขัน"}, want=false, tab="Gameplay", tabTH="การเล่นเกม" },

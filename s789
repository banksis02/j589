--      4) จบด่าน/ออกจากด่าน → หยุดระบบในด่าน → กลับไปข้อ 2
--    เรียกจากสคริปต์หลัก/เว็บ:  _G.AE_EXP_RUN()  /  _G.AE_EXP_RUN_STOP()
-- ============================================================
local MYGEN = _G.AE_SCRIPT_GEN   -- รุ่นสคริปต์ (โหลดใหม่ = ลูปเก่าตาย)
local RUN_player = game:GetService("Players").LocalPlayer

local function fireBtn(btn)
    local fired = 0
    pcall(function()
        for _, c in ipairs(getconnections(btn.MouseButton1Click)) do c:Fire(); fired = fired + 1 end
    end)
    if fired == 0 then
        pcall(function()
            for _, c in ipairs(getconnections(btn.Activated)) do c:Fire(); fired = fired + 1 end
        end)
    end
    return fired
end

local function settingsOpen()
    local s = player.PlayerGui:FindFirstChild("Settings")
    return s and s:FindFirstChild("Frame") ~= nil and #s.Frame:GetChildren() > 1
end

-- เปิด Settings — กด TopBar ปุ่มขวาสุด (เกียร์) แบบสคริปต์หลัก
local cachedSettingsBtn = nil
-- ⭐ กัน "ปุ่ม Exit" ที่เกมเพิ่มมาข้างเฟือง
local exitBlack = {}
local function looksLikeExit(btn)
    local n = tostring(btn.Name):lower()
    if n:find("exit") or n:find("leave") or n:find("door") or n:find("quit") then return true end
    for _, d in ipairs(btn:GetDescendants()) do
        if d:IsA("TextLabel") and d.Visible then
            local t = tostring(d.Text):lower()
            if t == "exit" or t == "leave" then return true end
        end
    end
    return false
end
local function dismissExit()
    if _G.AE_DISMISS_EXIT then return _G.AE_DISMISS_EXIT() end
    for _, g in ipairs(player.PlayerGui:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled then
            for _, l in ipairs(g:GetDescendants()) do
                if l:IsA("TextLabel") and l.Visible and tostring(l.Text):find("exit this game",1,true) then
                    for _, b in ipairs(g:GetDescendants()) do
                        if b:IsA("TextButton") then
                            local hit = b.Text=="Cancel"
                            if not hit then for _,x in ipairs(b:GetDescendants()) do if x:IsA("TextLabel") and x.Text=="Cancel" then hit=true break end end end
                            if hit then fireBtn(b); task.wait(0.4); return true end
                        end
                    end
                end
            end
        end
    end
    return false
end

local function openSettings()
    if settingsOpen() then return true end
    if cachedSettingsBtn and cachedSettingsBtn.Parent then
        fireBtn(cachedSettingsBtn); task.wait(1.5)
        if settingsOpen() then return true end
        dismissExit()
    end
    local topbar = player.PlayerGui:FindFirstChild("TopBar")
    if not topbar then return false end
    local btns = {}
    for _, btn in ipairs(topbar:GetDescendants()) do
        if btn:IsA("TextButton") and btn.Visible and not exitBlack[btn] and not looksLikeExit(btn) then
            table.insert(btns, btn)
        end
    end
    table.sort(btns, function(a, b) return a.AbsolutePosition.X > b.AbsolutePosition.X end)
    for _, btn in ipairs(btns) do
        fireBtn(btn); task.wait(1.2)
        if dismissExit() then exitBlack[btn] = true; task.wait(0.4)   -- ปุ่ม Exit → บัญชีดำ
        elseif settingsOpen() then cachedSettingsBtn = btn; return true
        else fireBtn(btn); task.wait(0.5) end   -- กดผิด → ปิด
    end
    return settingsOpen()
end


-- 🎫 เช็ค Battlepass ของ event Villain Invasion (คนละอันกับ BP หลัก)
-- ============================================================
_G.AE_VILLAIN_BPDUMP = function()
    local out = { "===== BATTLEPASS / EVENT DUMP =====" }
    local function ser(v, depth, seen)
        depth = depth or 0; seen = seen or {}
        if type(v) ~= "table" then return tostring(v) end
        if depth > 4 or seen[v] then return "{...}" end
        seen[v] = true
        local parts = {}
        for k, vv in pairs(v) do
            parts[#parts+1] = ("%s%s = %s"):format(("  "):rep(depth+1), tostring(k), ser(vv, depth+1, seen))
        end
        if #parts == 0 then return "{}" end
        return "{\n" .. table.concat(parts, "\n") .. "\n" .. ("  "):rep(depth) .. "}"
    end

    -- 1) PlayerData: BattlepassData + EventData + อะไรที่มีคำว่า battlepass/villain/event
    local pd
    for _, rep in pairs(registry or {}) do
        local ok, t = pcall(function() return rep.Token end)
        if ok and t == "PlayerData" then pd = rep; break end
    end
    if pd and pd.Data then
        out[#out+1] = "\n--- PlayerData.BattlepassData ---"
        out[#out+1] = ser(pd.Data.BattlepassData, 1)
        out[#out+1] = "\n--- PlayerData.EventData ---"
        out[#out+1] = ser(pd.Data.EventData, 1)
        -- คีย์ระดับบนที่มีคำเกี่ยวข้อง
        out[#out+1] = "\n--- คีย์ PlayerData ที่เกี่ยวกับ event/villain/pass ---"
        for k, v in pairs(pd.Data) do
            local kl = tostring(k):lower()
            if kl:find("event") or kl:find("villain") or kl:find("pass") or kl:find("crow") or kl:find("season") then
                out[#out+1] = ("  %s = %s"):format(k, ser(v, 2))
            end
        end
    else
        out[#out+1] = "❌ ไม่เจอ PlayerData"
    end

    -- 2) replica อื่นที่ Token มีคำว่า battlepass/event/villain
    out[#out+1] = "\n--- replica Token ที่เกี่ยวข้อง ---"
    for id, rep in pairs(registry or {}) do
        local ok, t = pcall(function() return rep.Token end)
        if ok and t then
            local tl = tostring(t):lower()
            if tl:find("pass") or tl:find("event") or tl:find("villain") or tl:find("crow") then
                local okd, d = pcall(function() return rep.Data end)
                out[#out+1] = ("\n  id=%s Token=%s"):format(tostring(id), tostring(t))
                out[#out+1] = "    " .. (okd and ser(d, 2) or "?")
            end
        end
    end

    local s = table.concat(out, "\n")
    print(s); pcall(function() setclipboard(s) end)
    print("[Villain] 📋 คัดลอกแล้ว — ส่งมาให้ดู")
end



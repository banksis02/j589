    local function backToLobby()
        print("[AE] 🏠 กลับ Lobby (กดปุ่มประตูข้างเฟือง)...")
        for attempt = 1, 4 do
            if inLobby() then print("[AE] ✅ ถึง Lobby แล้ว"); return true end
            -- 1) กดปุ่มประตู Exit → เด้งกล่อง Exit Confirmation
            local door = findExitDoorBtn()
            if door then
                fireButtonConns(door)
                pcall(function()
                    local inset = game:GetService("GuiService"):GetGuiInset()
                    local cx = door.AbsolutePosition.X + door.AbsoluteSize.X/2
                    local cy = door.AbsolutePosition.Y + door.AbsoluteSize.Y/2 + inset.Y
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
                    task.wait(0.05)
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
                end)
                task.wait(1)
            end
            -- 2) กดยืนยัน Return to Lobby (รอกล่องเด้ง + วาป)
            local t0 = tick()
            while tick() - t0 < 12 do
                if inLobby() then print("[AE] ✅ ถึง Lobby แล้ว"); return true end
                confirmReturnToLobby()
                task.wait(0.8)
            end
            warn("[AE] ⚠️ ยังไม่วาป → ลองใหม่ (รอบ " .. attempt .. ")")
        end
        warn("[AE] ❌ กลับ Lobby ไม่สำเร็จหลังลอง 4 รอบ")
        return false
    end

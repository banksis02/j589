--   buy remote: RS.RemoteEvents.ReplicaSignal:FireServer(<shopId>,"PurchaseItem","GoldShop1",<index>,<qty>)
--   ฟังก์ชัน: _G.AE_SHOP_BUY()   (คืน true ถ้าซื้อครบ/ไม่มีอะไรให้ซื้อ)
-- ============================================================
local okAll, fatal = pcall(function()
local Players=game:GetService("Players"); local RS=game:GetService("ReplicatedStorage")

                        -- ⭐ ข้ามตัวซัพ/ตัวหาเงิน (DPS 0) — อัพไปก็ไม่เพิ่มดาเมจ เปลืองเงิน
                        if not isSupportUnit(u.asset)
                           and u.upgrade < u.maxUp and (u.cost or 0) > 0 and yen >= u.cost then
                            if not pick or u.upgrade < pick.upgrade then pick = u end
                        end
                    end
                    if pick then
                        local before = pick.upgrade
                        pcall(function() rep:FireServer("UpgradeGameUnit", tostring(pick.id)) end)
                        task.wait(1)
                        print(("[Exp] 🎲⬆️ อัพ %s: %d → ? (จ่าย ¥%d)")
                            :format(tostring(pick.asset or pick.id), before, pick.cost or 0))
                        acted = true
                    end
                else

                for _, e in ipairs(EXP_UPGRADES) do
                    if not upgradeOn then break end
                    local u = findMyUnit(e.assets)
                    if u and u.upgrade < math.min(e.target, u.maxUp) then
                        local cost, yen = u.cost or 0, getYen()
                        -- เช็คเงินก่อน (NextStats.Cost = ราคาอัพจริง) — ไม่พอก็รอ ไม่ยิงมั่ว
                        if cost > 0 and yen < cost then
                            break
                        end
                        local before = u.upgrade
                        pcall(function() rep:FireServer("UpgradeGameUnit", tostring(u.id)) end)
                        task.wait(1.2)
                        local after = findMyUnit(e.assets)
                        if after and after.upgrade > before then
                            print(("[Exp] ⬆️ %s: %d → %d (จ่าย ¥%d เหลือ ¥%d)")
                                :format(e.name, before, after.upgrade, cost, getYen()))
                            acted = true
                        end
                        break   -- โฟกัสตัวนี้ก่อนจนถึง target
                    end
                end

                end   -- จบ if โหมดสุ่ม / else โหมดฟิคตัว
            end
            task.wait(acted and 0.3 or 2.5)   -- อัพติด = ลองต่อเร็ว | ไม่ติด = รอเงิน
        end
        print("[Exp] ⏹️ หยุดลูปอัพเกรด")
    end)
end
local function stopUpgradeLoop() upgradeOn = false end


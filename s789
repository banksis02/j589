-- ปุ่มที่มองเห็นทั้งหมด (พร้อมข้อความรวมลูก)
local function visibleButtons()
    local out = {}
    for _, g in ipairs(player.PlayerGui:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled then
            for _, b in ipairs(g:GetDescendants()) do
                if b:IsA("GuiButton") and b.Visible and b.AbsoluteSize.X > 3 then
                    local parts = { txt(b) }
                    for _, l in ipairs(b:GetDescendants()) do
                        if l:IsA("TextLabel") and l.Visible then table.insert(parts, txt(l)) end
                    end
                    table.insert(out, { btn = b, text = table.concat(parts, " | ") })
                end
            end
        end
    end
    return out
end

local function findBtn(needle, timeout)
    local t0 = tick()
    local want = needle:lower()
    repeat
        local exact, loose
        for _, e in ipairs(visibleButtons()) do
            local t = e.text:lower()
            if t:gsub("^%s*|*%s*", "") == want or (" " .. t .. " "):find("| " .. want .. " |", 1, true) then
                exact = exact or e.btn
            elseif t:find(want, 1, true) then
                loose = loose or e.btn
            end
        end
        if exact then return exact end
        if loose then return loose end
        task.wait(0.3)
    until tick() - t0 > (timeout or 5)
    return nil
end

local function clickText(needle, timeout)
    local b = findBtn(needle, timeout)
    if not b then warn("[Enter] ❌ ไม่เจอปุ่ม '" .. needle .. "'"); return false end
    clickHard(b)
    print("[Enter] 👆 กด '" .. needle .. "'")
    return true
end


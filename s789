            -- ⭐ Ignore.Units = ยูนิตเรา (UUID) + ศัตรู (เลข)
            -- - ยูนิตเรา: ชื่อเป็น UUID (8-4-4-4-12) หรือมี Identifier attribute → เก็บไว้ + ปิดแค่ effects
            -- - ศัตรู: ชื่อเป็นเลขล้วน ไม่มี Identifier → ซ่อนทั้งตัว
            local myUnits = ignore:FindFirstChild("Units")
            if myUnits then
                local function isPlayerUnit(m)
                    if m:GetAttribute("Identifier") then return true end
                    if m:GetAttribute("ManualTargeting") ~= nil then return true end
                    -- UUID format: 8-4-4-4-12 hex chars
                    if m.Name:match("^[%w]+%-[%w]+%-[%w]+%-[%w]+%-[%w]+$") then return true end

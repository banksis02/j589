local function fireSummon(bannerKey, n)
    if not updateNode then L("❌ ไม่เจอ _updateNode"); return false end
    local ok,err = pcall(function() updateNode:FireServer({Type="Post"}, "BANNER_SUMMON", bannerKey, n) end)

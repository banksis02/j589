    local function isDecoration(obj)
        -- ⭐ ถ้าเป็น floor/path/wall → ห้ามนับว่า decoration
        if isFloorPart(obj) then return false end
        local n = obj.Name:lower()
        for _, kw in ipairs(DECO_KEYWORDS) do
            if n:find(kw) then return true end
        end
        local parentName = obj.Parent and obj.Parent.Name:lower() or ""
        for _, kw in ipairs(DECO_KEYWORDS) do
            if parentName:find(kw) then return true end
        end
        return false
    end

    local function hideEnemyVisuals(model)
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") or d:IsA("MeshPart") or d:IsA("UnionOperation") then
                pcall(function() d.Transparency = 1 end)
                pcall(function() d.CastShadow = false end)
                pcall(function() d.LocalTransparencyModifier = 1 end)
            elseif d:IsA("Decal") or d:IsA("Texture") then
                pcall(function() d.Transparency = 1 end)
            elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
                or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then
                pcall(function() d.Enabled = false end)
            elseif d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
                -- ปิด HP bar / nameplate
                pcall(function() d.Enabled = false end)
            elseif d:IsA("Humanoid") then
                -- ปิด nameplate ของ Humanoid
                pcall(function() d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
                pcall(function() d.NameDisplayDistance = 0 end)
                pcall(function() d.HealthDisplayDistance = 0 end)
            end
        end
        -- Hook part ใหม่ที่จะ add เข้ามาภายใน model นี้
        model.DescendantAdded:Connect(function(d)
            task.wait(0.05)
            if d:IsA("BasePart") or d:IsA("MeshPart") or d:IsA("UnionOperation") then
                pcall(function() d.Transparency = 1 end)
                pcall(function() d.CastShadow = false end)
                pcall(function() d.LocalTransparencyModifier = 1 end)
            elseif d:IsA("Decal") or d:IsA("Texture") then
                pcall(function() d.Transparency = 1 end)
            elseif d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
                pcall(function() d.Enabled = false end)
            end
        end)
    end

    -- เช็คว่า object อยู่ใน folder ที่ห้ามแตะหรือไม่
    local PROTECTED_PARENTS = { PathDECO=true, TerrainParts=true, Path=true, Spawns=true }
    local function isProtected(obj)
        local p = obj.Parent
        while p and p ~= workspace do
            if PROTECTED_PARENTS[p.Name] then return true end
            p = p.Parent
        end
        return false
    end

    local function processInstance(obj)
        -- ⭐ Effects (Particle/Trail/Beam/Smoke/Fire/Sparkles/Explosion) — ปิด"เสมอ" ไม่ว่าจะอยู่ที่ไหน
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
           or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles")
           or obj:IsA("Explosion") then
            pcall(function() obj.Enabled = false end)
            return
        end
        -- Lights — ปิดเสมอ
        if obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
            pcall(function() obj.Enabled = false end)
            return
        end
        -- Post-effects — ปิดเสมอ
        if obj:IsA("BlurEffect") or obj:IsA("BloomEffect")
           or obj:IsA("SunRaysEffect") or obj:IsA("ColorCorrectionEffect")
           or obj:IsA("DepthOfFieldEffect") then
            pcall(function() obj.Enabled = false end)
            return
        end

        -- ตรงจุดนี้เป็น BasePart/Decal/Texture — เช็ค protected ก่อนแตะ
        if isProtected(obj) then return end

        -- ลบ decal/texture
        if obj:IsA("Decal") or obj:IsA("Texture") then
            pcall(function() obj.Transparency = 1 end)
            return
        end
        -- BasePart: ซ่อน decoration / ลด material
        if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation") then
            if isDecoration(obj) then
                pcall(function() obj.Transparency = 1 end)
                pcall(function() obj.CanCollide = false end)
            end
            pcall(function() obj.Material = Enum.Material.SmoothPlastic end)
            pcall(function() obj.CastShadow = false end)
            pcall(function() obj.Reflectance = 0 end)
        end
    end


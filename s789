-- ---------- ช่องตัวละคร ----------
-- ⭐ hotbar "ในด่าน" = HotbarData ที่ PlacementAllowed=true / MaxSlots=10 (id 67)
--    ช่องปกติ  : Slots[n].ID = "Yuta#uuid"
--    ช่องตัวจ้าง: Slots[n].ID = JSON  {"Asset":"IchigoEVO","IsHelper":true,...}
local function gameHotbar()
    local best
    for _, e in ipairs(eachReplica("HotbarData")) do
        local d = e.data
        if d and type(d.Slots) == "table" then
            if d.PlacementAllowed == true then return e end
            if not best or (tonumber(d.MaxSlots) or 0) > (tonumber(best.data.MaxSlots) or 0) then best = e end
        end
    end
    return best
end

local function parseSlotAsset(id)
    if type(id) ~= "string" then return nil end
    if id:find('"Asset"') then
        -- JSON ของตัวจ้าง: มี "Asset" หลายที่ (EquipmentData ด้วย) → เอาตัวที่ไม่ใช่ Equipment
        local first
        for a in id:gmatch('"Asset"%s*:%s*"([^"]+)"') do
            first = first or a
            if not a:find("Equipment") then return a, true end
        end
        return first, true
    end
    return (id:gsub("#.*$", "")), false                -- ตัวปกติ "Yuta#uuid"
end

local function scanSlots()
    local slots = {}
    local hb = gameHotbar()
    if not hb or not hb.data or type(hb.data.Slots) ~= "table" then return slots end
    for k, v in pairs(hb.data.Slots) do
        local n = tonumber(k)
        if n and type(v) == "table" then
            local asset = parseSlotAsset(v.ID)
            local id = type(v.ID) == "string" and v.ID or ""
            slots[n] = {
                asset  = asset or "?",
                atype  = tostring(v.AssetType or "?"),          -- Unit / Tome / Item ...
                helper = id:find('"IsHelper":true', 1, true) ~= nil,
                cost   = tonumber(v.PlacementCost),
                limit  = tonumber(v.PlacementLimit),
            }
        end
    end
    return slots
end


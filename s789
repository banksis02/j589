--    _G.AE_EXP_MAP  = "School Grounds" | "Flower Forest" | "Rose Kingdom"
--    _G.AE_EXP_DIFF = 1 | 2 | 3
-- ⭐ v9.33 โหมดวนด่าน: _G.AE_EXP_ROTATE = true → วนแมพตามลิสต์ ด่านละ N นาที

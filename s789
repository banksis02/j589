do -- [EXP 1] MAP + COMBAT
-- ============================================================
-- AE Expedition Auto — หาแมพที่มีเส้นทาง Defense≥3 + Yen แล้วเลือกเส้นทาง
--   เปิดหน้า Expedition Map ค้างไว้ แล้วรัน
--   เทสทีละส่วน:
--     _G.AE_EXP_CHECK()    → เช็คแมพ (print เส้นทางที่เจอ)
--     _G.AE_EXP_SETROUTE() → ยิง SetNodeQueue เลือกเส้นที่เจอล่าสุด
--     _G.AE_EXP_RESTART()  → Restart Game (หาแมพใหม่)
--     _G.AE_EXP_AUTO()     → วนอัตโนมัติ: เช็ค → ไม่ผ่าน restart → ผ่าน setRoute
-- ============================================================
local MYGEN = _G.AE_SCRIPT_GEN   -- รุ่นสคริปต์ (โหลดใหม่ = ลูปเก่าตาย)
local player = game:GetService("Players").LocalPlayer
local RS = game:GetService("ReplicatedStorage")
local VIM = game:GetService("VirtualInputManager")
local GuiService = game:GetService("GuiService")

local NEED_DEFENSE = 3
local NEED_YEN     = 1
-- ⭐ ถ้าเจอ Yen ตั้งแต่กี่อันขึ้นไป → เอาเลย ไม่ต้องครบโล่ 3
--    (นับเฉพาะ Yen ที่ไม่ได้อยู่โหนดบอส/โหนดสุดท้าย)
local YEN_ONLY_MIN = 2

-- ---------- replica (ยิง SetNodeQueue โดยไม่ต้องเดา opcode) ----------
local registry
pcall(function()
    local RC = require(RS.Shared.ReplicaClient)
    for _, up in pairs(debug.getupvalues(RC.FromId)) do
        if type(up)=="table" then
            for kk in pairs(up) do if type(kk)=="number" then registry=up; break end end
            if registry then break end
        end
    end
end)
local function getReplica(token)
    if not registry then return nil end
    local cand
    for _, rep in pairs(registry) do
        local ok,t = pcall(function() return rep.Token end)
        if ok and t==token then
            if rawget(rep,"write_lib") then return rep end
            cand = cand or rep
        end
    end
    return cand
end

-- ---------- เช็คแมพ (scan + graph + pathfind) ----------
local lastPath = nil
local lastNodesById = {}   -- id -> node object (มี .btn) ของ scan ล่าสุด
local lastBestAny = nil    -- เส้นทางดีที่สุดที่เดินได้ (แม้ไม่ผ่านเงื่อนไข) — ใช้ fallback

-- ⭐ สแกนปุ่มโหนด (กรองแถบ Route Rewards ด้านล่างออก)
local function scanNodeButtons(prompt)
    local cam = workspace.CurrentCamera
    local vpY = (cam and cam.ViewportSize.Y) or 600
    local rewardTop = vpY * 0.78          -- แถบ Route Rewards อยู่ล่างสุด ~22% → ตัดทิ้ง
    local raw = {}
    for _, btn in ipairs(prompt:GetDescendants()) do
        if btn:IsA("TextButton") and btn.Visible
           and btn.AbsoluteSize.X >= 24 and btn.AbsoluteSize.X <= 36 then
            local p = btn.AbsolutePosition
            if p.Y < rewardTop then       -- ไม่เอาปุ่มในแถบรางวัลด้านล่าง
                table.insert(raw, { btn=btn, x=p.X, y=p.Y,
                    cx=p.X+btn.AbsoluteSize.X/2, cy=p.Y+btn.AbsoluteSize.Y/2 })
            end
        end
    end
    return raw
end

-- 🔍 เก็บ log ตอนแมพอ่านผิด (auto — ไม่ต้องนั่งเฝ้า)
local function dumpBadMap(reason, raw, prompt)
    local out = { "===== BAD MAP: " .. reason .. " =====", "โหนดที่เจอ: " .. #raw }
    local cam = workspace.CurrentCamera
    out[#out+1] = "viewport: " .. tostring(cam and cam.ViewportSize)
    for i, n in ipairs(raw) do
        if i <= 60 then out[#out+1] = ("  #%d (%d,%d) size=%s"):format(i, n.x, n.y, tostring(n.btn.AbsoluteSize)) end
    end
    local s = table.concat(out, "\n")
    warn(s)
    _G.AE_LAST_BADMAP = s   -- เก็บไว้ใน _G ดูได้ — ไม่ setclipboard (รบกวน ctrl+c)
end

local function checkMap()
    local prompt = player.PlayerGui:FindFirstChild("Prompt")
    if not prompt then return nil, "ไม่เจอ Prompt (เปิดหน้า Expedition Map?)" end

    -- ⭐ สแกน + เช็คความถูกต้อง; แมพยังโหลดไม่เสร็จ = โหนดเพี้ยน → รอแล้วสแกนใหม่
    -- แมพ Expedition จริง: 10 คอลัมน์ × 2-3 แถว = ได้ถึง ~30 โหนด (25 = ปกติ!)
    --    เกิน 40 = ปุ่มค้าง/แมพยังโหลดไม่เสร็จจริงๆ
    local raw
    for tryScan = 1, 4 do
        raw = scanNodeButtons(prompt)
        if #raw >= 3 and #raw <= 40 then break end
        if tryScan < 4 then
            print(("[Exp] ⏳ แมพยังไม่นิ่ง (เจอ %d โหนด) — รอโหลด..."):format(#raw))
            task.wait(1.2)
        end
    end
    if #raw > 40 then
        dumpBadMap("โหนดเยอะผิดปกติ (" .. #raw .. ")", raw, prompt)
        return nil, "NOTREADY:โหนดเยอะผิดปกติ (" .. #raw .. ") — แมพยังโหลดไม่เสร็จ"
    end
    if #raw < 3 then return nil, "หา node ไม่เจอ (" .. #raw .. ")" end
    table.sort(raw, function(a,b)
        if math.abs(a.x-b.x)>40 then return a.x<b.x end
        return a.y<b.y
    end)
    local colX = {}
    for _, n in ipairs(raw) do
        local ci
        for k,xv in ipairs(colX) do if math.abs(n.x-xv)<40 then ci=k; break end end
        if not ci then colX[#colX+1]=n.x; ci=#colX end
        n.col = ci
    end
    for i,n in ipairs(raw) do n.id=i end
    local lastCol = #colX
    lastNodesById = {}
    for _, n in ipairs(raw) do lastNodesById[n.id] = n end

    -- hover scan type + yen (อ่านใน tooltip container เท่านั้น)
    local inset = GuiService:GetGuiInset()
    local function readTip()
        local root
        for _, d in ipairs(player.PlayerGui:GetDescendants()) do
            if d:IsA("TextLabel") and d.Visible and d.Text=="Expedition Node" then
                root=d
                for _=1,6 do if root.Parent and root.Parent~=prompt then root=root.Parent else break end end
                break
            end
        end
        if not root then return nil,false end
        local typ, yen
        for _, l in ipairs(root:GetDescendants()) do
            if l:IsA("TextLabel") and l.Visible then
                local t=l.Text
                if t=="Checkpoint" or t=="Assault" or t=="Elite" or t=="Defense" or t=="Boss" or t=="Miniboss" then typ=t
                elseif t=="Yen" then yen=true end
            end
        end
        return typ, yen
    end
    for _, n in ipairs(raw) do
        pcall(function() VIM:SendMouseMoveEvent(n.cx, 5, game) end)
        task.wait(0.05)
        pcall(function() VIM:SendMouseMoveEvent(n.cx, n.cy+inset.Y, game) end)
        task.wait(0.3)
        n.type, n.yen = readTip()
        n.type = n.type or "?"
    end

    -- edges จากเส้นเชื่อม
    local function nearestNode(px,py)
        local best,bd
        for _, n in ipairs(raw) do
            local d=(n.cx-px)^2+(n.cy+inset.Y-py)^2
            if not bd or d<bd then bd=d; best=n end
        end
        if bd and bd<60^2 then return best end
    end
    local adj={}; for _,n in ipairs(raw) do adj[n.id]={} end
    for _, d in ipairs(prompt:GetDescendants()) do
        if (d:IsA("Frame") or d:IsA("ImageLabel")) and d.Visible then
            local sz=d.AbsoluteSize
            if sz.X>40 and sz.Y<12 then
                local cx=d.AbsolutePosition.X+sz.X/2
                local cy=d.AbsolutePosition.Y+sz.Y/2+inset.Y
                local rad=math.rad(d.Rotation)
                local ex,ey=math.cos(rad)*sz.X/2, math.sin(rad)*sz.X/2
                local a=nearestNode(cx-ex,cy-ey)
                local b=nearestNode(cx+ex,cy+ey)
                if a and b and a.id~=b.id then
                    local from=(a.col<b.col) and a or b
                    local to  =(a.col<b.col) and b or a
                    if to.col==from.col+1 then adj[from.id][to.id]=true end
                end
            end
        end
    end

    -- pathfind
    --  เงื่อนไขผ่าน (อย่างใดอย่างหนึ่ง):
    --    A) Defense >= 3 และ Yen >= 1
    --    B) Yen >= 2       (โล่ไม่ครบก็เอา — เงินสำคัญกว่า)
    --  ⭐ Yen ที่อยู่ "โหนดบอส/โหนดสุดท้าย" ไม่นับ (ได้ตอนจบรันอยู่แล้ว)
    local byId={}; for _,n in ipairs(raw) do byId[n.id]=n end
    local best=nil
    local function countsYen(node)
        if not node.yen then return false end
        if node.type == "Boss" then return false end        -- Yen ที่บอส ไม่นับ
        if node.col == lastCol then return false end        -- โหนดสุดท้าย (โหนด 10) ไม่นับ
        return true
    end
    local function passes(def, yen)
        if def >= NEED_DEFENSE and yen >= NEED_YEN then return true end
        if yen >= YEN_ONLY_MIN then return true end          -- Yen เยอะ = เอาเลย
        return false
    end
    local function scoreOf(def, yen, len)
        return def * 10 + yen * 12 - len                     -- Yen มีค่ามากกว่าโล่นิดหน่อย
    end
    local bestAny=nil    -- ⭐ เส้นทางที่ดีที่สุด "ที่เดินได้" แม้ไม่ผ่านเงื่อนไข (เผื่อ fallback)
    local function dfs(node, path, def, yen)
        local np={}; for _,v in ipairs(path) do np[#np+1]=v end
        np[#np+1]=node.id
        local nd=def+(node.type=="Defense" and 1 or 0)
        local ny=yen+(countsYen(node) and 1 or 0)
        if node.col==lastCol then
            local sc = scoreOf(nd, ny, #np)
            if not bestAny or sc > bestAny.score then
                bestAny={path=np, def=nd, yen=ny, score=sc}
            end
            if passes(nd, ny) then
                if not best or sc > best.score then
                    best={path=np, def=nd, yen=ny, score=sc}
                end
            end
            return
        end
        for tid in pairs(adj[node.id]) do
            if byId[tid] then dfs(byId[tid], np, nd, ny) end
        end
    end
    for _, n in ipairs(raw) do if n.col==1 then dfs(n,{},0,0) end end

    -- สรุป type ทั้งแมพ (debug)
    local summary={}
    for _, n in ipairs(raw) do summary[n.type]=(summary[n.type] or 0)+1 end
    local sumStr={}; for t,c in pairs(summary) do sumStr[#sumStr+1]=t.."="..c end

    -- ⭐ แมพจริงมีบอสตัวเดียว — เจอ ≥2 = อ่านเพี้ยน (แมพยังไม่นิ่ง) → ให้รอ ไม่ใช่ restart
    if (summary["Boss"] or 0) >= 2 then
        dumpBadMap("Boss=" .. summary["Boss"] .. " (ควรมีตัวเดียว)", raw, prompt)
        return nil, "NOTREADY:Boss=" .. summary["Boss"] .. " — แมพอ่านเพี้ยน"
    end

    lastBestAny = bestAny   -- เก็บไว้ให้ fallback เรียกใช้
    return best, table.concat(sumStr, " ")
end

-- ---------- ยิง SetNodeQueue เลือกเส้นทาง ----------
-- ⭐ SetNodeQueue เป็นของ replica ตัวไหนยังไม่ชัด (ไม่ใช่ GamePlayerData!)
--    วิธีชัวร์: hook ดักตอนเกม/ผู้ใช้ยิง SetNodeQueue → จับ replica id → หา token
--    ถ้ายังไม่เรียนรู้ → ลองยิงทุก token ที่น่าจะใช่ (ตัวผิด server ignore)
local learnedNodeToken = "MapData"   -- ⭐ ยืนยันแล้ว: SetNodeQueue = replica MapData
local scriptFiring = false           -- กัน hook เรียนรู้จากการยิงของเราเอง
local sig = RS.RemoteEvents.ReplicaSignal
pcall(function()
    local oldNC
    oldNC = hookmetamethod(game, "__namecall", function(self, ...)
        if not scriptFiring and self == sig and getnamecallmethod() == "FireServer" then
            local a1, a2 = ...
            if a2 == "SetNodeQueue" and type(a1) == "number" then
                if registry and registry[a1] then
                    local ok, tok = pcall(function() return registry[a1].Token end)
                    if ok and tok and tok ~= learnedNodeToken then
                        learnedNodeToken = tok
                        print("[Exp] 🎣 เรียนรู้ SetNodeQueue = replica '" .. tok .. "' (id " .. a1 .. ")")
                    end
                end
            end
        end
        return oldNC(self, ...)
    end)
end)

local function fireBtn(b)
    local n=0
    pcall(function() for _,c in ipairs(getconnections(b.MouseButton1Click)) do c:Fire(); n=n+1 end end)
    if n==0 then pcall(function() for _,c in ipairs(getconnections(b.Activated)) do c:Fire(); n=n+1 end end) end
    return n
end

-- ⭐ เลือกเส้นทางด้วยการ "คลิก node ทีละอัน" ตามเส้นทาง (เกมแปลง click → server id เอง)
--    เลี่ยงปัญหา node id: client ไม่มี server node graph จึงส่ง id เองไม่ได้
local VIM_EXP = game:GetService("VirtualInputManager")
local inset_exp = game:GetService("GuiService"):GetGuiInset()
local function clickNode(node)
    -- ลอง getconnections ก่อน
    if fireBtn(node.btn) > 0 then return true end
    -- fallback: VIM คลิกที่พิกัดกลางปุ่ม
    pcall(function()
        local cx, cy = node.cx, node.cy + inset_exp.Y
        VIM_EXP:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
        task.wait(0.05)
        VIM_EXP:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
    end)
    return true
end

local function setRoute(path)
    if not path then return false end
    print("[Exp] 🖱️ เลือกเส้นทางด้วยการคลิก node: {" .. table.concat(path,",") .. "}")
    -- คลิกทีละ node ตามเส้นทาง (ข้าม node แรก = จุด start อาจไม่ต้องคลิก)
    for i, id in ipairs(path) do
        local node = lastNodesById[id]
        if node then
            clickNode(node)
            print(("[Exp]   คลิก node id %d (col%s %s)"):format(id, tostring(node.col), tostring(node.type)))
            task.wait(0.4)
        end
    end
    print("[Exp] ✅ คลิกครบ — ดูว่าเส้นเขียวเปลี่ยนตามไหม")
    return true
end
-- คลิกปุ่มตามข้อความ (หาทุก ScreenGui ที่ enabled)
-- ⭐ คลิกปุ่มตามข้อความ + VIM คลิกพิกัดจริงเป็น fallback (บางปุ่ม connection ไม่ทำงาน)
local function clickBtnSmart(b)
    if fireBtn(b) > 0 then return true end
    pcall(function()
        local cx = b.AbsolutePosition.X + b.AbsoluteSize.X/2
        local cy = b.AbsolutePosition.Y + b.AbsoluteSize.Y/2 + inset_exp.Y
        VIM_EXP:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
        task.wait(0.06)
        VIM_EXP:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
    end)
    return true
end

local function clickByText(text, timeout)
    local t0 = tick()
    while tick()-t0 < (timeout or 3) do
        for _, root in ipairs(player.PlayerGui:GetChildren()) do
            if root:IsA("ScreenGui") and root.Enabled then
                for _, b in ipairs(root:GetDescendants()) do
                    if b:IsA("GuiButton") and b.Visible then
                        local hit = (b:IsA("TextButton") and b.Text == text)
                        if not hit then
                            for _, l in ipairs(b:GetDescendants()) do
                                if l:IsA("TextLabel") and l.Visible and l.Text == text then hit = true; break end
                            end
                        end
                        if hit then clickBtnSmart(b); return true end
                    end
                end
            end
        end
        task.wait(0.3)
    end
    return false
end

-- เช็คว่าอยู่หน้า Expedition Map (node select) ไหม
local function inNodeSelect()
    local prompt = player.PlayerGui:FindFirstChild("Prompt")
    if not prompt then return false end
    for _, l in ipairs(prompt:GetDescendants()) do
        if l:IsA("TextLabel") and l.Visible and l.Text == "Map Progress" then return true end
    end
    return false
end

-- ⭐ ยิง Restart ผ่าน replica ตรงๆ — ดักจากการกดจริง: ReplicaSignal(60, "Restart")
--    (คลิก UI ปิดกล่องได้แต่เกมไม่ restart — เหมือนเคส Return to Lobby)
local function fireRestartRemote()
    local ok = false
    -- ลอง replica ที่น่าจะใช่ก่อน (GameState = ตัวที่ handle SetNodeQueue/Restart)
    for _, token in ipairs({ "GameState", "MapData", "GamePlayerData" }) do
        local rep = getReplica(token)
        if rep then
            local fired = pcall(function() rep:FireServer("Restart") end)
            if fired then
                print("[Exp] 📤 ยิง Restart ผ่าน replica " .. token)
                ok = true
            end
        end
    end
    return ok
end

-- ============================================================
-- 🔍 RESTART SPY — ดักว่า "ปุ่ม Restart จริง" ยิงอะไร (ทำมือ 1 ครั้ง)
--   _G.AE_RESTART_SPY()      → เริ่มดัก แล้วกด Restart ด้วยมือ (รีแมพใหม่จริง)
--   _G.AE_RESTART_SPY_STOP() → หยุด + สรุป
-- ============================================================
local rsQueue, rsOn = {}, false
_G.AE_RESTART_SPY = function()
    if rsOn then print("[Spy] ดักอยู่แล้ว"); return end
    rsOn = true
    table.clear(rsQueue)
    -- ดักทั้ง ReplicaSignal และ RemoteEvent/RemoteFunction อื่นๆ (เผื่อไม่ใช่ replica)
    local old
    old = hookmetamethod(game, "__namecall", function(self, ...)
        if rsOn then
            local m = getnamecallmethod()
            if m == "FireServer" or m == "InvokeServer" then
                local okName, nm = pcall(function() return self.Name end)
                local okCls, cls = pcall(function() return self.ClassName end)
                rsQueue[#rsQueue+1] = { t = tick(),
                    name = okName and nm or "?", cls = okCls and cls or "?",
                    method = m, args = table.pack(...) }
            end
        end
        return old(self, ...)
    end)
    print("[Spy] 🔍 เริ่มดักแล้ว — ตอนนี้กด Restart/รีแมพ ด้วยมือ 1 ครั้ง")
    print("[Spy]    เสร็จแล้วพิมพ์ _G.AE_RESTART_SPY_STOP()")
    task.spawn(function()
        local t0 = tick()
        while rsOn do
            while #rsQueue > 0 do
                local e = table.remove(rsQueue, 1)
                local parts = {}
                for i = 1, e.args.n do
                    local v = e.args[i]
                    parts[i] = (type(v) == "string") and ('"'..v..'"') or tostring(v)
                end
                print(("[SPY %5.1fs] %s.%s(%s)  [%s]")
                    :format(e.t - t0, e.name, e.method, table.concat(parts, ", "), e.cls))
            end
            task.wait(0.2)
        end
    end)
end
_G.AE_RESTART_SPY_STOP = function() rsOn = false; print("[Spy] ⏹ หยุดดักแล้ว") end

-- ⭐ "ลายแมพ" = ตำแหน่งปุ่มโหนดทั้งหมดในหน้าแผนที่ (แมพใหม่ = ลายใหม่เสมอ)
--    ใช้พิสูจน์ว่า Restart ติดจริง — แค่กลับเข้าหน้าแผนที่ได้ ไม่ได้แปลว่ารีแล้ว
local function mapLayoutSig()
    if not inNodeSelect() then return nil end
    local prompt = player.PlayerGui:FindFirstChild("Prompt")
    if not prompt then return nil end
    local parts = {}
    for _, btn in ipairs(prompt:GetDescendants()) do
        if btn:IsA("TextButton") and btn.Visible
           and btn.AbsoluteSize.X >= 24 and btn.AbsoluteSize.X <= 36 then
            local p = btn.AbsolutePosition
            parts[#parts+1] = math.floor(p.X/4) .. "," .. math.floor(p.Y/4)
        end
    end
    if #parts < 3 then return nil end
    table.sort(parts)
    return table.concat(parts, "|")
end


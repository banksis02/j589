local COST = 50   -- currency ต่อ 1 สุ่ม (ทั้ง gem และ villain coin)

-- banner: key, ItemData currency, batch สูงสุดต่อ call
local BANNERS = {
    { key="VillainInvasion", cur="VillainCurrency", batch=50 },   -- villain coin (มีเยอะ → ใช้ก่อน)
    { key="Standard",        cur="Gem",             batch=10 },   -- gem

    local before = getYen()
    pcall(function() gs:FireServer("HireUnit", h.key) end)
    print(("[Hire] 📤 HireUnit %s (%s)"):format(h.key, tostring(h.unit)))
    task.wait(1.2)

    local after = getYen()
    if after < before then
        print(("[Hire] ✅ จ้างสำเร็จ — เงิน %d → %d"):format(before, after))
    else
        print(("[Hire] ⚠️ เงินไม่ลด (%d) — อาจจ้างไม่สำเร็จ แต่จะลองหาช่องต่อ"):format(after))
    end

    -- มี Tome อยู่ → ใส่ให้ยูตะก่อน (ไม่งั้นกล่อง "Select a unit" จะบังการวาง)
    if _G.AE_TOME_USE then pcall(_G.AE_TOME_USE) end
    closeTomePrompt()   -- กันกล่อง Tome บังอยู่

    -- หาช่องที่ตัวใหม่เข้าไป (ชื่อ asset ก่อน → ไม่เจอใช้ช่องที่เป็นตัวจ้าง IsHelper)
    local slot
    for _ = 1, 8 do
        slot = findSlotWithAsset(h.unit)
        if not slot then
            local hs, hasset = findHelperSlot()
            if hs then slot = hs; print("[Hire] 🔎 ใช้ช่องตัวจ้าง " .. hs .. " (" .. tostring(hasset) .. ")") end
        end
        if slot then break end
        task.wait(0.5)
    end
    if not slot then
        warn("[Hire] ⚠️ หาช่องของ " .. tostring(h.unit) .. " ไม่เจอ — ข้ามการวาง")
        return false
    end
    print(("[Hire] 📦 %s อยู่ช่อง %d → วางบนรถ"):format(tostring(h.unit), slot))
    return placeOnPayload(slot, h.unit)
end


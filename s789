-- ---------- rarity ----------
local RANK = { Common=1, Uncommon=2, Rare=1, Epic=2, Legendary=3, Mythic=4, Godly=5, Divine=6, Secret=7 }
local DO_THRESHOLD = 4     -- ⭐ v9.47: ทำแค่ 4★ (Mythic) เท่านั้น | ต่ำกว่า reroll ทิ้ง
local function rarityOfId(id) return (tostring(id):gsub("%d+$","")) end
local function rankOfId(id) return RANK[rarityOfId(id)] or 0 end

local function gold()
    local d = pdata()
    local g = d and d.ItemData and d.ItemData.Gold
    if type(g)=="table" then return tonumber(g.Amount) or 0 end

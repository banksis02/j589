-- คลิกแท็บ (รองรับชื่อไทย/อังกฤษ)
local function clickTab(...)
    local wants = { ... }
    local s = player.PlayerGui:FindFirstChild("Settings")
    if not s then return false end
    for _, btn in ipairs(s:GetDescendants()) do
        if btn:IsA("TextButton") and btn.Visible then
            local texts = { btn.Text }
            for _, l in ipairs(btn:GetDescendants()) do
                if l:IsA("TextLabel") then texts[#texts+1] = l.Text end
            end
            for _, w in ipairs(wants) do
                for _, t in ipairs(texts) do
                    if t == w then fireBtn(btn); task.wait(0.6); return true end
                end
            end
        end
    end
    return false
end


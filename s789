local function assetIs(name, list)
    local a = tostring(name):lower()
    for _, k in ipairs(list) do
        if a:find(k, 1, true) then return true end
    end
    return false
end
local function isFarmUnit(name) return assetIs(name, FARM_ASSETS) end
local function isLongRange(name) return assetIs(name, LONG_ASSETS) end
local function isSupportUnit(name) return assetIs(name, SUPPORT_ASSETS) or assetIs(name, FARM_ASSETS) end
_G.AE_EXP_ISSUPPORT = isSupportUnit

local function placeRandomFromHotbar(skipSlots)
    local rep = getReplica("GamePlayerData")
    if not rep then return 0 end
    local hb = gameHotbarSlots()
    local slots = {}
    for slot = 1, 10 do
        if hb[slot] and not (skipSlots and skipSlots[slot]) then table.insert(slots, slot) end
    end
    if #slots == 0 then
        -- สำรอง: อ่านจากทีมล็อบบี้ (เผื่อ hotbar ในด่านยังไม่มา)
        local assets = getHotbarAssets()
        for slot = 1, 10 do
            if assets[slot] and not (skipSlots and skipSlots[slot]) then table.insert(slots, slot) end
        end
    end
    if #slots == 0 then return 0 end

    -- ⭐ เรียงลำดับ: ตัวตีก่อน (ไปยืนจุด 1 ได้) → ตัวระยะไกล → ตัวหาเงินท้ายสุด
    table.sort(slots, function(a, b)
        local aa, ba = (hb[a] and hb[a].asset) or "", (hb[b] and hb[b].asset) or ""
        local ra = isFarmUnit(aa) and 3 or (isLongRange(aa) and 2 or 1)
        local rb = isFarmUnit(ba) and 3 or (isLongRange(ba) and 2 or 1)
        if ra ~= rb then return ra < rb end
        return a < b
    end)
    print(("[Exp Place] 🎲 โหมดสุ่ม: วาง %d ตัวจากช่องที่มี (เน้นจุด 2 ฝั่งบอส)"):format(#slots))

    local placed, frontUsed = 0, 0
    for _, slot in ipairs(slots) do
        local asset = (hb[slot] and hb[slot].asset) or ""
        -- จุด 1 (หัวรถ) วางแค่ 1-2 ตัว และต้องเป็น "ตัวตี" เท่านั้น
        --   ตัวหาเงิน (Ramen Guy) ตีไม่ได้ → ยืนเดี่ยวจุด 1 = มอนทะลุ แพ้
        --   ตัวระยะไกล (Elf Mage) ครอบทั้งรถอยู่แล้ว → ไว้จุด 2 พอ
        local zone = "back"
        if isLongRange(asset) then
            zone = "mid"                      -- ระยะไกลมาก → กลางรถได้ (จุดเดียวกับยูตะ)
        elseif not isFarmUnit(asset) and frontUsed < FRONT_MAX and placed >= 1 then
            zone = "front"; frontUsed = frontUsed + 1
        end
        if asset ~= "" then
            local zn = (zone == "back" and "จุด2") or (zone == "front" and "จุด1") or "กลางรถ"
            print(("[Exp Place] 🎲 %s → %s%s"):format(asset, zn,
                isFarmUnit(asset) and " (ตัวหาเงิน)" or (isLongRange(asset) and " (ระยะไกล)" or "")))
        end
        local cf = randomPayloadCF(zone)
        if cf then
            selectSlot(slot)
            task.wait(0.12)
            pcall(function() rep:FireServer("PlaceGameUnit", slot, cf) end)
            print(("[Exp Place] 🎲 ช่อง %d → %s (%.1f, %.1f, %.1f)")
                :format(slot, zone == "back" and "จุด2" or "จุด1", cf.Position.X, cf.Position.Y, cf.Position.Z))
            placed = placed + 1
            task.wait(0.25)
        end
    end
    return placed
end
_G.AE_EXP_PLACE_RANDOM = placeRandomFromHotbar


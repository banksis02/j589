-- unit ที่เราวางในสนาม (GameUnit replica)
-- ⭐ กรอง Owner = เรา ถ้าเจอ; ถ้าไม่เจอเลย (ชื่อไม่ตรง) → ใช้ทั้งหมด กันหาไม่เจอ
local function getMyGameUnits()
    local mine, all = {}, {}
    if not registry then return mine end
    for _, rep in pairs(registry) do
        local ok, tok = pcall(function() return rep.Token end)
        if ok and tok == "GameUnit" then
            local okd, d = pcall(function() return rep.Data end)
            -- ⭐ ข้ามร่างซัมมอน/โคลน (YutaBatSpirit ฯลฯ) — อัพไม่ได้ + แย่งชื่อกับตัวจริง
            local isClone = okd and type(d) == "table"
                and (d.IsClone or d.Unupgradeable or d.HiddenUnitManager)
            if okd and type(d) == "table" and not isClone then
                local u = {
                    id      = d.ID or d.Id,
                    owner   = tostring(d.Owner or ""),
                    asset   = (d.UnitData and d.UnitData.Asset) or d.Asset or "",
                    upgrade = tonumber(d.Upgrade) or 0,
                    maxUp   = tonumber(d.MaxUpgrade) or 9,
                    cost    = (d.NextStats and tonumber(d.NextStats.Cost)) or nil,  -- ราคาอัพถัดไป
                }
                if u.id then
                    all[#all+1] = u
                    if u.owner == player.Name then mine[#mine+1] = u end
                end
            end
        end
    end
    if #mine > 0 then return mine end
    if #all > 0 then
        warn("[Exp] ⚠️ ไม่เจอ unit ที่ Owner ตรงกับ '" .. player.Name .. "' → ใช้ทุกตัวในสนาม")
    end
    return all
end

-- ⭐ เลือกตัวที่ "ใกล้เคียงที่สุด" — YutaEVO ต้องชนะ YutaBatSpirit
--    exact > ขึ้นต้นตรง (ชื่อสั้นกว่าดีกว่า) > มีคำนั้นอยู่ข้างใน
local function findMyUnit(assets)
    local best, bestScore
    for _, u in ipairs(getMyGameUnits()) do
        local n = normUnit(u.asset)
        for _, a in ipairs(assets or {}) do
            local w = normUnit(a)
            local score
            if n == w then
                score = 10000
            elseif #w >= 4 and n:sub(1, #w) == w then
                score = 5000 - #n          -- ขึ้นต้นด้วยชื่อนั้น (yutaevo ชนะ yutabatspirit)
            elseif #w >= 4 and (n:find(w, 1, true) or w:find(n, 1, true)) then
                score = 1000 - #n
            end
            if score and (not bestScore or score > bestScore) then
                best, bestScore = u, score
            end
        end
    end
    return best
end


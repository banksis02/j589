    -- [UTDX] Auto Vote GohanRiftCards — เลือก Cooldown เสมอ
    -- ============================================================
    task.spawn(function()
        task.wait(5)
        print("[CARD] 👀 Watching for GohanRiftCards...")
        local lastVoteTime = 0

        local function getCardContainer()
            local pg = player.PlayerGui
            local ok, container = pcall(function()
                return pg.GameUI.HUD.RightFrame.TutorialHolder.GohanRiftCards
            end)
            if ok and container and container.Visible then return container end
            return nil
        end

        -- หา index ของการ์ด Cooldown โดยค้นใน descendants
        local function findCooldownIndex(container)
            -- iterate top-level card containers (Card1, Card2, Card3 หรือชื่ออื่น)
            -- เก็บ container ที่มี LayoutOrder เพื่อเรียงตามตำแหน่ง
            local cardList = {}
            for _, child in ipairs(container:GetDescendants()) do
                if child:IsA("TextLabel") and child.Text ~= "" then
                    local t = child.Text:lower()
                    if t:find("cooldown") then
                        -- walk up หา parent card
                        local p = child.Parent
                        while p and p ~= container do
                            -- ถ้า parent มีชื่อเป็นเลข หรือมี LayoutOrder = card หลัก
                            if p.Name:match("^%d+$") or p.Name:lower():find("card") then
                                local n = tonumber(p.Name:match("(%d+)"))
                                if n then return n end
                            end
                            p = p.Parent
                        end
                        -- ถ้าหา parent index ไม่ได้ ลอง count position
                        -- โดยดูว่า cooldown ตัวนี้อยู่ลำดับที่เท่าไหร่ใน list
                    end
                end
            end
            return nil
        end

        -- หา index แบบ position-based (ดูตำแหน่ง X ของการ์ดบนจอ)
        local function findCooldownIndexByPosition(container)
            -- เก็บ card frame + position
            local cards = {}
            local seen = {}
            for _, d in ipairs(container:GetDescendants()) do
                if d:IsA("TextLabel") and d.Text ~= "" then
                    local lower = d.Text:lower()
                    -- หา card frame ที่ครอบ label นี้
                    local frame = d.Parent
                    while frame and frame ~= container and not frame:IsA("GuiObject") do
                        frame = frame.Parent
                    end
                    -- หา top-level card frame (ลูกตรงของ container)
                    local top = d.Parent
                    while top and top.Parent ~= container do
                        top = top.Parent
                        if not top then break end
                    end
                    if top and not seen[top] then
                        seen[top] = true
                        -- เก็บ text รวม + AbsolutePosition.X
                        local pos = top:IsA("GuiObject") and top.AbsolutePosition.X or 0
                        table.insert(cards, { top = top, x = pos, texts = {} })
                    end
                end
            end
            -- รวม text ของแต่ละ card
            for _, card in ipairs(cards) do
                for _, lbl in ipairs(card.top:GetDescendants()) do
                    if lbl:IsA("TextLabel") then
                        table.insert(card.texts, lbl.Text:lower())
                    end
                end
            end
            -- เรียงตาม X (จากซ้ายไปขวา)
            table.sort(cards, function(a,b) return a.x < b.x end)
            -- หาว่า index ไหนมี "cooldown"
            for i, card in ipairs(cards) do
                for _, t in ipairs(card.texts) do
                    if t:find("cooldown") then return i end
                end
            end
            return nil
        end

        local function voteCard(choice)
            local ok, err = pcall(function()
                local re = game:GetService("ReplicatedStorage")
                    :WaitForChild("Packages", 5):WaitForChild("_Index", 5)
                    :WaitForChild("sleitnick_knit@1.7.0", 5):WaitForChild("knit", 5)
                    :WaitForChild("Services", 5):WaitForChild("CardChoiceService", 5)
                    :WaitForChild("RE", 5):WaitForChild("VoteCard", 5)
                re:FireServer("GohanRift", choice)
            end)
            if ok then print("[CARD] ✅ Voted GohanRift card", choice, "(Cooldown)")
            else warn("[CARD] ❌ Vote failed:", err) end
            return ok
        end

        while true do
            local now = tick()
            local container = getCardContainer()
            if container and (now - lastVoteTime > 5) then
                -- ลองหา Cooldown ก่อน
                local idx = findCooldownIndex(container) or findCooldownIndexByPosition(container)
                if idx then
                    voteCard(idx)
                    lastVoteTime = now
                else
                    warn("[CARD] ⚠️ ไม่เจอ Cooldown ใน card — fallback vote 1")
                    voteCard(1)
                    lastVoteTime = now
                end
            end
            task.wait(0.5)
        end
    end)


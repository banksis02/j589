-- ---------- objective → อ่านง่าย ----------
local function cond(o, name)
    if type(o.Conditions)~="table" then return nil end
    for _, c in ipairs(o.Conditions) do if c.ValueName==name then return c.Value end end
    return nil
end
local function parseObjective(o)
    local t=o.Type
    if t=="Summon" then return { type="Summon", goal=o.Goal or 1, text=("Summon %d"):format(o.Goal or 1) } end
    if t=="ClearWave" then
        local map,diff,wave,gm = cond(o,"MapName"),cond(o,"Difficulty"),cond(o,"Wave"),cond(o,"Gamemode")
        return { type="ClearWave", gamemode=gm, map=map, difficulty=diff, wave=wave, goal=o.Goal or 1,
                 text=("%s %s %s w%s"):format(tostring(gm),tostring(map),tostring(diff),tostring(wave)) }
    end
    if t=="FinishMap" then
        local gm,map,diff,act,ch = cond(o,"Gamemode"),cond(o,"MapName"),cond(o,"Difficulty"),cond(o,"ActName"),cond(o,"ChallengeType")
        local text
        if gm=="Challenge" then text=("Challenge %s x%d"):format(tostring(ch),o.Goal or 1)
        elseif gm=="Raid" then text=("Raid %s %s"):format(tostring(map),tostring(act))
        else text=("%s %s %s"):format(tostring(gm),tostring(map),tostring(diff)) end
        return { type="FinishMap", gamemode=gm, map=map, difficulty=diff, actName=act, challengeType=ch, goal=o.Goal or 1, text=text }
    end
    return { type=tostring(t), goal=o.Goal or 1, text=tostring(t) }
end

local function readBoard()
    ensureQuests()   -- ⭐ v9.62: กัน QUESTS ว่าง (config ยังไม่โหลด) → objective[0]
    local d = pdata()
    local bb = d and d.QuestData and d.QuestData.BountyBoard
    if type(bb)~="table" or type(bb.QuestOrder)~="table" then return nil,"อ่าน BountyBoard ไม่ได้" end
    local list={}
    for _, id in ipairs(bb.QuestOrder) do
        local def = QUESTS[id]
        local live = bb.Quests and bb.Quests[id]
        local e = { id=id, rarity=rarityOfId(id), rank=rankOfId(id),
                    displayName=def and def.DisplayName or id,
                    reward=def and def.Rewards and def.Rewards[1],
                    completed=live and live.Completed or false,
                    claimed=live and live.Claimed or false, objectives={} }
        if def and type(def.Objectives)=="table" then
            local ok={}; for k in pairs(def.Objectives) do ok[#ok+1]=k end; table.sort(ok)
            for _, k in ipairs(ok) do
                local po=parseObjective(def.Objectives[k])
                po.cur=(live and live.ObjectiveProgress and tonumber(live.ObjectiveProgress[k])) or 0
                po.done=po.cur>=(po.goal or 1)
                e.objectives[#e.objectives+1]=po
            end
        end
        list[#list+1]=e
    end
    return list, bb
end

function _G.AE_BOUNTY_REROLL(id)
    if gold()<REROLL_COST then L("💰 Gold ไม่พอ ("..gold().."/"..REROLL_COST..")"); return false end
    L("🎲 reroll "..tostring(id))
    return fireNode("BOUNTY_BOARD_REROLL_QUEST", id, false)
end

function _G.AE_BOUNTY_REROLL_SUB()
    _G.AE_BOUNTY_REROLL_BUSY = true
    task.spawn(function()
        local function body()
            local guard=0
            while guard<30 do guard=guard+1
                local board=readBoard(); if not board then L("อ่าน board ไม่ได้"); return end
                local target
                for _, b in ipairs(board) do if b.rank<DO_THRESHOLD and not b.claimed and not b.completed then target=b; break end end
                if not target then L(("✅ ครบเกณฑ์ %d★ แล้ว"):format(DO_THRESHOLD)); return end
                if gold()<REROLL_COST then L("💰 Gold หมด — หยุด reroll"); return end
                -- ⭐ v9.55: gold ลด = reroll สำเร็จ | gold ไม่ลด = ครบโควต้า reroll วันนี้ (10/วัน) → หยุด
                local g0 = gold()
                _G.AE_BOUNTY_REROLL(target.id)
                task.wait(1.3)   -- รอ server ประมวลผล + gold/board อัปเดต
                if gold() >= g0 then L("🚫 reroll ไม่ได้ (gold ไม่ลด = ครบโควต้าวันนี้/บล็อก) — หยุด"); return end
                task.wait(0.3)
            end
            L("⚠️ reroll ครบ 30 รอบ — หยุดกันลูป")
        end
        pcall(body)
        _G.AE_BOUNTY_REROLL_BUSY = false
    end)
end

function _G.AE_BOUNTY_SCAN()
    local board, err = readBoard()
    if not board then L("❌ "..tostring(err)); return nil end
    logBuf = {}
    L("== BOARD ("..#board..") | Gold "..gold().." | reroll "..REROLL_COST.." ==")
    for i, b in ipairs(board) do
        local v = b.claimed and "เคลมแล้ว" or b.completed and "✅เสร็จ→เคลม" or (b.rank>=DO_THRESHOLD and "▶ทำ" or "🎲reroll")
        L(("%d) %s [★%d] +%s → %s"):format(i, b.id, b.rank, b.reward and tostring(b.reward.Amount) or "?", v))
        for _, o in ipairs(b.objectives) do L(("   • %s (%d/%d)%s"):format(o.text,o.cur,o.goal,o.done and "✓" or "")) end
    end
    if CLIP then pcall(CLIP, table.concat(logBuf,"\n")) end
    notify("🎯 Bounty", "SCAN เสร็จ — "..#board.." อัน (ดูใน UI/clipboard)", 4)
    return board
end


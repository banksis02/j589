local function has(name) return type(_G[name]) == "function" end
local function call(name, ...)
    if not has(name) then L("⚠️ ไม่เจอฟังก์ชัน " .. name); return nil end
    local r = table.pack(pcall(_G[name], ...))
    if not r[1] then L("❌ " .. name .. " error: " .. tostring(r[2])); return nil end
    return table.unpack(r, 2, r.n)
end

local running = false

local function restartGame()
    print("[Exp] 🔄 Restart หาแมพใหม่ (Back → Restart → Expedition Map)...")
    -- 1) ⭐ ต้องปิดหน้าแผนที่ให้สนิทก่อน ไม่งั้น Restart ไม่ทำงาน
    --    (เครื่องแลค/UI ช้า → กด Back ครั้งเดียวอาจไม่ปิด) → ยืนยันจนปิดจริง
    for attempt = 1, 4 do
        if not inNodeSelect() then break end
        if clickByText("Back", 3) then print(("[Exp]   ← กด Back (รอบ %d)"):format(attempt)) end
        local t0 = tick()
        while inNodeSelect() and tick() - t0 < 3 do task.wait(0.3) end
    end
    if inNodeSelect() then
        warn("[Exp] ⚠️ ปิดหน้าแผนที่ไม่ได้ — Restart อาจไม่ทำงาน")
    else
        print("[Exp]   ✅ ปิดหน้าแผนที่แล้ว")
    end
    task.wait(1)

    -- 2) ⭐ ยิง Restart remote → รอ → เปิดแผนที่ใหม่ (reroll ใช้ได้จริง ยืนยันแล้ว)
    --    ไม่เช็ค "ลายแมพ" แล้ว (v8.7 เช็คผิด → false negative → วน retry 40 วิ/ครั้ง)
    fireRestartRemote()
    task.wait(4)
    print("[Exp]   → กด Expedition Map เข้าหน้าเลือก node ใหม่")
    if reopenMapView() then
        print("[Exp] ✅ Restart แล้ว — เข้าหน้าเลือก node")
        return true
    end

    print("[Exp]   ⚠️ remote ไม่ได้ผล → ลองคลิก UI แทน")
    -- 2) เปิด Settings
    local topbar = player.PlayerGui:FindFirstChild("TopBar")
    if topbar then
        local btns={}
        for _,b in ipairs(topbar:GetDescendants()) do if b:IsA("TextButton") and b.Visible then table.insert(btns,b) end end
        table.sort(btns, function(a,b) return a.AbsolutePosition.X>b.AbsolutePosition.X end)
        for _,b in ipairs(btns) do
            fireBtn(b); task.wait(1)
            if player.PlayerGui:FindFirstChild("Settings") and player.PlayerGui.Settings:FindFirstChild("Frame") then break end
            fireBtn(b); task.wait(0.3)
        end
    end
    task.wait(1)
    local s = player.PlayerGui:FindFirstChild("Settings")
    if not s then warn("[Exp] เปิด Settings ไม่ได้"); return false end
    -- แท็บ Gameplay
    for _,b in ipairs(s:GetDescendants()) do
        if b:IsA("TextButton") and b.Visible then
            local hit = (b.Text=="Gameplay")
            if not hit then for _,l in ipairs(b:GetDescendants()) do if l:IsA("TextLabel") and l.Text=="Gameplay" then hit=true break end end end
            if hit then fireBtn(b); task.wait(0.6); break end
        end
    end
    -- กด Restart Game (label-anchored เหมือน Back To Lobby)
    local label
    for _,l in ipairs(s:GetDescendants()) do
        if l:IsA("TextLabel") and l.Visible and l.Text=="Restart Game" then label=l; break end
    end
    if label then
        local lx,ly=label.AbsolutePosition.X, label.AbsolutePosition.Y
        local best,bd
        for _,b in ipairs(s:GetDescendants()) do
            if b:IsA("TextButton") and b.Visible and b.AbsoluteSize.X<=40
               and math.abs(b.AbsolutePosition.Y-ly)<20 then
                local dx=b.AbsolutePosition.X-lx
                if dx>0 and (not bd or dx<bd) then best,bd=b,dx end
            end
        end
        if best then fireBtn(best); task.wait(1.5) end
    end
    -- confirm "Restart" — ⚠️ ปุ่มพวกนี้ Activated:Fire() ปิดกล่องได้แต่ "ไม่ทำงานจริง"
    --    ต้องยิงทั้ง MouseButton1Click + Activated แล้วตามด้วย VIM คลิกพิกัดจริง
    local function findRestartBtn()
        local prompt = player.PlayerGui:FindFirstChild("Prompt")
        if not prompt then return nil end
        for _,b in ipairs(prompt:GetDescendants()) do
            if b:IsA("GuiButton") and b.Visible then
                for _,l in ipairs(b:GetDescendants()) do
                    if l:IsA("TextLabel") and l.Visible and l.Text=="Restart" then return b end
                end
            end
        end
        return nil
    end

    local confirmed = false
    for attempt=1,4 do
        -- รอกล่องเด้ง
        local btn
        local t0 = tick()
        while tick()-t0 < 4 do
            btn = findRestartBtn()
            if btn then break end
            task.wait(0.4)
        end
        if not btn then
            if attempt == 1 then warn("[Exp] ⚠️ กล่องยืนยันยังไม่เด้ง") end
            break
        end

        task.wait(0.4)   -- รอกล่องเด้งเต็มก่อนกด
        -- 1) ยิงทั้งสอง event
        pcall(function() for _,c in ipairs(getconnections(btn.MouseButton1Click)) do c:Fire() end end)
        pcall(function() for _,c in ipairs(getconnections(btn.Activated)) do c:Fire() end end)
        task.wait(1)
        -- 2) VIM คลิกพิกัดกลางปุ่ม (วิธีที่ทำงานจริงกับ Return to Lobby)
        local b2 = findRestartBtn() or btn
        pcall(function()
            local cx = b2.AbsolutePosition.X + b2.AbsoluteSize.X/2
            local cy = b2.AbsolutePosition.Y + b2.AbsoluteSize.Y/2 + inset_exp.Y
            VIM_EXP:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
            task.wait(0.06)
            VIM_EXP:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
        end)
        task.wait(2.5)

        -- เช็คว่ารีจริง: กล่องหาย + กลับหน้าแรก Expedition (มีปุ่ม Expedition Map)
        if not findRestartBtn() then
            confirmed = true
            print("[Exp] ✅ กด Restart แล้ว (รอบ " .. attempt .. ")")
            break
        end
        print("[Exp] ⚠️ กล่องยังค้าง → ลองใหม่ (รอบ " .. attempt .. ")")
    end
    if not confirmed then warn("[Exp] ❌ กดยืนยัน Restart ไม่สำเร็จ"); return false end

    -- 3) รอเกม restart + สุ่ม map ใหม่ แล้วกด Expedition Map เข้าหน้าเลือก node ใหม่
    task.wait(5)
    print("[Exp]   → กด Expedition Map เข้าหน้าเลือก node ใหม่")
    for attempt=1,8 do
        if inNodeSelect() then break end
        clickByText("Expedition Map", 3)
        task.wait(2)
    end
    if inNodeSelect() then
        print("[Exp] ✅ เข้าหน้า node select แล้ว (map ใหม่)")
        return true
    end
    warn("[Exp] ⚠️ กด Expedition Map แล้วยังไม่เข้าหน้า node select")
    return false
end


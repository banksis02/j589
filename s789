    -- ⭐ v7.8: เปิดหน้าคราฟแบบทน — ลองซ้ำ + วาปไปยืนที่โซนคราฟถ้ายังไม่ติด
    --    (หลัง ANTI-AFK reset ตัวละครเพิ่งเกิดใหม่/อยู่ไกล → fireproximityprompt ไม่ติด)
    local function openCraftUI()
        if craftUIOpen() then return true end
        local zone
        pcall(function() zone = workspace.InteractZones.Crafting end)
        if not zone then return false end
        local prompt = zone:FindFirstChildWhichIsA("ProximityPrompt", true)
        if not prompt then return false end

        for attempt = 1, 3 do
            pcall(fireproximityprompt, prompt)
            task.wait(1.5)
            if craftUIOpen() then return true end

            -- ยังไม่ติด → วาปไปยืนที่โซนคราฟแล้วลองใหม่
            local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            local part = zone:IsA("BasePart") and zone or zone:FindFirstChildWhichIsA("BasePart")
            if hrp and part then
                print("[AE Craft] 🚀 วาปไปโซนคราฟแล้วลองใหม่ (รอบ " .. attempt .. ")")
                pcall(function() hrp.CFrame = part.CFrame + Vector3.new(0, 3, 0) end)
                task.wait(1)
                pcall(fireproximityprompt, prompt)
                task.wait(1.5)
                if craftUIOpen() then return true end
            end
            task.wait(1)
        end
        return craftUIOpen()
    end

    -- ⭐ v7.8: ปิดหน้าคราฟแบบไม่กดมั่ว
    --    เดิมไล่กดปุ่มเล็กทุกปุ่ม → ไปโดนปุ่ม filter เปิดกล่อง "Filter Settings" ค้างบังจอ
    local function closeCraftUI()
        local root = craftGuiRoot()
        if not root or not craftUIOpen() then return true end
        -- ⭐ กดเฉพาะปุ่มปิดมุมขวาบนของกรอบ (ปุ่มเล็ก + อยู่ขวาสุด/บนสุด)
        --    ห้ามใช้ Escape (เปิดเมนูเกม) และห้ามไล่กดทุกปุ่ม (ไปโดน filter)
        local best, bestScore
        for _, btn in ipairs(root:GetDescendants()) do
            if btn:IsA("TextButton") and btn.Visible
               and btn.AbsoluteSize.X <= 40 and btn.AbsoluteSize.Y <= 40 then
                local score = btn.AbsolutePosition.X - btn.AbsolutePosition.Y
                if not bestScore or score > bestScore then best, bestScore = btn, score end
            end
        end
        if best then
            fireButtonConns(best)
            task.wait(1)
        end
        return not craftUIOpen()
    end

    -- เช็คหน้าคราฟยังเปิดอยู่ไหม — ถ้าปิด (เกมปิดเองหลังคราฟ) ให้เปิดใหม่
    local function ensureCraftOpen()
        if craftUIOpen() then return true end
        print("[AE Craft] 🚪 หน้าคราฟปิด → เปิดใหม่")
        return openCraftUI()
    end

    -- ⭐ อ่าน Grey แบบ retry — กัน UI ยัง refresh ไม่เสร็จ (คืน 0 ปลอม)
    local function readGreyRetry(colorName)
        for i = 1, 4 do
            local g = getGreyCount()
            if g > 0 then return g end
            -- อ่านได้ 0 — อาจเพราะ UI ปิด/ไม่มีสีถูกเลือก → ซ่อม
            if not craftUIOpen() then
                openCraftUI()
                task.wait(1)
            end
            if colorName then
                clickCraftButton(colorName)
            end
            task.wait(0.8)
        end
        return getGreyCount()
    end

    -- ⭐ v8.3: แหล่งความจริงเดียว = กระเป๋า Items (ตัวเดียวกับที่ใช้ตัดสินใจออกจากด่าน)
    --    หน้าคราฟมีตัวเลขปนกันหลายชุด → ใช้เป็นตัวสำรองเท่านั้น
    local function greyTrue()
        if _G.AE_READ_ITEM then
            local n = _G.AE_READ_ITEM("Sprite (Grey)")
            if n and n > 0 then return n, "กระเป๋า" end
        end
        return getGreyCount(), "หน้าคราฟ"
    end

    local function craftOne(colorName, expectedCost, knownGrey)
        if not ensureCraftOpen() then return false end
        if not clickCraftButton(colorName) then return false end
        task.wait(1)
        local before = knownGrey or readGreyRetry(colorName)
        if before < expectedCost then
            print("[AE Craft] ⛔ " .. colorName .. " — Grey ไม่พอ (" .. before .. "/" .. expectedCost .. ")")
            return false
        end
        -- ⭐ กด Craft — ลองสูงสุด 2 ครั้ง (เผื่อ rate limit / UI ไม่พร้อม)
        for attempt = 1, 2 do
            if not clickCraftButton("craft ", true) then
                warn("[AE Craft] ❌ กดปุ่ม Craft ไม่ได้ (ครั้ง " .. attempt .. ")")
                task.wait(1)
            else
                task.wait(2)
                -- เกมอาจปิดหน้าคราฟหลังคราฟ → เปิดใหม่ + เลือกสีเดิม
                if not craftUIOpen() then
                    openCraftUI()
                    task.wait(1)
                end
                clickCraftButton(colorName)
                task.wait(1)
                local after = readGreyRetry(colorName)
                if after < before then
                    print("[AE Craft] ✅ " .. colorName .. " | Grey: " .. before .. " → " .. after)
                    greyKnown = after
                    return true
                end
                -- ⭐ v8.3: หน้าคราฟอ่านไม่ได้ (0) → ไม่ถือว่าล้มเหลว ให้ตัวนับข้างนอกคุมแทน
                if after <= 0 then
                    print("[AE Craft] ✅ " .. colorName .. " (หน้าคราฟอ่านค่าไม่ได้ — นับจากตัวนับแทน)")
                    greyKnown = math.max(before - expectedCost, 0)
                    return true
                end
                print("[AE Craft] ⚠️ " .. colorName .. " Grey ไม่ลด (" .. before .. "→" .. after .. ") ครั้ง " .. attempt)
            end
        end
        return false
    end

    -- ⭐ เปิดหน้าคราฟ เช็ค Grey → ถ้าเต็ม 125 คราฟ (Rainbow 1 + สุ่มสี) → ปิด
    local autoCraftInner
    local function autoCraftIfFull()
        if not uiAcquire("คราฟ", 90) then return end
        closeStrayDialogs()
        local ok, err = pcall(autoCraftInner)
        closeStrayDialogs()          -- กันกล่อง filter ค้างไปรบกวนการเข้าด่าน
        uiRelease()
        if not ok then warn("[AE Craft] ❌ error: " .. tostring(err)) end
    end

    autoCraftInner = function()
        -- ⭐ v9.18: เปิดหน้าคราฟ → อ่าน Grey จากหน้าคราฟ → คราฟให้หมด (ไม่ต้องเช็ค 125)
        --    เรียกตอนล็อบบี้ = คราฟทุกครั้ง (มีเท่าไหร่คราฟให้หมด) ไม่รีบปิด รอโหลดได้
        print("[AE Craft] 🚪 เปิดหน้าคราฟ...")
        if not openCraftUI() then
            warn("[AE Craft] ❌ เปิดหน้าคราฟไม่ได้")
            return
        end
        task.wait(1.5)   -- รอหน้าคราฟโหลดเต็ม (เครื่องช้า)
        clickCraftButton(CRAFT_COLORS[1])
        task.wait(1)

        local grey = readGreyRetry(CRAFT_COLORS[1])
        print("[AE Craft] 🔍 Grey จากหน้าคราฟ: " .. grey .. "/" .. CRAFT_GREY_FULL)
        greyKnown = grey
        greyKnownSynced = true

        if grey < CRAFT_NORMAL_COST then
            print("[AE Craft] ℹ️ Grey น้อยเกินคราฟ (" .. grey .. ") — ข้าม")
        else
            -- คราฟ Rainbow ถ้าพอ (30) แล้วคราฟสีจนหมด
            if grey >= CRAFT_RAINBOW_COST then
                print("[AE Craft] 🌈 Rainbow 1 ลูก...")
                craftOne("Sprite (Rainbow)", CRAFT_RAINBOW_COST)
            end
            local fullColors = {}
            local greyLeft, crafted = greyKnown, 0
            while true do
                if not ensureCraftOpen() then
                    warn("[AE Craft] ❌ เปิดหน้าคราฟกลับไม่ได้ — หยุดคราฟ")
                    break
                end
                local avail = {}
                for _, c in ipairs(CRAFT_COLORS) do
                    if not fullColors[c] then table.insert(avail, c) end
                end
                if #avail == 0 then
                    print("[AE Craft] ⛔ ทุกสีเต็ม/คราฟไม่ได้แล้ว — จบ")
                    break
                end
                local color = avail[math.random(#avail)]
                -- ⭐ v8.3: ใช้ตัวนับที่ sync มาจากกระเป๋า แล้วหักทีละ 5 ต่อการคราฟ
                --    (ทุก 5 ครั้ง sync ค่าจริงจากกระเป๋าอีกที กัน counter เพี้ยน)
                if crafted > 0 and crafted % 5 == 0 then
                    local real = greyTrue()
                    if real > 0 then
                        print("[AE Craft] 🔄 sync Grey จากกระเป๋า: " .. greyLeft .. " → " .. real)
                        greyLeft = real
                        ensureCraftOpen()
                    end
                end
                if greyLeft < CRAFT_NORMAL_COST then
                    local real = greyTrue()
                    if real >= CRAFT_NORMAL_COST then
                        greyLeft = real
                        ensureCraftOpen()
                    else
                        print("[AE Craft] ⛔ Grey เหลือ " .. real .. " — จบ")
                        break
                    end
                end
                if craftOne(color, CRAFT_NORMAL_COST, greyLeft) then
                    crafted = crafted + 1
                    greyLeft = math.max(greyLeft - CRAFT_NORMAL_COST, 0)
                    print(("[AE Craft] 🧪 คราฟ %s สำเร็จ (#%d) | Grey เหลือ ~%d")
                        :format(color, crafted, greyLeft))
                else
                    fullColors[color] = true
                    print("[AE Craft] 🚫 ข้าม " .. color .. " ถาวร (เต็ม/คราฟไม่ได้)")
                end
                task.wait(1)
            end
            -- อ่าน Grey สุดท้ายจากกระเป๋า (แหล่งจริง)
            closeCraftUI()
            task.wait(0.5)
            local finalGrey = greyTrue()
            greyKnown = (finalGrey > 0) and finalGrey or greyLeft
            print(("[AE Craft] จบคราฟ | คราฟไป %d ลูก | Grey เหลือ: %d"):format(crafted, greyKnown))
        end
        closeCraftUI()
    end

    -- ============================================================
    -- [AE] อ่านจำนวนไอเทมจริงจาก Items Inventory (กด J — เปิดได้ทั้ง lobby และในด่าน)
    -- ============================================================
    local function itemInvOpen()
        local inv = player.PlayerGui:FindFirstChild("ItemInventory")
        return inv and inv:FindFirstChild("Frame") ~= nil
    end

    local function toggleItemInv()
        -- วิธี 1: กดคีย์ J
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.J, false, game)
            task.wait(0.1)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.J, false, game)
        end)
        task.wait(1.2)
    end

    -- อ่านจำนวนไอเทมตามชื่อ (เช่น "Sprite (Grey)") — คืน number หรือ nil
    local function readItemCount(itemName)
        local inv = player.PlayerGui:FindFirstChild("ItemInventory")
        if not inv then return nil end
        local wasOpen = itemInvOpen()
        if not wasOpen then
            toggleItemInv()
            if not itemInvOpen() then
                -- fallback: กดปุ่ม Items ใน HUD (getconnections)
                for _, gui in ipairs({ "LeftHUD", "BottomHUD" }) do
                    local root = player.PlayerGui:FindFirstChild(gui)
                    if root then
                        for _, btn in ipairs(root:GetDescendants()) do
                            if btn:IsA("TextButton") and btn.Visible then
                                for _, l in ipairs(btn:GetDescendants()) do
                                    if l:IsA("TextLabel") and l.Text == "Items" then
                                        fireButtonConns(btn)
                                        task.wait(1.2)
                                        break
                                    end
                                end
                            end
                            if itemInvOpen() then break end
                        end
                    end
                    if itemInvOpen() then break end
                end
            end
        end
        if not itemInvOpen() then return nil end

        -- ⭐ v9.17: อ่านจำนวนแบบทน — รับทั้ง "Nx", "N / M", "Nx / Mx Owned"
        local function clean(s) return (tostring(s):gsub("<[^>]->", "")) end
        local function parseQty(t)
            t = clean(t)
            -- แบบ "25 / 125" หรือ "25x / 125x Owned" → เอาตัวหน้า
            local a = t:match("([%d,]+)%s*x?%s*/%s*[%d,]+")
            if a then return tonumber((a:gsub(",", ""))) end
            -- แบบ "25x"
            local b = t:match("^([%d,]+)%s*x$")
            if b then return tonumber((b:gsub(",", ""))) end
            return nil
        end

        local result = nil
        -- 1) จากพาเนลรายละเอียด: หา label "Owned" (เช่น "25x / 125x Owned")
        for _, lbl in ipairs(inv:GetDescendants()) do
            if lbl:IsA("TextLabel") and lbl.Visible then
                local t = clean(lbl.Text)
                if t:find("/", 1, true) and (t:lower():find("owned") or t:match("^[%d,]+%s*x?%s*/%s*[%d,]+")) then
                    -- ต้องมั่นใจว่าเป็นของ item นี้ (มี label ชื่อ item อยู่ใน gui เดียวกัน)
                    local q = parseQty(t)
                    -- เช็คว่ามีชื่อ item อยู่ใกล้ๆ (พาเนลเดียวกัน)
                    local anc = lbl.Parent
                    local hasName = false
                    for _ = 1, 5 do
                        if not anc then break end
                        for _, x in ipairs(anc:GetDescendants()) do
                            if x:IsA("TextLabel") and clean(x.Text):find(itemName, 1, true) then hasName = true; break end
                        end
                        if hasName then break end
                        anc = anc.Parent
                    end
                    if q and hasName then result = q; break end
                end
            end
        end
        -- 2) fallback: จาก card ในกริด (badge "Nx" ใกล้ชื่อ item)
        if not result then
            for _, lbl in ipairs(inv:GetDescendants()) do
                if lbl:IsA("TextLabel") and clean(lbl.Text):find(itemName, 1, true) then
                    local card = lbl.Parent
                    for depth = 1, 4 do
                        if not card then break end
                        for _, q in ipairs(card:GetDescendants()) do
                            if q:IsA("TextLabel") and q ~= lbl then
                                local n = parseQty(q.Text)
                                if n then result = n; break end
                            end
                        end
                        if result then break end
                        card = card.Parent
                    end
                    if result then break end
                end
            end
        end
        -- ⭐ ปิดกลับถ้าเดิมปิดอยู่ — ยืนยันปิดจริง (คอมช้า กด J ครั้งเดียวอาจไม่ปิด)
        if not wasOpen then
            for _ = 1, 3 do
                if not itemInvOpen() then break end
                toggleItemInv()
            end
        end
        return result
    end
    _G.AE_READ_ITEM = readItemCount

    -- ============================================================
    -- [AE] Back to Lobby (Settings → Back To Lobby → Return to Lobby)
    -- ============================================================
    local function clickExactInGui(guiName, text)
        local root = player.PlayerGui:FindFirstChild(guiName)
        if not root then return false end
        local lowerTarget = string.lower(text)
        for _, btn in ipairs(root:GetDescendants()) do
            if (btn:IsA("TextButton") or btn:IsA("ImageButton")) and btn.Visible then
                if btn:IsA("TextButton") and btn.Text:lower() == lowerTarget then
                    return fireButtonConns(btn) > 0
                end
                for _, l in ipairs(btn:GetDescendants()) do
                    if l:IsA("TextLabel") and l.Visible and l.Text:lower() == lowerTarget then
                        return fireButtonConns(btn) > 0
                    end
                end
            end
        end
        return false
    end

    local function settingsOpen()
        local s = player.PlayerGui:FindFirstChild("Settings")
        return s and s:FindFirstChild("Frame") ~= nil and #s.Frame:GetChildren() > 1
    end

    -- ⭐ กด Cancel ในกล่อง Exit Confirmation — ใช้เฉพาะตอน openSettings เผลอกดโดนปุ่ม Exit
    --    v9.15: เอา "ตัวเฝ้าตลอดเวลา" ออกแล้ว (มันไปกด Cancel ตัดการกลับล็อบบี้ที่เราตั้งใจ)
    --    เรียกเฉพาะจาก openSettings เท่านั้น (ตอนนั้นเราไม่ได้ตั้งใจออกด่าน)
    local function dismissExitConfirm()
        for _, g in ipairs(player.PlayerGui:GetChildren()) do
            if g:IsA("ScreenGui") and g.Enabled then
                local isExit = false
                for _, l in ipairs(g:GetDescendants()) do
                    if l:IsA("TextLabel") and l.Visible then
                        local t = tostring(l.Text)
                        if t == "Exit Confirmation" or t:find("like to exit this game", 1, true) then
                            isExit = true; break
                        end
                    end
                end
                if isExit then
                    for _, b in ipairs(g:GetDescendants()) do
                        if b:IsA("GuiButton") and b.Visible then
                            local hit = (b:IsA("TextButton") and b.Text == "Cancel")
                            if not hit then
                                for _, l in ipairs(b:GetDescendants()) do
                                    if l:IsA("TextLabel") and l.Visible and l.Text == "Cancel" then hit = true; break end
                                end
                            end
                            if hit then
                                fireButtonConns(b)
                                pcall(function()
                                    local inset = game:GetService("GuiService"):GetGuiInset()
                                    local cx = b.AbsolutePosition.X + b.AbsoluteSize.X/2
                                    local cy = b.AbsolutePosition.Y + b.AbsoluteSize.Y/2 + inset.Y
                                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
                                    task.wait(0.05)
                                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
                                end)
                                print("[AE] ✖️ ปิดกล่อง Exit Confirmation (กด Cancel)")
                                task.wait(0.4)
                                return true
                            end
                        end
                    end
                end
            end
        end
        return false
    end
    _G.AE_DISMISS_EXIT = dismissExitConfirm

    -- ⭐ เฟือง Settings = ปุ่มที่ "เปิดหน้า Settings ได้จริง" เท่านั้น
    --    เกมเพิ่มปุ่ม Exit ขวาสุด → ต้องจำว่าปุ่มไหนคือ Exit แล้วไม่กดอีก (blacklist)
    local cachedSettingsBtn = nil
    local exitBtnBlacklist = {}   -- ปุ่มที่กดแล้วเด้ง Exit Confirmation → ห้ามกดอีก

    -- เดาปุ่ม Exit จากไอคอน/ชื่อ (กันไว้ก่อนตั้งแต่ยังไม่เคยกด)
    local function looksLikeExitBtn(btn)
        local n = tostring(btn.Name):lower()
        if n:find("exit") or n:find("leave") or n:find("quit") or n:find("door") then return true end
        for _, d in ipairs(btn:GetDescendants()) do
            if d:IsA("TextLabel") and d.Visible then
                local t = tostring(d.Text):lower()
                if t == "exit" or t == "leave" then return true end
            end
            local dn = tostring(d.Name):lower()
            if dn:find("exit") or dn:find("leave") or dn:find("door") then return true end
        end
        return false
    end

    local function openSettings()
        if settingsOpen() then return true end
        -- ใช้ปุ่มที่จำไว้ก่อน (เจอครั้งแรกแล้วจำ — ไม่ต้องไล่กดใหม่)
        if cachedSettingsBtn and cachedSettingsBtn.Parent then
            fireButtonConns(cachedSettingsBtn)
            task.wait(1.5)
            if settingsOpen() then return true end
            dismissExitConfirm()   -- เผื่อปุ่มที่จำไว้เปลี่ยนไปเป็น Exit
        end
        local topbar = player.PlayerGui:FindFirstChild("TopBar")
        if not topbar then return false end

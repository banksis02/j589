            end
        end)
        if fired == 0 then
            pcall(function()
                for _, conn in ipairs(getconnections(btn.Activated)) do
                    conn:Fire(); fired = fired + 1
                end
            end)
        end
        return fired
    end

    local function clickExact(name)
        local root = player.PlayerGui:FindFirstChild("Play") or player.PlayerGui
        local lowerTarget = string.lower(name)
        -- เช็ค text ของปุ่มเอง
        for _, btn in ipairs(root:GetDescendants()) do
            if (btn:IsA("TextButton") or btn:IsA("ImageButton")) and btn.Visible then
                if btn:IsA("TextButton") and btn.Text:lower() == lowerTarget then
                    local n = fireButtonConns(btn)
                    print("[AE Enter] '" .. name .. "' → fired=" .. n)
                    return n > 0
                end
            end
        end
        -- เช็ค label ในปุ่ม
        for _, lbl in ipairs(root:GetDescendants()) do
            if lbl:IsA("TextLabel") and lbl.Visible and lbl.Text:lower() == lowerTarget then
                local p = lbl.Parent
                while p and p ~= root do
                    if p:IsA("TextButton") or p:IsA("ImageButton") then
                        local n = fireButtonConns(p)
                        print("[AE Enter] '" .. name .. "' (label) → fired=" .. n)
                        return n > 0
                    end
                    p = p.Parent
                end
            end
        end
        warn("[AE Enter] ❌ ไม่เจอ '" .. name .. "'")
        return false
    end

    -- ⭐ คลิก "ชื่อด่าน" แบบทนทาน — ชื่อบางด่านมี apostrophe (King's Tomb)
    --    ซึ่งในเกมอาจเป็นอักขระคนละตัว (' vs ' vs `) → exact match พลาด
    --    วิธี: ตัดอักขระที่ไม่ใช่ a-z0-9 ออกทั้งสองฝั่งแล้วเทียบ
    local function normName(s)
        return (tostring(s):lower():gsub("[^%w]", ""))
    end
    -- หา label ด่าน (normalize) แล้วคลิกปุ่มแม่ — คืน true ถ้าคลิกได้
    local function tryClickStageLabel(stageName)
        local target = normName(stageName)
        local root = player.PlayerGui:FindFirstChild("Play") or player.PlayerGui
        for _, lbl in ipairs(root:GetDescendants()) do
            if lbl:IsA("TextLabel") and lbl.Visible and lbl.Text ~= "" then
                local t = normName(lbl.Text)
                if t == target or (#target >= 5 and t:sub(1, #target) == target) then
                    local p = lbl.Parent
                    while p and p ~= root do
                        if p:IsA("TextButton") or p:IsA("ImageButton") then
                            local n = fireButtonConns(p)
                            print("[AE Enter] '" .. stageName .. "' (เจอ: '" .. lbl.Text .. "') → fired=" .. n)
                            return n > 0
                        end
                        p = p.Parent
                    end
                end
            end
        end
        return false
    end

    -- ⭐ ด่านท้ายๆ (King's Tomb) อยู่นอกจอ — การ์ดยังไม่ถูกสร้างจนกว่าจะเลื่อน scroll
    --    วิธี: เลื่อน ScrollingFrame แนวนอนทีละขั้น แล้วหาซ้ำทุกขั้น
    local function clickStageName(stageName)
        if clickExact(stageName) then return true end
        if tryClickStageLabel(stageName) then return true end

        -- หา ScrollingFrame แนวนอนที่กว้างกว่าจอ (แถบเลือกด่าน)
        local root = player.PlayerGui:FindFirstChild("Play")
        local sf
        if root then
            for _, f in ipairs(root:GetDescendants()) do
                if f:IsA("ScrollingFrame") and f.Visible
                   and f.AbsoluteCanvasSize.X > f.AbsoluteSize.X + 50 then
                    if not sf or f.AbsoluteSize.X > sf.AbsoluteSize.X then sf = f end
                end
            end
        end
        if not sf then
            warn("[AE Enter] ❌ ไม่เจอด่าน '" .. stageName .. "' และไม่เจอแถบเลื่อน")
            return false
        end

        print("[AE Enter] 🔄 เลื่อนหาด่าน '" .. stageName .. "'...")
        local maxX = math.max(0, sf.AbsoluteCanvasSize.X - sf.AbsoluteSize.X)
        local step = math.max(200, sf.AbsoluteSize.X * 0.6)
        local x = 0
        while x <= maxX + step do
            pcall(function() sf.CanvasPosition = Vector2.new(math.min(x, maxX), sf.CanvasPosition.Y) end)
            task.wait(0.35)
            if tryClickStageLabel(stageName) then return true end
            if x >= maxX then break end
            x = x + step
        end
        warn("[AE Enter] ❌ เลื่อนจนสุดแล้วยังไม่เจอด่าน '" .. stageName .. "'")
        return false
    end

    -- ============================================================
    -- ⭐ v7.8: ล็อกคิวหน้าจอล็อบบี้ — ตั้งค่า / คราฟ / เข้าด่าน ห้ามทำพร้อมกัน
    --    (เดิมตั้งค่าเปิดค้าง แล้วคราฟเปิดทับ → กดโดนกันมั่ว → เข้าด่านไม่ได้)
    -- ============================================================
    local uiBusy, uiBusyWho = false, ""
    local function uiAcquire(who, timeout)
        local t0 = tick()
        while uiBusy and tick() - t0 < (timeout or 60) do
            task.wait(0.5)
        end
        if uiBusy then
            warn(("[AE UI] ⏳ %s รอ %s นานเกินไป — ข้ามรอบนี้"):format(who, uiBusyWho))
            return false
        end
        uiBusy, uiBusyWho = true, who
        return true
    end
    local function uiRelease() uiBusy, uiBusyWho = false, "" end

    -- ⚠️ ห้ามกด Escape เด็ดขาด — ใน Roblox มันเปิด "เมนูเกม" (People/Settings/Leave)
    --    v7.9 เคยใช้ปิดหน้าคราฟ → เมนูเกมเด้ง แล้วคลิกถัดไปไปโดน Invite Friends
    --    ถ้าเมนูเกมเผลอเปิด ให้ปิดด้วยฟังก์ชันนี้เท่านั้น
    local function closeRobloxMenu()
        local gs = game:GetService("GuiService")
        if not gs.MenuIsOpen then return true end
        print("[AE UI] ✖️ เมนูเกม Roblox เปิดค้าง → ปิด")
        local ok = pcall(function() gs:SetMenuIsOpen(false) end)
        task.wait(0.6)
        if not gs.MenuIsOpen then return true end
        if not ok then
            -- ปิดไม่ได้ด้วย API → กด Escape 1 ครั้งเพื่อ toggle ปิด (เมนูเปิดอยู่แล้วเท่านั้น)
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
                task.wait(0.1)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)
            end)
            task.wait(0.8)
        end
        return not gs.MenuIsOpen
    end

    -- ปิดกล่องที่เผลอเปิดค้าง (เช่น Filter Settings) — ไม่งั้นบังจอ กดอะไรไม่ได้เลย
    local function closeStrayDialogs()
        local closed = closeRobloxMenu()   -- เมนูเกมเปิดค้าง = คลิกอะไรไม่โดนเลย
        for _, g in ipairs(player.PlayerGui:GetChildren()) do
            if g:IsA("ScreenGui") and g.Enabled then
                local hasDialog = false
                for _, l in ipairs(g:GetDescendants()) do
                    if l:IsA("TextLabel") and l.Visible then
                        local t = tostring(l.Text)
                        if t == "Filter Settings" or t == "Apply Filter" then hasDialog = true; break end
                    end
                end
                if hasDialog then
                    for _, b in ipairs(g:GetDescendants()) do
                        if b:IsA("TextButton") and b.Visible then
                            local t = tostring(b.Text)
                            local hit = (t == "Cancel")
                            if not hit then
                                for _, l in ipairs(b:GetDescendants()) do
                                    if l:IsA("TextLabel") and l.Visible and l.Text == "Cancel" then hit = true; break end
                                end
                            end
                            if hit then
                                print("[AE UI] ✖️ ปิดกล่อง Filter Settings ที่ค้างอยู่")
                                fireButtonConns(b)
                                closed = true
                                task.wait(0.6)
                                break
                            end

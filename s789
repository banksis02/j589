                            task.wait(0.06)
                            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
                        end)
                    end
                    print("[AE Enter] ✅ กด Start แล้ว — กำลังเข้าด่าน")
                    return true
                end
                print("[AE Enter] ⚠️ อยู่หน้าปาร์ตี้แต่ไม่เจอปุ่ม Start → ออกด้วย Back แล้วเริ่มใหม่")

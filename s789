-- ---------- 4) ปรับความยาก ----------
local function readDifficulty()
    for _, g in ipairs(player.PlayerGui:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled then
            for _, l in ipairs(g:GetDescendants()) do
                if (l:IsA("TextLabel") or l:IsA("TextButton")) and l.Visible then
                    local n = txt(l):match("Difficulty%s*(%d+)")
                    if n then return tonumber(n), l end
                end
            end
        end
    end
    return nil
end

_G.AE_ENTER_DIFF = function(target)
    target = target or DEFAULT_DIFF
    local cur, label = readDifficulty()
    if not cur then warn("[Enter] ❌ ไม่เจอช่อง Difficulty"); return false end
    print(("[Enter] ⚙️ ความยากตอนนี้ %d → ต้องการ %d"):format(cur, target))

    -- หาปุ่มลูกศร ซ้าย/ขวา ที่อยู่แถวเดียวกับป้าย Difficulty
    local holder = label.Parent
    for _ = 1, 3 do
        if holder and holder.Parent and holder.Parent:IsA("GuiObject") then holder = holder.Parent end
    end
    local arrows = {}
    for _, b in ipairs(holder:GetDescendants()) do
        if b:IsA("GuiButton") and b.Visible and b.AbsoluteSize.X > 3 then
            table.insert(arrows, b)
        end
    end
    table.sort(arrows, function(a, b) return a.AbsolutePosition.X < b.AbsolutePosition.X end)
    if #arrows < 2 then warn("[Enter] ❌ ไม่เจอปุ่มลูกศรความยาก"); return false end
    local left, right = arrows[1], arrows[#arrows]

    for _ = 1, 6 do
        cur = readDifficulty()
        if not cur or cur == target then break end
        clickHard(cur < target and right or left)
        task.wait(0.5)
    end
    cur = readDifficulty()
    print(("[Enter] ⚙️ ความยากตอนนี้ = %s"):format(tostring(cur)))
    return cur == target
end


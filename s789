-- 🏷️ ประเภทตัวละคร (ใช้ตัดสินว่าวางจุดไหนได้)
--    farm  = ตัวหาเงิน ตีไม่ได้ (Ramen Guy) → ห้ามยืนเดี่ยวจุด 1 มอนทะลุ
--    long  = ระยะไกลมาก (Elf Mage) → วางจุดไหนก็ครอบทั้งรถ วางที่เดียวกับยูตะได้
-- ============================================================
local FARM_ASSETS = { "ichiraku", "ramen", "farm", "money" }
local LONG_ASSETS = { "frieren", "elfmage", "elf mage" }
-- ⭐ ตัวซัพ (บัฟ/ดีบัฟ DPS 0) — วางได้ แต่ "ห้ามอัพเกรด" เปลืองเงินเปล่า
local SUPPORT_ASSETS = {
    "rukia",          -- Ice Queen
    "utahime",        -- Forbidden Teacher
    "himmel",         -- The Hero
    "gray",           -- Ice Mage
    "sugar",          -- Toy Maker (ซัมมอน)

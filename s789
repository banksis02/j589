local function getHotbarSlots()
    local bh = player.PlayerGui:FindFirstChild("BottomHUD")
    if not bh then return {} end
    local slots = {}
    for _, tb in ipairs(bh:GetDescendants()) do
        if tb:IsA("TextButton") then
            for _, d in ipairs(tb:GetDescendants()) do
                if d:IsA("ViewportFrame") then table.insert(slots, tb); break end
            end
        end
    end
    return slots
end

-- normalize: ตัดอักขระที่ไม่ใช่ตัวอักษร/ตัวเลข (กัน "Ice Queen" vs "IceQueen")
local function normUnit(s) return (tostring(s):lower():gsub("[^%w]", "")) end

-- ⭐ อ่านชื่อ asset จริงต่อช่องจาก replica PlayerData.HotbarData
--    (ชื่อ Model ใน hotbar UI เป็นชื่อ rig เช่น "Stupid"/"Himel" ใช้ไม่ได้)
--    รูปแบบ: { [1]="Yuta#uuid", [2]="Inumaki#uuid", ... }
local function getHotbarAssets()
    local out = {}
    local pd = getReplica("PlayerData")
    if not pd then return out end
    local ok, data = pcall(function() return pd.Data end)
    if not ok or type(data) ~= "table" then return out end
    local hb = data.HotbarData
    if type(hb) ~= "table" then return out end
    for k, v in pairs(hb) do
        local slot = tonumber(k)
        if slot and type(v) == "string" then
            local uid = v:match("^([^#]+)") or v          -- "Yuta#uuid" → "Yuta"
            local asset = uid
            -- ดูชื่อ Asset จริงจาก UnitData (เผื่อเป็นร่าง EVO: Yuta → YutaEVO)
            pcall(function()
                local ud = data.UnitData and data.UnitData[v]
                if ud and ud.Asset then asset = tostring(ud.Asset) end
            end)
            out[slot] = { base = uid, asset = asset }
        end
    end
    return out
end

-- ⭐ คืนเลขช่องของ entry — จับคู่ด้วย asset name จาก replica เท่านั้น
--    (ชื่อ Model ใน UI เป็นชื่อ rig เช่น "Stupid"/"Rika" → match มั่ว ไม่ใช้)
local function findSlotFor(entry)
    local wants = {}
    for _, a in ipairs(entry.assets or {}) do wants[#wants+1] = normUnit(a) end
    if #wants == 0 then wants[1] = normUnit(entry.name) end

    local best, bestScore
    for slot, info in pairs(getHotbarAssets()) do
        for _, cand in ipairs({ info.asset, info.base }) do
            local n = normUnit(cand)
            if n ~= "" then
                for _, w in ipairs(wants) do
                    local score
                    if n == w then score = 1000
                    -- substring ต้องยาวพอ (≥4) กัน match มั่วจากคำสั้น
                    elseif #w >= 4 and (n:find(w, 1, true) or w:find(n, 1, true)) then
                        score = math.min(#n, #w)
                    end
                    if score and (not bestScore or score > bestScore) then
                        best, bestScore = slot, score
                    end
                end
            end
        end
    end
    return best
end

local function unitCountNearPos(pos, radius)
    local u = workspace:FindFirstChild("Units")
    if not u then return 0 end
    local n = 0
    for _, m in ipairs(u:GetChildren()) do
        local ok, p = pcall(function() return m:GetPivot().Position end)
        if ok and p and (p - pos).Magnitude <= radius then n = n + 1 end
    end
    return n
end

-- ============================================================
-- ⭐ พิกัดวางตัว = "ตำแหน่งบนรถ" ไม่ใช่พิกัดโลกตายตัว
--    รถเคลื่อนที่ตลอด → แปลงพิกัดที่ฟิคไว้ให้เป็น offset เทียบ PayloadOrigin
--    เวลาวาง (หรือวางซ้ำระหว่างทาง) ค่อยคูณกลับด้วยตำแหน่งรถปัจจุบัน
-- ============================================================
local function payloadPart(name)
    local map = workspace:FindFirstChild("Map")
    local pm = map and map:FindFirstChild("PayloadModel")
    if not pm then return nil end
    return pm:FindFirstChild(name) or pm.PrimaryPart
end

-- ⭐ กติกา: ตำแหน่งที่ฟิคไว้ = ตำแหน่งจริงเท่านั้น ห้ามขยับ/ห้ามสุ่ม
--    สิ่งเดียวที่บวกเพิ่มคือ "ระยะที่รถเคลื่อนที่ไป" (เลื่อนตามรถตรงๆ ไม่หมุน ไม่ขยับเข้าใน)
--    รถอยู่จุดเริ่ม → ได้พิกัดเดิมเป๊ะๆ
local function liveCF(entry)
    local base = CFrame.new(unpack(entry.cf))
    local map  = workspace:FindFirstChild("Map")
    local org  = map and map:FindFirstChild("PayloadOrigin")
    local ref  = payloadPart("Primary")
    if not org or not ref then return base end       -- ไม่เจอรถ → พิกัดเดิม
    local move = ref.Position - org.Position         -- รถเลื่อนไปเท่าไหร่
    if move.Magnitude < 0.5 then return base end     -- รถยังอยู่จุดเริ่ม → พิกัดเดิมเป๊ะ
    return base + move
end


    -- ============================================================
    -- [AE] 🎛️ Remote Control — รับคำสั่งงานจากหน้าเว็บ admin
    --   ไม่มี UI ในเกมแล้ว — สั่งงานผ่านเว็บอย่างเดียว
    --   1. Heartbeat ทุก 30 วิ → ไอดีขึ้นเว็บทันทีที่รันสคริปต์ + รู้ online/offline
    --   2. Poll งานทุก 10 วิ → มีงาน = ฟาร์มตามที่สั่ง / งานเสร็จ = หยุดฟาร์ม
    -- ============================================================
    local currentJob = nil        -- { status, kind, mode, stage, target, current }

    local function sendHeartbeat()
        local level, bp, wave = aeGetStats()
        local mapName = "Lobby"
        pcall(function()
            local gs = aeGetReplica("GameState")
            if gs and gs.Data and gs.Data.Parameters then
                local p = gs.Data.Parameters
                if p.MapName then
                    mapName = tostring(p.MapName)
                    if p.ActName then mapName = mapName .. " - " .. tostring(p.ActName) end
                end
            end
        end)
        local payload = {
            username     = player.Name,
            userId       = player.UserId,
            serviceName  = GAME_NAME,
            gameId       = GAME_ID,
            farming      = farmingActive,      -- ⭐ นับ farmTime เฉพาะตอนฟาร์มจริง
            currentStats = { level = level, bp = bp, villainBp = aeGetVillainBP() },
            matchInfo    = { map = mapName, wave = wave },
            -- ไม่ส่ง endScreen → backend เก็บ Last Round เดิมไว้
        }
        pcall(function()
            HttpService:RequestAsync({
                Url = BACKEND_URL .. "/api/overload/update",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode(payload)
            })
        end)
    end

    -- heartbeat: ส่งทันทีตอนโหลด แล้วทุก 30 วิ
    task.spawn(function()
        task.wait(3)
        sendHeartbeat()
        print("[AE Remote] 📡 Heartbeat เริ่มแล้ว — ไอดีขึ้นหน้าเว็บ admin")
        while true do
            task.wait(30)
            pcall(sendHeartbeat)
        end
    end)

    -- poll งานจากเว็บ
    local function fetchJob()
        local ok, resp = pcall(function()
            return HttpService:RequestAsync({
                Url = BACKEND_URL .. "/api/job/" .. tostring(player.UserId),
                Method = "GET",
            })
        end)
        if not ok or type(resp) ~= "table" or not resp.Success then return nil end
        local okDec, data = pcall(function() return HttpService:JSONDecode(resp.Body) end)
        if not okDec or type(data) ~= "table" then return nil end
        return data
    end

    task.spawn(function()
        -- ⭐ v9.28: รอ 60 วิ "เฉพาะตอนอยู่ล็อบบี้" (ให้เกมโหลด content ก่อนเข้าด่าน)
        --    ถ้าอยู่ในด่านอยู่แล้ว (รีเข้ามากลางเกม) → ไม่รอ มอนเดินแล้วต้องรีบวางตัว
        local iz = workspace:FindFirstChild("InteractZones")
        local atLobby = iz and iz:FindFirstChild("Crafting") ~= nil
        if atLobby then
            print("[AE Remote] ⏳ อยู่ล็อบบี้ → รอเกมโหลด content 60 วิ ...")
            task.wait(60)
        else
            print("[AE Remote] ⚡ อยู่ในด่านอยู่แล้ว → ไม่รอ เริ่มเลย")
            task.wait(3)
        end
        print("[AE Remote] 🎛️ รอรับคำสั่งงานจากเว็บ...")
        local lastStatus, lastLabel = nil, nil
        while true do
            pcall(function()
                local job = fetchJob()
                if not job then return end
                currentJob = job

                local changed = (job.status ~= lastStatus) or (job.label ~= lastLabel)
                lastStatus, lastLabel = job.status, job.label

                if job.status == "active" then
                    -- ⭐ มีงาน → ฟาร์มตามที่สั่ง (ถ้ายังไม่ได้ฟาร์ม หรือโหมด/ด่านเปลี่ยน)
                    local wantMode  = job.mode or "act1"
                    local wantStage = job.stage or "School Grounds"
                    -- ⭐ v8.5: งาน Expedition — รับความยาก 1/2/3 + แมพ จากเว็บ
                    if wantMode == "expedition" then
                        local newDiff = tonumber(job.difficulty) or 3
                        local newMap  = job.stage or "School Grounds"
                        if _G.AE_EXP_DIFF ~= newDiff or _G.AE_EXP_MAP ~= newMap then
                            print(("[AE Remote] 🧭 Expedition: %s ความยาก %d"):format(newMap, newDiff))
                        end
                        _G.AE_EXP_DIFF = newDiff
                        _G.AE_EXP_MAP  = newMap
                    end
                    -- ⭐ v9.33: งาน Expedition วนด่าน — รับความยาก 1/2/3 (วน 3 แมพเองด่านละ 1 ชม.)
                    if wantMode == "expedition_rotate" then
                        local newDiff = tonumber(job.difficulty) or 3
                        if _G.AE_EXP_DIFF ~= newDiff then
                            print(("[AE Remote] 🔄 Expedition วนด่าน: ความยาก %d"):format(newDiff))
                        end
                        _G.AE_EXP_DIFF = newDiff
                    end
                    -- ⭐ งาน Villain Invasion — รับ Act 1/2/3 จากเว็บ (job.difficulty = act)
                    if wantMode == "villain" then
                        local newAct = tonumber(job.difficulty) or 1
                        if _G.AE_VILLAIN_ACT ~= newAct then
                            print(("[AE Remote] 😈 Villain Invasion: Act %d"):format(newAct))
                        end
                        _G.AE_VILLAIN_ACT = newAct
                    end
                    -- ⭐ งานทำเควส (Bounty) — รับ fallback (โหมด/ด่าน) จากเว็บ หลังเควสครบ
                    if wantMode == "quest" then
                        _G.AE_QUEST_FALLBACK_MODE  = job.fallbackMode or job.fallback or "villain"
                        _G.AE_QUEST_FALLBACK_STAGE = job.stage or "School Grounds"
                        _G.AE_QUEST_FALLBACK_ACT   = tonumber(job.difficulty) or 1
                    end
                    if changed then
                        print(("[AE Remote] 📋 งานใหม่: %s | %s | %s (%s/%s)")
                            :format(tostring(job.label), wantMode, wantStage,
                                    tostring(job.current), tostring(job.target)))
                    end
                    if not farmingActive then
                        print("[AE Remote] ▶ เริ่มฟาร์มตามคำสั่ง")
                        startFarm(wantMode, wantStage)
                    elseif farmMode ~= wantMode or farmStage ~= wantStage then
                        print("[AE Remote] 🔄 เปลี่ยนงาน → รีสตาร์ทฟาร์ม")
                        stopFarm()
                        task.wait(1)
                        startFarm(wantMode, wantStage)
                    end
                else
                    -- idle / done → หยุดฟาร์ม
                    if farmingActive then
                        if job.status == "done" then
                            print("[AE Remote] 🏁 งานเสร็จแล้ว → หยุดฟาร์ม")
                        else
                            print("[AE Remote] ⏹ ไม่มีงาน → หยุดฟาร์ม")
                        end
                        stopFarm()
                        pcall(sendHeartbeat)
                    end
                end
            end)
            task.wait(10)
        end
    end)

    _G.AE_JOB = function() return currentJob end
    print("[AE] ✅ Remote mode พร้อม (สั่งงานผ่านเว็บ)")
end


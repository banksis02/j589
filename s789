    if paths then
        for _, lane in ipairs(paths:GetChildren()) do
            for _, p in ipairs(lane:GetChildren()) do
                if p:IsA("BasePart") and tonumber(p.Name) then return true end
            end
        end
    end
    -- สำรอง: GameState active
    local gs = getReplica("GameState")
    local d = gs and gs.Data
    if type(d) == "table" and (d.Active == true or tostring(d.CurrentGameState) == "InProgress") then
        return true
    end
    return false
end


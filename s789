                    if t:find("Challenge",1,true) and t:find(target,1,true) then ry=l.AbsolutePosition.Y; break end
                end
            end
        end
        if ry then break end
    end
    if not ry then L("  ❌ ไม่เจอแถว Challenge "..target); return false end

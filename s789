-- 🎯 วางตัวกองที่ 50-70% ของเส้นทาง (ด่านนี้ยาก → รวมพลังจุดเดียว)
-- ============================================================
local PILE_MIN, PILE_MAX = 0.50, 0.70   -- ช่วง % ของเส้นทาง
-- เยื้องข้างแคบ (ด่านยาก → เกาะกันแน่น) แต่มีสำรองห่างขึ้นถ้าที่เต็ม
local SIDE_OFFSETS = { 0, 3, -3, 2, -2, 5, -5, 4, -4, 7, -7, 9, -9 }

-- สร้าง 1 เลน จากโฟลเดอร์ waypoint
local function buildLane(lane)
    local parts = {}
    for _, p in ipairs(lane:GetChildren()) do
        if p:IsA("BasePart") and tonumber(p.Name) then table.insert(parts, p) end
    end
    if #parts < 2 then return nil end
    table.sort(parts, function(a, b) return tonumber(a.Name) < tonumber(b.Name) end)
    local pts, cum = {}, { 0 }
    for i, p in ipairs(parts) do
        pts[i] = p.Position
        if i > 1 then cum[i] = cum[i-1] + (pts[i]-pts[i-1]).Magnitude end
    end
    return { pts = pts, cum = cum, total = cum[#cum] }
end

-- ⭐ สร้าง "ทุกเลน" (แมพ Villain มอบมาหลายทาง — ต้องวางคร่อมทุกเลน)
-- แปลง 1 โฟลเดอร์เป็นเลน — รองรับ 2 โครงสร้าง:
--   A) folder มีลูกเป็น "เลน" (แต่ละเลนมี waypoint เลข)  B) folder เองมี waypoint เลขตรงๆ (เลนเดียว)
local function lanesFromFolder(folder)
    local lanes = {}
    for _, lane in ipairs(folder:GetChildren()) do
        local L = buildLane(lane)
        if L then L.name = lane.Name; table.insert(lanes, L) end
    end
    if #lanes == 0 then
        local L = buildLane(folder)
        if L then L.name = folder.Name; table.insert(lanes, L) end
    end
    return lanes
end
-- ⭐ v9.57: หา path ได้ทั้ง workspace.Map.Paths และที่อื่น (Story/Infinite เก็บคนละที่)
local function buildAllPaths()
    local map = workspace:FindFirstChild("Map")
    if not map then return {} end
    local function done(lanes)
        if #lanes > 0 then table.sort(lanes, function(a, b) return tostring(a.name) < tostring(b.name) end); return lanes end
        return nil
    end
    -- 1) ตรงๆ Map.Paths
    local direct = map:FindFirstChild("Paths")
    if direct then local r = done(lanesFromFolder(direct)); if r then return r end end
    -- 2) โฟลเดอร์ชื่อมี path/waypoint/node/track ที่ไหนก็ได้ใน Map
    for _, c in ipairs(map:GetDescendants()) do
        if (c:IsA("Folder") or c:IsA("Model")) then
            local nm = tostring(c.Name):lower()
            if nm:find("path") or nm:find("waypoint") or nm:find("node") or nm:find("track") then
                local r = done(lanesFromFolder(c)); if r then return r end
            end
        end
    end
    -- 3) ทางเลือกสุดท้าย: โฟลเดอร์ไหนก็ได้ที่ประกอบเป็นเลนยาวจริง (waypoint เลข, ยาว > 30)
    for _, c in ipairs(map:GetDescendants()) do
        if (c:IsA("Folder") or c:IsA("Model")) then
            local lanes = lanesFromFolder(c)
            if #lanes > 0 and (lanes[1].total or 0) > 30 then local r = done(lanes); if r then return r end end
        end
    end
    return {}
end

-- เข้ากันได้กับโค้ดเดิม (เลนแรก)
local function buildPath()
    local lanes = buildAllPaths()
    return lanes[1]
end
local function posAt(path, d)
    d = math.clamp(d, 0, path.total)
    for i = 2, #path.pts do
        if path.cum[i] >= d then
            local segLen = path.cum[i] - path.cum[i-1]
            local t = segLen > 0 and (d - path.cum[i-1]) / segLen or 0
            return path.pts[i-1]:Lerp(path.pts[i], t)
        end
    end
    return path.pts[#path.pts]
end
local function dirAt(path, d)
    d = math.clamp(d, 0, path.total)
    for i = 2, #path.pts do
        if path.cum[i] >= d then
            local v = path.pts[i] - path.pts[i-1]
            if v.Magnitude > 0 then return v.Unit end
        end
    end
    return Vector3.new(0, 0, 1)
end
local function unitCount()
    local u = workspace:FindFirstChild("Units")
    return u and #u:GetChildren() or 0
end

-- ⭐ หา "เลนที่มอนเดินจริง" — นับมอนที่อยู่ใกล้แต่ละเลน เลือกเลนที่มอนเยอะสุด
--    (ใช้ได้ทุก Act ไม่ต้องเดาว่า Act ไหน = เลนไหน)
local function nearestDistToLane(lane, pos)
    local best = math.huge
    for _, wp in ipairs(lane.pts) do
        local d = (Vector3.new(wp.X, 0, wp.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude
        if d < best then best = d end
    end
    return best
end
local function findActiveLane(lanes)
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil end
    local score = {}
    local total = 0
    for _, m in ipairs(enemies:GetChildren()) do
        local ok, p = pcall(function() return m:GetPivot().Position end)
        if ok then
            total = total + 1
            -- มอนตัวนี้ใกล้เลนไหนสุด → ให้คะแนนเลนนั้น
            local bestLane, bestD
            for li, lane in ipairs(lanes) do
                local d = nearestDistToLane(lane, p)
                if not bestD or d < bestD then bestLane, bestD = li, d end
            end
            if bestLane and bestD <= 30 then score[bestLane] = (score[bestLane] or 0) + 1 end
        end
    end
    if total == 0 then return nil end
    local winner, winScore
    for li, sc in pairs(score) do
        if not winScore or sc > winScore then winner, winScore = li, sc end
    end
    if winner then return lanes[winner], winScore, total end
    return nil
end

-- ⭐ ตัวเงิน — มีแค่ 2 ตัวนี้เท่านั้น (Ichiraku, Ramen Guy) — วางก่อน + อัพก่อน
local MONEY_ASSETS = { "ichiraku", "ramen" }
-- ⭐ ตัวซัพ (บัฟ/ดีบัฟ DPS 0) — วางได้ แต่ห้ามอัพ (เปลืองเงิน)
--    Stone Alchemist ก็เป็นซัพ (ไม่ใช่ตัวเงิน)
local SUPPORT_ASSETS = { "rukia", "utahime", "himmel", "gray", "sugar", "inumaki", "salmon",
                         "stonealchemist", "alchemist" }
local function assetIn(asset, list)
    local a = tostring(asset):lower()
    for _, k in ipairs(list) do if a:find(k, 1, true) then return true end end
    return false
end
local function isMoneyUnit(asset)   return assetIn(asset, MONEY_ASSETS)   end
local function isSupportUnit(asset) return assetIn(asset, SUPPORT_ASSETS) end
local function slotAsset(id)
    if type(id) ~= "string" then return "" end
    local a = id:match('"Asset"%s*:%s*"([^"]+)"')       -- JSON (ตัวจ้าง)
    if a then
        if a:find("Equipment") then
            for x in id:gmatch('"Asset"%s*:%s*"([^"]+)"') do if not x:find("Equipment") then a = x; break end end
        end
        return a
    end
    return (id:gsub("#.*$", ""))
end

-- อ่านช่องตัวละครในด่าน (hotbar ที่วางได้) — เรียงตัวเงินก่อน
local function gameHotbarSlots()
    if not registry then return {} end
    local best
    for _, rep in pairs(registry) do
        local ok, t = pcall(function() return rep.Token end)
        if ok and t == "HotbarData" then
            local okd, d = pcall(function() return rep.Data end)
            if okd and type(d) == "table" and type(d.Slots) == "table" then
                if d.PlacementAllowed == true then best = d; break end
                if not best or (tonumber(d.MaxSlots) or 0) > (tonumber(best.MaxSlots) or 0) then best = d end
            end
        end
    end
    local out = {}
    if best then
        for k, v in pairs(best.Slots) do
            local n = tonumber(k)
            if n and type(v) == "table" and tostring(v.AssetType) == "Unit" then
                local asset = slotAsset(v.ID)
                out[#out+1] = { slot = n, cost = tonumber(v.PlacementCost) or 0,
                                asset = asset, money = isMoneyUnit(asset) }
            end
        end
    end
    -- ⭐ ตัวเงินก่อน (money=true มาก่อน) แล้วค่อยเรียงตาม slot
    table.sort(out, function(a, b)
        if a.money ~= b.money then return a.money end
        return a.slot < b.slot
    end)
    return out
end

-- วางตัว 1 ช่องที่จุด d (ลองเยื้องข้างจนติด)
local function placeAt(path, slot, d)
    local rep = getReplica("GamePlayerData")
    if not rep then return false end
    local hb = getReplica("HotbarData")
    local base = posAt(path, d)
    local dir = dirAt(path, d)
    local perp = Vector3.new(-dir.Z, 0, dir.X)
    for _, off in ipairs(SIDE_OFFSETS) do
        local p = base + perp * off
        local before = unitCount()
        if hb then pcall(function() hb:FireServer("SelectSlot", slot) end); task.wait(0.1) end
        pcall(function() rep:FireServer("PlaceGameUnit", slot, CFrame.new(p.X, p.Y, p.Z, 1,0,0, 0,1,0, 0,0,1)) end)
        task.wait(0.7)
        if unitCount() > before then return true end
    end
    return false
end


                            local inset = game:GetService("GuiService"):GetGuiInset()
                            local cx = startBtn.AbsolutePosition.X + startBtn.AbsoluteSize.X/2
                            local cy = startBtn.AbsolutePosition.Y + startBtn.AbsoluteSize.Y/2 + inset.Y

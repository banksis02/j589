        -- 6) ⭐ Map.Decorations/Props/Border — DESTROY (free memory จริงๆ)
        -- ⚠️ ห้าม destroy: PathDECO, TerrainParts, Path
        local map = workspace:FindFirstChild("Map")
        if map then
            for _, subName in ipairs({ "Decorations","Decoration","Props","Border" }) do
                local sub = map:FindFirstChild(subName)
                if sub then
                    for _, child in ipairs(sub:GetChildren()) do
                        if not isFloorPart(child) then
                            pcall(function() child:Destroy() end)
                        end
                    end
                end
            end

            -- ⭐ ซ่อน Boss/Mob ที่เป็น Model ตรงๆ ใน Map (Vegito, Trunks, GokuBlack, Zamasu, ...)
            -- ⚠️ KEEP = ไม่แตะ (เก็บไว้ให้เห็น)
            local KEEP = {
                Path=true, PathDECO=true, TerrainParts=true,    -- ⭐ พื้น + เส้นทาง
                Spawns=true, Static1=true, Static2=true,
                ActorSpawn=true, ActorSpawn2=true, ActorSpawn3=true
            }
            for _, m in ipairs(map:GetChildren()) do
                if m:IsA("Model") and not KEEP[m.Name] then
                    -- ⭐ ถ้า Model ชื่อเป็น floor/hill/terrain → ห้ามแตะ
                    if not isFloorPart(m) then
                        pcall(hideEnemyVisuals, m)
                    end
                end
            end
        end

        -- 7) Ignore.Effects/Drops/GhostUnits/Hitboxes — ซ่อน ไม่ DESTROY (เกมต้องใช้ ref อยู่)
        local ignore = workspace:FindFirstChild("Ignore")
        if ignore then
            for _, subName in ipairs({ "Effects","Drops","GhostUnits","Hitboxes" }) do
                local sub = ignore:FindFirstChild(subName)
                if sub then
                    for _, d in ipairs(sub:GetDescendants()) do
                        if d:IsA("BasePart") or d:IsA("MeshPart") or d:IsA("UnionOperation") then
                            pcall(function() d.Transparency = 1 end)
                            pcall(function() d.CastShadow = false end)
                            pcall(function() d.LocalTransparencyModifier = 1 end)
                        elseif d:IsA("Decal") or d:IsA("Texture") then
                            pcall(function() d.Transparency = 1 end)
                        elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
                           or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then
                            pcall(function() d.Enabled = false end)
                        end
                    end
                end
            end

            -- ⭐ Ignore.Units = ยูนิตเรา (UUID) + ศัตรู (เลข)
            -- - ยูนิตเรา: ชื่อเป็น UUID (8-4-4-4-12) หรือมี Identifier attribute → เก็บไว้ + ปิดแค่ effects
            -- - ศัตรู: ชื่อเป็นเลขล้วน ไม่มี Identifier → ซ่อนทั้งตัว
            local myUnits = ignore:FindFirstChild("Units")
            if myUnits then
                local function isPlayerUnit(m)
                    if m:GetAttribute("Identifier") then return true end
                    if m:GetAttribute("ManualTargeting") ~= nil then return true end
                    -- UUID format: 8-4-4-4-12 hex chars
                    if m.Name:match("^[%w]+%-[%w]+%-[%w]+%-[%w]+%-[%w]+$") then return true end
                    return false
                end
                -- sub-model ในยูนิตเราที่ถือว่าเป็น effect (Aura/Glow/Slash/Aurora/...)
                local FX_SUBMODELS = {
                    aura=true, glow=true, slash=true, blast=true, wave=true, beam=true,
                    explosion=true, particle=true, effect=true, shockwave=true,
                    aurora=true, energy=true, ki=true, halo=true, ring=true,
                    cloak=true, trail=true, dome=true, light=true, fire=true,
                    fx=true, vfx=true, ["fx_"]=true,
                }
                local function isFXSubModel(name)
                    local lower = name:lower()
                    for kw in pairs(FX_SUBMODELS) do
                        if lower:find(kw) then return true end
                    end
                    return false
                end

                for _, unit in ipairs(myUnits:GetChildren()) do
                    if unit:IsA("Model") then
                        if isPlayerUnit(unit) then
                            -- ยูนิตเรา: ปิด effects + ซ่อน FX sub-model (Aura/Glow/Slash)
                            for _, d in ipairs(unit:GetDescendants()) do
                                if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
                                   or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then
                                    pcall(function() d.Enabled = false end)
                                elseif d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
                                    pcall(function() d.Enabled = false end)
                                end
                            end
                            -- ⭐ ซ่อน FX sub-model (Aura/Glow/etc.) ในยูนิต
                            for _, sub in ipairs(unit:GetChildren()) do
                                if (sub:IsA("Model") or sub:IsA("Folder")) and isFXSubModel(sub.Name) then
                                    for _, d in ipairs(sub:GetDescendants()) do
                                        if d:IsA("BasePart") or d:IsA("MeshPart") then
                                            pcall(function() d.Transparency = 1 end)
                                            pcall(function() d.CanCollide = false end)
                                        elseif d:IsA("Decal") or d:IsA("Texture") then
                                            pcall(function() d.Transparency = 1 end)
                                        end
                                    end
                                end
                            end
                        else
                            -- ⭐ ศัตรู: ซ่อนทั้งตัว
                            pcall(hideEnemyVisuals, unit)
                        end
                    end
                end
            end
        end

        -- 7.5) Camera = skill effects — ซ่อน ไม่ DESTROY (เกมต้องใช้ structure อยู่)
        local cam = workspace:FindFirstChild("Camera")
        if cam then
            for _, d in ipairs(cam:GetDescendants()) do
                if d:IsA("BasePart") or d:IsA("MeshPart") then
                    pcall(function() d.Transparency = 1 end)
                    pcall(function() d.CastShadow = false end)
                    pcall(function() d.LocalTransparencyModifier = 1 end)
                elseif d:IsA("Decal") or d:IsA("Texture") then
                    pcall(function() d.Transparency = 1 end)
                elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
                   or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then
                    pcall(function() d.Enabled = false end)
                end
            end
        end

        -- 8) Terrain.TempVFX
        local tempVfx = workspace.Terrain:FindFirstChild("TempVFX")
        if tempVfx then
            for _, d in ipairs(tempVfx:GetDescendants()) do
                pcall(processInstance, d)
            end
        end

        -- 9) ซ่อนยูนิตศัตรูใน folder อื่นๆ (เผื่อมี)
        for _, fname in ipairs(ENEMY_FOLDERS) do
            local f = workspace:FindFirstChild(fname)
            if f then
                for _, e in ipairs(f:GetChildren()) do
                    if e:IsA("Model") and not playerNames[e.Name] then
                        pcall(hideEnemyVisuals, e)
                    end
                end
            end
        end

        -- 10) Process ทุก descendant ใน workspace (final pass)
        for _, obj in ipairs(workspace:GetDescendants()) do
            processInstance(obj)
        end
    end

    task.spawn(function()
        task.wait(2)
        print("[UTDX] 🚀 บูส FPS ON | v4 (DESTROY Decorations/Effects/Camera + Fog 300)")
        boostFPS()
        pcall(function() collectgarbage("collect") end)

        -- Hook ของใหม่ที่ spawn เข้ามา → process ทันที
        workspace.DescendantAdded:Connect(function(obj)
            task.wait(0.1)
            pcall(processInstance, obj)
        end)

        -- ⭐ Hook workspace.Folder.* (themed enemies — Fodder, DBZ, ...) → ซ่อนศัตรูใหม่
        local themedRoot = workspace:FindFirstChild("Folder")
        if themedRoot then
            local function processNew(d)
                -- ดักทุก descendant — ไม่ต้องเป็น Model
                if d:IsA("BasePart") or d:IsA("MeshPart") or d:IsA("UnionOperation") then
                    pcall(function() d.Transparency = 1 end)
                    pcall(function() d.CastShadow = false end)
                    pcall(function() d.LocalTransparencyModifier = 1 end)
                elseif d:IsA("Decal") or d:IsA("Texture") then
                    pcall(function() d.Transparency = 1 end)
                elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
                    or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then
                    pcall(function() d.Enabled = false end)
                elseif d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
                    pcall(function() d.Enabled = false end)
                elseif d:IsA("Humanoid") then
                    pcall(function() d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
                end
            end

            local function hookSub(sub)
                -- ดักทุก descendant ใหม่ที่เพิ่มเข้ามา
                sub.DescendantAdded:Connect(function(d)
                    task.wait(0.05)
                    pcall(processNew, d)
                end)
                -- ซ่อนของที่มีอยู่แล้วในตอนนั้น
                for _, d in ipairs(sub:GetDescendants()) do
                    pcall(processNew, d)
                end
            end
            for _, sub in ipairs(themedRoot:GetChildren()) do
                hookSub(sub)
            end
            -- Hook sub-folder ใหม่ที่ themed root เพิ่มเข้ามา
            themedRoot.ChildAdded:Connect(function(sub)
                task.wait(0.05)
                hookSub(sub)
            end)
        end

        -- ซ่อนศัตรูใหม่ใน enemy folder อื่นๆ
        for _, fname in ipairs(ENEMY_FOLDERS) do
            local f = workspace:FindFirstChild(fname)
            if f then
                f.ChildAdded:Connect(function(child)
                    task.wait(0.2)
                    if child:IsA("Model") then
                        pcall(hideEnemyVisuals, child)
                    end
                end)
            end
        end

        -- ⭐ Hook Ignore.Units → ปิด effects ของยูนิตเรา + ซ่อนศัตรูใหม่ที่ spawn
        local ignoreFolder = workspace:FindFirstChild("Ignore")
        if ignoreFolder then
            local myUnits = ignoreFolder:FindFirstChild("Units")
            if myUnits then
                local function isPlayerUnit(m)
                    if m:GetAttribute("Identifier") then return true end
                    if m:GetAttribute("ManualTargeting") ~= nil then return true end
                    if m.Name:match("^[%w]+%-[%w]+%-[%w]+%-[%w]+%-[%w]+$") then return true end
                    return false
                end

                -- ⭐ มอนใหม่ spawn (ChildAdded ที่ Units folder) → ตรวจชื่อ ถ้าเป็นเลข = ศัตรู ซ่อนทันที
                myUnits.ChildAdded:Connect(function(unit)
                    task.wait(0.1)
                    if unit:IsA("Model") and not isPlayerUnit(unit) then
                        pcall(hideEnemyVisuals, unit)
                    end
                end)

                -- ปิด effect ของยูนิตเรา (ทุก descendant ใหม่)
                myUnits.DescendantAdded:Connect(function(d)
                    task.wait(0.05)
                    if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
                       or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles")
                       or d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
                        pcall(function() d.Enabled = false end)
                    end
                end)
            end

            -- ⭐ Hook Ignore.Effects + Drops + GhostUnits + Hitboxes — บังคับซ่อนทันทีที่ effect spawn
            for _, fname in ipairs({"Effects","Drops","GhostUnits","Hitboxes"}) do
                local f = ignoreFolder:FindFirstChild(fname)
                if f then
                    f.DescendantAdded:Connect(function(d)
                        task.wait(0.03)
                        if d:IsA("BasePart") or d:IsA("MeshPart") or d:IsA("UnionOperation") then
                            pcall(function() d.Transparency = 1 end)
                            pcall(function() d.CastShadow = false end)
                            pcall(function() d.LocalTransparencyModifier = 1 end)
                        elseif d:IsA("Decal") or d:IsA("Texture") then
                            pcall(function() d.Transparency = 1 end)
                        elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
                           or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles")
                           or d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
                            pcall(function() d.Enabled = false end)
                        end
                    end)
                end
            end
        end

        -- Hook Camera.DescendantAdded — ซ่อน effects ใหม่ ไม่ destroy
        local camFolder = workspace:FindFirstChild("Camera")
        if camFolder then
            camFolder.DescendantAdded:Connect(function(d)
                task.wait(0.05)
                if d:IsA("BasePart") or d:IsA("MeshPart") then
                    pcall(function() d.Transparency = 1 end)
                    pcall(function() d.CastShadow = false end)
                    pcall(function() d.LocalTransparencyModifier = 1 end)
                elseif d:IsA("Decal") or d:IsA("Texture") then
                    pcall(function() d.Transparency = 1 end)
                elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
                   or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then
                    pcall(function() d.Enabled = false end)
                end
            end)
        end

        -- ⭐ Hook workspace.Map.ChildAdded → boss/มอน spawn ใหม่ใน Map → ซ่อนทันที
        local map = workspace:FindFirstChild("Map")
        if map then
            local KEEP = { Path=true, PathDECO=true, TerrainParts=true,
                          Spawns=true, Static1=true, Static2=true,
                          ActorSpawn=true, ActorSpawn2=true, ActorSpawn3=true }
            map.ChildAdded:Connect(function(child)
                task.wait(0.1)
                if child:IsA("Model") and not KEEP[child.Name] and not isFloorPart(child) then
                    pcall(hideEnemyVisuals, child)
                end
            end)

            -- Hook Map.Decorations.DescendantAdded สำหรับ deco ที่ load ทีหลัง
            local deco = map:FindFirstChild("Decorations")
            if deco then
                deco.DescendantAdded:Connect(function(d)
                    task.wait(0.05)
                    if d:IsA("BasePart") or d:IsA("MeshPart") then
                        pcall(function() d.Transparency = 1 end)
                        pcall(function() d.CanCollide = false end)
                        pcall(function() d.CastShadow = false end)
                    end
                end)
            end
        end

        -- ⭐ Loop aggressive ทุก 0.5 วิ — ดักทุก effect (particle + mesh ใน Ignore.Effects/Camera)
        task.spawn(function()
            while true do
                task.wait(0.5)
                pcall(function()
                    -- ปิด particle/beam/trail ทั่ว workspace
                    for _, d in ipairs(workspace:GetDescendants()) do
                        if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
                           or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then
                            if d.Enabled then d.Enabled = false end
                        elseif d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
                            if d.Enabled then d.Enabled = false end
                        end
                    end
                    -- ⭐ บังคับ Transparency = 1 ทุก Part ใน Ignore.Effects + Camera
                    local ig = workspace:FindFirstChild("Ignore")
                    if ig then
                        for _, sub in ipairs({ig:FindFirstChild("Effects"), ig:FindFirstChild("Drops"),
                                              ig:FindFirstChild("GhostUnits"), ig:FindFirstChild("Hitboxes")}) do
                            if sub then
                                for _, d in ipairs(sub:GetDescendants()) do
                                    if d:IsA("BasePart") or d:IsA("MeshPart") or d:IsA("UnionOperation") then
                                        if d.Transparency ~= 1 then d.Transparency = 1 end
                                    end
                                end
                            end
                        end
                    end
                    -- ซ่อน Camera children ที่สะสม (ไม่ destroy เพราะเกมต้องใช้ ref)
                    local cm = workspace:FindFirstChild("Camera")
                    if cm then
                        for _, d in ipairs(cm:GetDescendants()) do
                            if d:IsA("BasePart") or d:IsA("MeshPart") then
                                if d.Transparency ~= 1 then d.Transparency = 1 end
                            elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") then
                                if d.Enabled then d.Enabled = false end
                            end
                        end
                    end

                    -- ⭐ บังคับ Fog ใหม่ (เผื่อโดน reset)
                    local L = game:GetService("Lighting")
                    if L.FogEnd > 500 then
                        L.FogEnd = 300
                        L.FogStart = 250
                    end
                end)
            end
        end)

        -- รีเฟรชเต็มทุก 5 วิ + force GC
        while true do
            task.wait(5)
            pcall(boostFPS)
            pcall(function() collectgarbage("collect") end)
        end
    end)

end


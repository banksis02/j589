        actButton = actButton or "1"
        print("[AE Enter] ▶ เริ่มเข้าด่าน " .. stageName .. " (Act " .. actButton .. ")...")
        -- ⭐ Play/Story ไม่บังคับสำเร็จ (อาจเปิดหน้านั้นค้างอยู่แล้วจากรอบก่อน)
        clickExact("Play")
        task.wait(2)
        clickExact("Story")
        task.wait(2)
        if not clickStageName(stageName) then
            warn("[AE Enter] ล้มเหลวที่: ชื่อด่าน — กด Back รีเซ็ต UI")
            clickExact("Back")   -- กลับ lobby เพื่อเริ่มใหม่สะอาดๆ
            task.wait(1)
            return false
        end

        -- ⭐ รอปุ่ม Act โผล่ (เครื่องช้า/emulator ใช้เวลานานกว่า 2 วิ)
        --    ถ้าไม่โผล่ → คลิกการ์ดด่านซ้ำด้วย VIM (getconnections บางเครื่องไม่ทำงาน)
        -- ⭐ ปุ่ม Act มีข้อความอยู่ใน label ลูก (PrimaryButton → TextLabel "M")
        --    ต้องเช็คทั้ง btn.Text และ label ลูก ไม่งั้นหาไม่เจอ
        local function findActBtn()
            local root = player.PlayerGui:FindFirstChild("Play") or player.PlayerGui
            for _, b in ipairs(root:GetDescendants()) do
                if (b:IsA("TextButton") or b:IsA("ImageButton")) and b.Visible
                   and b.AbsoluteSize.X <= 70 then
                    if b:IsA("TextButton") and b.Text == actButton then return b end
                    for _, l in ipairs(b:GetDescendants()) do
                        if l:IsA("TextLabel") and l.Visible and l.Text == actButton then return b end
                    end
                end
            end
            return nil
        end
        local actBtn
        for i = 1, 10 do
            actBtn = findActBtn()
            if actBtn then break end
            task.wait(1)
            if i == 4 then
                -- ยังไม่โผล่ → คลิกการ์ดด่านซ้ำ (VIM คลิกพิกัดจริง)
                print("[AE Enter] 🔁 ปุ่ม Act ยังไม่โผล่ → คลิกการ์ดด่านซ้ำ (VIM)")
                local root = player.PlayerGui:FindFirstChild("Play") or player.PlayerGui
                local target = normName(stageName)
                for _, lbl in ipairs(root:GetDescendants()) do
                    if lbl:IsA("TextLabel") and lbl.Visible and normName(lbl.Text) == target then
                        local p = lbl.Parent
                        while p and p ~= root do
                            if p:IsA("TextButton") or p:IsA("ImageButton") then
                                pcall(function()
                                    local inset = game:GetService("GuiService"):GetGuiInset()
                                    local cx = p.AbsolutePosition.X + p.AbsoluteSize.X/2
                                    local cy = p.AbsolutePosition.Y + p.AbsoluteSize.Y/2 + inset.Y
                                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
                                    task.wait(0.06)
                                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
                                end)
                                break
                            end
                            p = p.Parent
                        end
                        break
                    end
                end
            end
        end
        if not actBtn then
            warn("[AE Enter] ล้มเหลวที่: ปุ่ม Act '" .. actButton .. "' ไม่โผล่ (ด่านไม่เปิด/ไม่มี Act นี้)")
            clickExact("Back")
            task.wait(1)
            return false
        end
        if fireButtonConns(actBtn) == 0 then
            -- ยิง connection ไม่ติด → VIM คลิกพิกัด
            pcall(function()
                local inset = game:GetService("GuiService"):GetGuiInset()
                local cx = actBtn.AbsolutePosition.X + actBtn.AbsoluteSize.X/2
                local cy = actBtn.AbsolutePosition.Y + actBtn.AbsoluteSize.Y/2 + inset.Y
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
                task.wait(0.06)
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
            end)
        end
        print("[AE Enter] ✅ กด Act '" .. actButton .. "' แล้ว")
        task.wait(1.5)

        -- ⭐ คลิกปุ่มแบบทน: รอปุ่มโผล่ (poll) + VIM คลิกพิกัดถ้า connection ไม่ติด
        local function clickWait(text, waitSec)
            local btn
            local t0 = tick()
            while tick() - t0 < (waitSec or 6) do
                btn = findBtnAnywhere(text)
                if btn then break end
                task.wait(0.5)
            end
            if not btn then return false end
            if fireButtonConns(btn) == 0 then
                pcall(function()
                    local inset = game:GetService("GuiService"):GetGuiInset()
                    local cx = btn.AbsolutePosition.X + btn.AbsoluteSize.X/2
                    local cy = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y/2 + inset.Y
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
                    task.wait(0.06)
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
                end)
            end
            print("[AE Enter] ✅ กด '" .. text .. "'")
            return true
        end

        if needHard then
            if not clickWait("Hard", 6) then warn("[AE Enter] ล้มเหลวที่: Hard"); return false end
            task.wait(1)
        end
        if not clickWait("Select Stage", 8) then warn("[AE Enter] ล้มเหลวที่: Select Stage"); return false end
        task.wait(3)                                        -- รอหน้า Private Party
        -- ⭐ v7.7: ลอง Start ให้นานขึ้น + ถ้าไม่โผล่ กด Select Stage ซ้ำแล้วลองใหม่
        if not clickWait("Start", 12) then
            print("[AE Enter] 🔁 ไม่เจอ Start → กด Select Stage ซ้ำ")
            clickWait("Select Stage", 5)
            task.wait(3)
            if not clickWait("Start", 12) then
                warn("[AE Enter] ล้มเหลวที่: Start")
                -- ⭐ v7.8: ลิสต์ปุ่มที่เห็นจริงตอนนั้น จะได้รู้ว่าปุ่มจริงชื่ออะไร
                local seen = {}
                for _, g in ipairs(player.PlayerGui:GetChildren()) do
                    if g:IsA("ScreenGui") and g.Enabled then
                        for _, b in ipairs(g:GetDescendants()) do
                            if (b:IsA("TextButton") or b:IsA("ImageButton")) and reallyVisible(b) then
                                local t = (b:IsA("TextButton") and b.Text ~= "" and b.Text) or ""
                                for _, l in ipairs(b:GetDescendants()) do
                                    if l:IsA("TextLabel") and l.Visible and l.Text ~= "" then
                                        t = t .. (t ~= "" and " | " or "") .. l.Text
                                    end
                                end
                                if t ~= "" then table.insert(seen, g.Name .. " → " .. t) end
                            end
                        end
                    end
                end
                warn("[AE Enter] 🔍 ปุ่มที่เห็นตอนนี้ (" .. #seen .. "):")
                for i = 1, math.min(#seen, 25) do warn("   " .. seen[i]) end
                return false
            end
        end
        print("[AE Enter] ✅ กด Start แล้ว — กำลังเข้าด่าน")
        return true
    end


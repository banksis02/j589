    local function aeCaptureRegistry()
        local reg
        pcall(function()
            local RC = require(game:GetService("ReplicatedStorage").Shared.ReplicaClient)
            for _, up in pairs(debug.getupvalues(RC.FromId)) do
                if type(up) == "table" then
                    for kk in pairs(up) do
                        if type(kk) == "number" then reg = up; break end
                    end
                    if reg then break end
                end
            end
        end)
        return reg
    end

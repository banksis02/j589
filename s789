    local sf
    for _, f in ipairs(s:GetDescendants()) do
        if f:IsA("ScrollingFrame") and f.Visible and f.AbsoluteSize.Y > 150 then
            if not sf or f.AbsoluteSize.Y > sf.AbsoluteSize.Y then sf = f end
        end
    end
    if not sf then return false end
    for step = 0, 14 do
        sf.CanvasPosition = Vector2.new(0, step * 150)
        task.wait(0.15)
        if findLabel(names) then return true end
    end
    sf.CanvasPosition = Vector2.new(0, 0)
    return false
end

-- ปุ่ม toggle มี UIGradient (ตัวบอกสีเขียว/แดง) — ใช้จับ ไม่พึ่งขนาดตายตัว
local function hasGradient(btn)
    for _, g in ipairs(btn:GetDescendants()) do
        if g:IsA("UIGradient") then return true end
    end
    return false
end

-- ⭐ หาปุ่ม toggle: อยู่แถวเดียวกับ label ทางขวา + มี UIGradient
--    ทน UI scale ต่างกัน (ใช้ความสูง label เป็นเกณฑ์ row ไม่ใช่เลขตายตัว 15/40)
local function findToggleButton(names)
    local s = player.PlayerGui:FindFirstChild("Settings")
    if not s then return nil end
    local label = findLabel(names)
    if not label then return nil end
    local lx, ly = label.AbsolutePosition.X, label.AbsolutePosition.Y
    local rowTol = math.max(label.AbsoluteSize.Y * 2, 22)   -- เกณฑ์แถว = 2 เท่าความสูง label
    local best, bestDx
    for _, btn in ipairs(s:GetDescendants()) do
        if btn:IsA("GuiButton") and btn.Visible and hasGradient(btn)
           and math.abs(btn.AbsolutePosition.Y - ly) < rowTol then
            local dx = btn.AbsolutePosition.X - lx
            if dx > 0 and (not bestDx or dx < bestDx) then best, bestDx = btn, dx end
        end
    end
    return best
end

local function getSettingState(names)
    local btn = findToggleButton(names)
    if not btn then return nil end
    for _, g in ipairs(btn:GetDescendants()) do
        if g:IsA("UIGradient") then
            local c = g.Color.Keypoints[1].Value
            local r, gr = c.R * 255, c.G * 255
            if gr > 200 and r < 200 then return "on" end
            if r > 200 and gr < 100 then return "off" end
        end
    end
    return nil
end

local function setSettingState(names, wantOn)
    local shown = names[1]
    local state = getSettingState(names)
    if state == nil then
        warn("[Exp Settings] ❌ ไม่เจอ/อ่านไม่ได้: " .. shown)
        return false
    end
    local wantState = wantOn and "on" or "off"
    if state == wantState then
        print("[Exp Settings] ✓ " .. shown .. " = " .. state .. " (ตรงแล้ว)")
        return true
    end
    fireBtn(findToggleButton(names))
    task.wait(0.6)
    local newState = getSettingState(names)
    print("[Exp Settings] 🔄 " .. shown .. ": " .. state .. " → " .. tostring(newState))
    return newState == wantState
end

local function closeSettings()
    local s = player.PlayerGui:FindFirstChild("Settings")
    if not s or not settingsOpen() then return true end
    -- ⭐ ปุ่ม X = มุมขวาบนสุด (ทน UI scale — ไม่พึ่งขนาดตายตัว)
    local best, bestScore
    for _, btn in ipairs(s:GetDescendants()) do
        if btn:IsA("GuiButton") and btn.Visible and btn.AbsoluteSize.X > 8
           and btn.AbsoluteSize.X < s.AbsoluteSize.X * 0.15 then   -- เล็กกว่า 15% ของกรอบ
            local score = btn.AbsolutePosition.X - btn.AbsolutePosition.Y   -- ขวาสุด+บนสุด
            if not bestScore or score > bestScore then best, bestScore = btn, score end
        end
    end
    if best then fireBtn(best); task.wait(1); if not settingsOpen() then return true end end
    return not settingsOpen()
end

-- ⭐ v9.31: รับ pref list ได้ (ค่าเริ่มต้น = EXP_SETTING_PREFS) — ให้ฟาร์มหลักเรียกใช้ชุดของมันเองได้
local function run(prefs)
    prefs = prefs or EXP_SETTING_PREFS
    print("[Exp Settings] ⚙️ เปิด Settings...")
    if not openSettings() then warn("[Exp Settings] ❌ เปิด Settings ไม่ได้"); return end
    task.wait(1.2)

    local okCount = 0
    for _, pref in ipairs(prefs) do
        local names = nameList(pref)
        if pref.tab then
            if not clickTab(pref.tab, pref.tabTH) then clickTab("All", "ทั้งหมด") end
            task.wait(0.5)
        end
        if not scrollToLabel(names) then
            clickTab("All", "ทั้งหมด"); task.wait(0.5); scrollToLabel(names)
        end
        if setSettingState(names, pref.want) then okCount = okCount + 1 end
        task.wait(0.4)
    end

    closeSettings()
    print(("[Exp Settings] ✅ เสร็จ (%d/%d ตั้งค่าเรียบร้อย)"):format(okCount, #prefs))
end


                        local rewardsList = (#s.rewards > 0) and table.concat(s.rewards, ", ") or "N/A"
                        print("[AE Watcher " .. SCRIPT_VERSION .. "] " .. s.result
                            .. " | " .. s.stage
                            .. " | " .. s.clearTime
                            .. " | Rewards: " .. rewardsList)
                        sendAEDataToWeb(s)
                        lastSentEndScreenTime = tick()
                    end
                elseif not stats then
                    lastState = false
                end
            end)
            task.wait(1)
        end
    end)

    -- หาตัวเงินที่ user มี (SANKZU หรือ ChefBum)
    local function findMySilverUnit()
        for _, name in ipairs(SILVER_UNIT_NAMES) do
            local slot = findSlotByUnitName(name)
            if slot then return name, slot end
        end
        return nil, nil
    end

    -- หา slot ที่ไม่ใช่ตัวเงิน (ตัวดาเมจ)
    local function findDamageSlots()
        local silverSlots = {}
        for _, name in ipairs(SILVER_UNIT_NAMES) do
            local s = findSlotByUnitName(name)
            if s then silverSlots[s] = true end
        end
        local bh = player.PlayerGui:FindFirstChild("BottomHUD")
        if not bh then return {} end
        local slots = {}
        local count = 0
        for _, tb in ipairs(bh:GetDescendants()) do
            if tb:IsA("TextButton") then
                local hasVPF = false
                for _, d in ipairs(tb:GetChildren()) do
                    for _, dd in ipairs(d:GetDescendants()) do
                        if dd:IsA("ViewportFrame") then hasVPF = true; break end
                    end
                    if hasVPF then break end
                end
                if hasVPF then
                    count = count + 1
                    if not silverSlots[count] then
                        table.insert(slots, count)
                    end
                end
            end
        end
        return slots
    end

    -- ============================================================
    -- [AE] ⭐ ระบบวางออโต้ตามเส้นทางมอน (ไม่ต้องฟิคจุด — ใช้ได้ทุกด่าน)
    --   เส้นจาก workspace.Map.Paths (waypoints ของเกม) 0%→100%
    --   ตัวเงิน SANKZU x3 + ChefBum x1 ที่ 8-26% → ตัวดาเมจคิวสลับโซน
    --   ดัก70% / กลาง45% / สังหาร6-20% + ตรวจลิมิตจริง (รองรับ Unbound)
    -- ============================================================
    local AP_MONEY = {
        { name = "SANKZU",  count = 3 },
        { name = "ChefBum", count = 1 },
    }
    local AP_MONEY_PCTS  = { 0.08, 0.14, 0.20, 0.26 }
    local AP_CAP_PER_UNIT = 3
    local AP_PLACE_DELAY  = 3
    local AP_ZONE_PLAN = {
        { "ดัก",    0.70 }, { "กลาง", 0.45 }, { "สังหาร", 0.08 },
        { "ดัก",    0.73 }, { "กลาง", 0.48 }, { "สังหาร", 0.12 },
        { "กลาง",  0.42 }, { "สังหาร", 0.16 }, { "สังหาร", 0.10 },
        { "ดัก",    0.76 }, { "กลาง", 0.51 }, { "สังหาร", 0.20 },
        { "สังหาร", 0.14 }, { "กลาง", 0.39 }, { "สังหาร", 0.18 },
        { "สังหาร", 0.06 }, { "กลาง", 0.54 }, { "สังหาร", 0.22 },
    }
    local AP_SIDE_OFFSETS = { 6, -6, 9, -9, 4, -4, 12, -12 }

    local function buildAEPath()
        local pathsFolder = workspace:FindFirstChild("Map")
        pathsFolder = pathsFolder and pathsFolder:FindFirstChild("Paths")
        if not pathsFolder then return nil end
        local lane = pathsFolder:FindFirstChildOfClass("Folder")
        if not lane then return nil end
        local parts = {}
        for _, p in ipairs(lane:GetChildren()) do
            if p:IsA("BasePart") and tonumber(p.Name) then
                table.insert(parts, p)
            end
        end
        if #parts < 2 then return nil end
        table.sort(parts, function(a, b)
            return tonumber(a.Name) < tonumber(b.Name)
        end)
        local pts, cum = {}, { 0 }
        for i, p in ipairs(parts) do
            pts[i] = p.Position
            if i > 1 then
                cum[i] = cum[i - 1] + (pts[i] - pts[i - 1]).Magnitude
            end
        end
        return { pts = pts, cum = cum, total = cum[#cum] }
    end

    local function apPosAt(path, d)
        d = math.clamp(d, 0, path.total)
        for i = 2, #path.pts do
            if path.cum[i] >= d then
                local segLen = path.cum[i] - path.cum[i - 1]
                local t = segLen > 0 and (d - path.cum[i - 1]) / segLen or 0
                return path.pts[i - 1]:Lerp(path.pts[i], t)
            end
        end
        return path.pts[#path.pts]
    end

    local function apDirAt(path, d)
        d = math.clamp(d, 0, path.total)
        for i = 2, #path.pts do
            if path.cum[i] >= d then
                local v = path.pts[i] - path.pts[i - 1]
                if v.Magnitude > 0 then return v.Unit end
            end
        end
        return Vector3.new(0, 0, 1)
    end

    local function apUnitCount()
        local u = workspace:FindFirstChild("Units")
        return u and #u:GetChildren() or 0
    end

    -- วางเยื้องข้างถนน สลับซ้าย/ขวา + เช็คติดจริงจาก workspace.Units
    local function apPlaceSmart(path, slot, d)
        local base = apPosAt(path, d)
        local dir = apDirAt(path, d)
        local perp = Vector3.new(-dir.Z, 0, dir.X)
        for _, off in ipairs(AP_SIDE_OFFSETS) do
            local p = base + perp * off
            local before = apUnitCount()
            placeUnit(slot, CFrame.new(p.X, p.Y, p.Z, 1, 0, 0, 0, 1, 0, 0, 0, 1))
            task.wait(0.8)
            if apUnitCount() > before then
                return true, off
            end
        end
        return false
    end

    -- วางทั้งหมดตามระบบเส้นทาง — คืน true ถ้าทำงานได้
    local function smartPlaceAll(farmingActive)
        local path = buildAEPath()
        if not path then return false end
        print(("[AE Place] 🛣️ เส้นทาง %d จุด | ยาว %.0f studs"):format(#path.pts, path.total))

        -- แยก slot ตัวเงิน/ตัวดาเมจ
        local moneySlots, damageSlots, seen = {}, {}, {}
        for _, mu in ipairs(AP_MONEY) do
            local s = findSlotByUnitName(mu.name)
            if s then
                table.insert(moneySlots, { slot = s, name = mu.name, count = mu.count })
                seen[s] = true
            end
        end
        local bh = player.PlayerGui:FindFirstChild("BottomHUD")
        if bh then
            local count = 0
            for _, tb in ipairs(bh:GetDescendants()) do
                if tb:IsA("TextButton") then
                    local hasVPF = false
                    for _, d in ipairs(tb:GetChildren()) do
                        for _, dd in ipairs(d:GetDescendants()) do
                            if dd:IsA("ViewportFrame") then hasVPF = true; break end
                        end
                        if hasVPF then break end
                    end
                    if hasVPF then
                        count = count + 1
                        if not seen[count] then table.insert(damageSlots, count) end
                    end
                end
            end
        end
        print("[AE Place] 💰 ตัวเงิน " .. #moneySlots .. " | ⚔️ ตัวดาเมจ " .. #damageSlots .. " slot")

        -- (1) ตัวเงินก่อน
        local pctIdx = 1
        for _, mu in ipairs(AP_MONEY) do
            for _, ms in ipairs(moneySlots) do
                if ms.name == mu.name then
                    for c = 1, ms.count do
                        if farmingActive and not farmingActive() then return true end
                        local pct = AP_MONEY_PCTS[pctIdx] or 0.3
                        pctIdx = pctIdx + 1
                        local ok, off = apPlaceSmart(path, ms.slot, path.total * pct)
                        if ok then
                            print(("[AE Place] 💰 %s #%d @ %.0f%% (เยื้อง %d)"):format(ms.name, c, pct * 100, off))
                        else
                            print(("[AE Place] ⛔ %s #%d วางไม่ติด (ลิมิต?) — ไปต่อ"):format(ms.name, c))
                            break  -- ตัวเงินตัวนี้ชนลิมิต → ข้ามไปตัวถัดไป
                        end
                        task.wait(0.6)
                    end
                end
            end
        end

        if #damageSlots == 0 then
            warn("[AE Place] ⚠️ ไม่มีตัวดาเมจ")
            return true
        end

        -- (2) คิวสลับโซน + ตรวจลิมิตจริง
        local placedCount, maxed, failFresh = {}, {}, {}
        for _, s in ipairs(damageSlots) do
            placedCount[s] = 0
            failFresh[s] = 0
        end
        local function nextSlot()
            for _, s in ipairs(damageSlots) do
                if not maxed[s] and placedCount[s] < AP_CAP_PER_UNIT then return s end
            end
            return nil
        end
        local totalPlaced = 0
        for qi, entry in ipairs(AP_ZONE_PLAN) do
            if farmingActive and not farmingActive() then return true end
            local zone, pct = entry[1], entry[2]
            local done = false
            while not done do
                if farmingActive and not farmingActive() then return true end
                local slot = nextSlot()
                if not slot then
                    print(("[AE Place] ✅ งบวางหมด — วางไป %d ตัว จาก %d คิว"):format(totalPlaced, qi - 1))
                    return true
                end
                local ok, off = apPlaceSmart(path, slot, path.total * pct)
                if ok then
                    placedCount[slot] = placedCount[slot] + 1
                    totalPlaced = totalPlaced + 1
                    print(("[AE Place] ⚔️ [%s] slot %d @ %.0f%% (เยื้อง %d)"):format(zone, slot, pct * 100, off))
                    done = true
                elseif placedCount[slot] >= 1 then
                    maxed[slot] = true
                    print(("[AE Place] 🔒 slot %d ถึงลิมิต (Unbound?) — วางแล้ว %d ข้ามถาวร"):format(slot, placedCount[slot]))
                else
                    failFresh[slot] = failFresh[slot] + 1
                    if failFresh[slot] >= 2 then
                        maxed[slot] = true
                        print(("[AE Place] 🔒 slot %d วางไม่ได้เลย — ข้ามถาวร"):format(slot))
                    end
                end
            end
            task.wait(AP_PLACE_DELAY)
        end
        print(("[AE Place] ✅ วางครบทั้งแผน (%d ตัว)"):format(totalPlaced))
        return true
    end

    -- วางตัวทั้งหมดตาม stage
    local function placeAllForStage(stageName, farmingActive)
        -- ⭐ ระบบใหม่: วางตามเส้นทางอัตโนมัติ (ใช้ได้ทุกด่าน)
        local okSmart = false
        pcall(function() okSmart = smartPlaceAll(farmingActive) end)
        if okSmart then return true end

        -- fallback: จุดฟิคเดิม (เฉพาะด่านที่มี config)
        warn("[AE Farm] ⚠️ ระบบเส้นทางใช้ไม่ได้ → ใช้จุดฟิคเดิม")
        local cfg = getStageConfig(stageName)
        if not cfg then
            warn("[AE Farm] ❌ ไม่มี config สำหรับด่าน: " .. tostring(stageName))
            return false
        end

        -- 1) วางตัวเงิน (logic เดิม)
        local silverName, silverSlot = findMySilverUnit()
        if silverName and silverSlot then
            local positions = cfg.silver[silverName]
            if positions then
                print("[AE Farm] 🥈 วาง " .. silverName .. " (slot " .. silverSlot .. ") x" .. #positions)
                for _, cf in ipairs(positions) do
                    placeUnit(silverSlot, cf)
                    task.wait(1)
                end
            end
        else
            warn("[AE Farm] ⚠️ ไม่มีตัวเงินใน hotbar (ข้าม)")
        end

        -- 2) ⭐ วางตัวดาเมจตาม sequence (d = ตัวดาเมจลำดับที่ → map ไป slot ที่ไม่ใช่ตัวเงิน)
        -- เช่น ตัวเงินอยู่ slot 1-2 → damage 1 = slot 3, damage 2 = slot 4, damage 3 = slot 5
        local damageSlots = findDamageSlots()
        print("[AE Farm] ⚔️ damage slots: " .. table.concat(damageSlots, ", "))
        for _, step in ipairs(cfg.damageSeq or {}) do
            local slot = damageSlots[step.d]
            if slot then
                print("[AE Farm] ⚔️ Damage " .. step.d .. " → slot " .. slot)
                placeUnit(slot, step.cf)
                task.wait(1)
            else
                warn("[AE Farm] ⚠️ ไม่มี damage slot ลำดับ " .. step.d .. " (ข้าม)")
            end
        end
        return true
    end

    -- รอจน match จบ — เช็ค Prompt.Enabled + มี Victory/Defeat
    local function waitMatchEnd(farmingActive)
        while farmingActive() do
            local prompt = player.PlayerGui:FindFirstChild("Prompt")
            if prompt and prompt.Enabled then
                -- เช็คว่า Prompt นี้เป็น end screen (มี Victory/Defeat)
                task.wait(5)
                for _, d in ipairs(prompt:GetDescendants()) do
                    if d:IsA("TextLabel") and (d.Text == "Victory" or d.Text == "Defeat") then
                        return true
                    end
                end
            end
            -- fallback: RightGameHUD หาย = อาจกลับ lobby แล้ว
            local rh = player.PlayerGui:FindFirstChild("RightGameHUD")
            if not rh or not rh.Enabled then return true end
            task.wait(1)
        end
        return false
    end

    -- Farm main loop
    local farmingActive = false
    local farmMode = "act1"   -- ⭐ "act1" = ฟาร์มเพชร Act1 Hard | "actM" = ฟาร์มด่าน M
    local farmStage = "School Grounds"   -- ⭐ ด่านที่เลือกจาก dropdown ใน UI
    local function isFarmingActive() return farmingActive end

    local function startFarm(mode, stage)
        if farmingActive then return end
        farmingActive = true
        farmMode = mode or "act1"
        if stage then farmStage = stage end
        print("[AE Farm] ▶ เริ่มฟาร์ม (mode: " .. farmMode .. " | ด่าน: " .. farmStage .. ")")

        -- ⭐ v8.5: โหมด Expedition → ใช้ระบบ Expedition ทั้งชุด (ไม่ใช้ลูปฟาร์มปกติ)
        --    ความยาก/แมพ สั่งมาจากเว็บผ่าน _G.AE_EXP_DIFF / _G.AE_EXP_MAP
        if farmMode == "expedition" then
            _G.AE_EXP_ROTATE = false   -- ⭐ งาน expedition ปกติ = แมพเดียว
            if _G.AE_EXP_RUN then
                print(("[AE Farm] 🧭 Expedition: %s | ความยาก %s")
                    :format(tostring(_G.AE_EXP_MAP or "School Grounds"),
                            tostring(_G.AE_EXP_DIFF or 3)))
                pcall(_G.AE_EXP_RUN)
            else
                warn("[AE Farm] ❌ ไม่เจอระบบ Expedition (_G.AE_EXP_RUN)")
            end
            return
        end

        -- ⭐ v9.33 โหมด Expedition วนด่าน → วน School Grounds → Flower Forest → Rose Kingdom ด่านละ 1 ชม.
        if farmMode == "expedition_rotate" then
            _G.AE_EXP_ROTATE = true
            _G.AE_EXP_ROTATE_MIN = tonumber(_G.AE_EXP_ROTATE_MIN) or 60
            if _G.AE_EXP_RUN then
                print(("[AE Farm] 🔄 Expedition วนด่าน: %s | ด่านละ %s นาที | ความยาก %s")
                    :format(table.concat(_G.AE_EXP_ROTATE_MAPS or { "School Grounds", "Flower Forest", "Rose Kingdom" }, " → "),
                            tostring(_G.AE_EXP_ROTATE_MIN), tostring(_G.AE_EXP_DIFF or 3)))
                pcall(_G.AE_EXP_RUN)
            else
                warn("[AE Farm] ❌ ไม่เจอระบบ Expedition (_G.AE_EXP_RUN)")
            end
            return
        end

        -- ⭐ โหมด Villain Invasion → ใช้ระบบ Villain (Act 1/2/3 จากเว็บ _G.AE_VILLAIN_ACT)
        if farmMode == "villain" then
            if _G.AE_VILLAIN_RUN then
                print(("[AE Farm] 😈 Villain Invasion — Act %s"):format(tostring(_G.AE_VILLAIN_ACT or 1)))
                pcall(_G.AE_VILLAIN_RUN, tonumber(_G.AE_VILLAIN_ACT) or 1)
            else
                warn("[AE Farm] ❌ ไม่เจอระบบ Villain (_G.AE_VILLAIN_RUN)")
            end
            return
        end

        -- ⭐ โหมด ทำเควส (Bounty Board) → reroll<3★ → ทำ Legendary/Mythic → เคลม → Challenges → Gold Shop → fallback
        if farmMode == "quest" then
            if _G.AE_QUEST_RUN then
                print("[AE Farm] 🎯 โหมดทำเควส (Bounty Board)")
                pcall(_G.AE_QUEST_RUN)
            else
                warn("[AE Farm] ❌ ไม่เจอระบบเควส (_G.AE_QUEST_RUN) — โหลดสคริปต์ยังไม่ครบ")
            end
            return
        end
        -- ⭐ เช็คว่า Victory UI ยังเปิดอยู่ไหม (ห้ามวางตัวถ้าเปิด)
        local function isVictoryOpen()
            local prompt = player.PlayerGui:FindFirstChild("Prompt")
            if not prompt or not prompt.Enabled then return false end
            for _, d in ipairs(prompt:GetDescendants()) do
                if d:IsA("TextLabel") and (d.Text == "Victory" or d.Text == "Defeat") then
                    return true
                end
            end
            return false
        end

        -- ⭐ เช็คแบนเนอร์ "Restarting server in ..." — ช่วงนี้เกมบล็อกรีเพล (กดมือก็ไม่ได้)
        local function serverRestarting()
            local found = false
            pcall(function()
                for _, l in ipairs(player.PlayerGui:GetDescendants()) do
                    if l:IsA("TextLabel") and l.Visible
                       and l.Text:lower():find("restarting server") then
                        found = true
                        break
                    end
                end
            end)
            return found
        end

        local function rejoinServer()
            print("[AE Farm] 🔁 ย้ายเซิร์ฟเวอร์ (server กำลังรีสตาร์ท/รีเพลค้าง)...")
            pcall(function()
                game:GetService("TeleportService"):Teleport(game.PlaceId, player)
            end)
            task.wait(15)
        end

        local victoryStuck = 0
        local carrySent = false   -- ⭐ ส่งข้อมูลของ Victory ปัจจุบันไปแล้วหรือยัง (กันส่งซ้ำ)
        task.spawn(function()
            while farmingActive do
                local stage, mode, diff = getStageInfo()

                -- ⭐ โหมด carry (งานการันตี/เรท): ห้ามวาปเข้าด่าน ห้ามกดรีเพล
                --    ตัวแบกเป็นคนพาเข้า+กดรีเพล เราแค่วางตัว + รายงานผลจบด่าน
                if farmMode == "carry" then
                    if isVictoryOpen() then
                        -- จบด่านแล้ว → ส่ง "ครั้งเดียวต่อ Victory" (flag กันส่งซ้ำเด็ดขาด)
                        if not carrySent then
                            task.wait(1)
                            local s = getEndScreenData()
                            if s then
                                carrySent = true   -- mark ทันที (กัน loop เข้ามาซ้ำ)
                                local rewardsList = (#s.rewards > 0) and table.concat(s.rewards, ", ") or "N/A"
                                print("[AE Carry] 📤 " .. s.result .. " | " .. s.stage .. " | " .. rewardsList)
                                sendAEDataToWeb(s)
                                lastSentEndScreenTime = tick()
                            end
                        end
                        task.wait(3)   -- รอตัวแบกจัดการ
                    elseif not stage then
                        carrySent = false   -- ออก lobby → พร้อมส่งรอบใหม่
                        task.wait(5)
                    else
                        carrySent = false   -- อยู่ในด่าน (รอบใหม่) → พร้อมส่ง Victory ถัดไป
                        -- อยู่ในด่าน → วางตัวตามเส้นทาง แล้วรอจบ
                        print("[AE Carry] 🎯 อยู่ในด่าน: " .. stage .. " → วางตัว")
                        placeAllForStage(stage, isFarmingActive)
                        print("[AE Carry] ⏳ วางเสร็จ รอ match จบ (ตัวแบกคุมจังหวะ)")
                        waitMatchEnd(isFarmingActive)
                    end
                    task.wait(2)

                elseif isVictoryOpen() then
                    -- ⭐ Victory ค้างอยู่ → พยายามปิดก่อน ห้ามวางตัวเด็ดขาด
                    print("[AE Farm] ⚠️ Victory UI ยังค้าง → retry Restart + click ปุ่ม")
                    fireRestart()
                    task.wait(2)
                    if isVictoryOpen() then
                        clickRepeatStageButton()
                        task.wait(3)
                    end
                    victoryStuck = victoryStuck + 1
                    -- ⭐ เซิร์ฟกำลังรีสตาร์ท หรือรีเพลค้างเกิน 5 รอบ → ย้ายเซิร์ฟหนีเลย
                    if isVictoryOpen() and (serverRestarting() or victoryStuck >= 5) then
                        rejoinServer()
                        victoryStuck = 0
                    end
                elseif not stage then
                    victoryStuck = 0
                    print("[AE Farm] 🚀 ไม่อยู่ในเกม (lobby)")
                    local entered
                    -- ⭐ v9.20: ไม่ตั้งค่าที่ล็อบบี้แล้ว → [1] คราฟ Grey ให้หมด → [2] เข้าด่าน
                    if farmMode == "actM" then
                        -- [2] เปิดหน้าคราฟ → คราฟ Grey ให้หมด (ไม่รีบปิด เครื่องช้ารอได้)
                        --     autoCraftIfFull อ่าน Grey จริงจากหน้าคราฟ/กระเป๋า แล้วคราฟจนหมดเอง
                        print("[AE Farm] 🌈 [2] เปิดหน้าคราฟ → คราฟ Grey ให้หมด...")
                        pcall(autoCraftIfFull)
                        greyKnown = 0   -- คราฟหมดแล้ว → รีเซ็ตตัวนับ เริ่มนับใหม่
                        greyKnownSynced = true
                        print("[AE Farm] ✅ [2] คราฟเสร็จ → รีเซ็ตตัวนับ Grey = 0")
                        task.wait(1)
                        -- [3] เข้าด่าน
                        print("[AE Farm] ▶️ [3] เข้าด่าน M")
                        entered = enterStageSequence(farmStage, "M", false)
                    else

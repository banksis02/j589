local function reallyVisible(o)
    local n = o
    while n and n:IsA("GuiObject") do
        if not n.Visible then return false end
        n = n.Parent
    end
    if n and n:IsA("ScreenGui") and not n.Enabled then return false end
    local cam = workspace.CurrentCamera
    if cam then
        local p, s, vp = o.AbsolutePosition, o.AbsoluteSize, cam.ViewportSize
        if s.X < 5 or s.Y < 5 then return false end
        if p.X + s.X < 0 or p.Y + s.Y < 0 or p.X > vp.X or p.Y > vp.Y then return false end
    end
    return true
end
local function btnText(b)
    local parts = {}
    if b:IsA("TextButton") and b.Text ~= "" then table.insert(parts, b.Text) end
    for _, l in ipairs(b:GetDescendants()) do
        if l:IsA("TextLabel") and l.Visible and l.Text ~= "" then table.insert(parts, l.Text) end
    end
    return (table.concat(parts, " | "):gsub("<[^>]->", ""))
end
local function findBtn(needle, exact)
    local want = needle:lower()
    local best, bestArea
    for _, g in ipairs(player.PlayerGui:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled then
            for _, b in ipairs(g:GetDescendants()) do
                if (b:IsA("TextButton") or b:IsA("ImageButton")) and reallyVisible(b) then
                    local t = btnText(b):lower()
                    local hit = exact and (t == want or (" "..t):find("| "..want.."$"))
                              or t:find(want, 1, true)
                    if hit then
                        local a = b.AbsoluteSize.X * b.AbsoluteSize.Y
                        if not bestArea or a > bestArea then best, bestArea = b, a end
                    end
                end
            end
        end
    end
    return best
end
-- กดปุ่มตามข้อความ — vimOnly=true คลิกพิกัดจริงอย่างเดียว (กัน require พัง ตอนกด Events)

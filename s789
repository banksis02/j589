local function notify(t,x,d) pcall(function() SG:SetCore("SendNotification",{Title=t,Text=x,Duration=d or 5}) end) end

local RESERVE   = 500000        -- ⭐ เก็บ gold ขั้นต่ำ (ซื้อได้ถ้าซื้อแล้วยังเหลือ > นี้)
local SHOP_KEY  = "GoldShop1"   -- key ร้านทองใน Shops
local SHOP_DATAKEY = "GoldShop" -- DataKey ของ replica ShopData ร้านทอง

local logSink
local logBuf = {}
local function L(s) s=tostring(s); print("[SHOP] "..s); table.insert(logBuf,s); if logSink then pcall(logSink,s) end end


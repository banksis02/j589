                            placed, routeDone = false, false
                            waitState("stage", 60)
                        else
                            L("[?] ค้างนอกด่าน → ลองกด Continue")
                            call("AE_EXP_CONTINUE")
                        end
                        otherSince = tick()
                    end
                    task.wait(2)
                end
            end)
            if not ok then L("❌ ลูปพัง: " .. tostring(err)) end
            task.wait(1)
        end

        stopCombat()
        L("⏹ FULL AUTO จบการทำงาน")
    end)
end


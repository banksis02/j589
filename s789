            end)
            if ok then print("[CARD] ✅ Voted GohanRift card", choice, "(Cooldown)")
            else warn("[CARD] ❌ Vote failed:", err) end
            return ok
        end

        while true do
            local now = tick()
            local container = getCardContainer()
            if container and (now - lastVoteTime > 5) then
                -- ลองหา Cooldown ก่อน
                local idx = findCooldownIndex(container) or findCooldownIndexByPosition(container)
                if idx then
                    voteCard(idx)
                    lastVoteTime = now
                else
                    warn("[CARD] ⚠️ ไม่เจอ Cooldown ใน card — fallback vote 1")
                    voteCard(1)
                    lastVoteTime = now
                end
            end
            task.wait(0.5)
        end
    end)


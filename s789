-- ============================================================
-- 🎲 สำรอง: ลูกค้าไม่มีตัวที่ฟิคไว้ → สุ่มวางบนรถเอง
--    เน้นจุด 2 (ท้ายรถ/ฝั่งบอสเกิด) จุด 1 (หัวรถ) วางแค่ 1-2 ตัวพอ
--    ห้ามวางกลางรถ (ที่รถจอด/ที่เดิน)
-- ============================================================
local FRONT_MAX   = 2      -- จุด 1 (หัวรถ) วางได้มากสุดกี่ตัว
local MID_EXCLUDE = 0.58   -- ⭐ กันกลางรถ 58% ของครึ่งความยาว (พื้นที่แดง = ห้ามวาง)

local function payloadPartSafe(name)
    local map = workspace:FindFirstChild("Map")
    local pm  = map and map:FindFirstChild("PayloadModel")
    return pm and (pm:FindFirstChild(name) or pm.PrimaryPart)
end

-- ฝั่งที่มอนมาเยอะ (= ฝั่งบอสเกิด) จากตำแหน่งมอนจริง
local function hotSideSign(area)
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return 1 end
    local sum, n = 0, 0
    for _, m in ipairs(enemies:GetChildren()) do
        local ok, p = pcall(function() return m:GetPivot().Position end)
        if ok and p then
            local lp = area.CFrame:PointToObjectSpace(p)
            if math.abs(lp.Z) < 400 then sum = sum + lp.Z; n = n + 1 end
        end
    end
    if n == 0 then return 1 end
    return (sum >= 0) and 1 or -1
end

-- สุ่มจุดบนรถในโซนที่ต้องการ: back = ฝั่งมอนเยอะ, front = อีกฝั่ง
local function randomPayloadCF(zone)
    local area = payloadPartSafe("UnitArea")
    local bse  = payloadPartSafe("Base")
    if not area then return nil end
    local y = bse and (bse.Position.Y + bse.Size.Y / 2 + 0.015) or area.Position.Y + 1.5
    local halfX = math.max(area.Size.X / 2 - 1.2, 0.4)
    local halfZ = math.max(area.Size.Z / 2 - 1.5, 0.6)
    local minZ  = halfZ * MID_EXCLUDE
    local hot   = hotSideSign(area)
    local dx = (math.random() * 2 - 1) * halfX
    local dz
    if zone == "mid" then
        -- ⭐ กลางรถ — ปกติห้ามวาง ยกเว้นตัวระยะไกลมาก (Elf Mage) ที่ยิงครอบทั้งรถ
        dz = (math.random() * 2 - 1) * (minZ * 0.8)
    else
        local sign = (zone == "front") and -hot or hot
        dz = sign * (minZ + math.random() * (halfZ - minZ))
    end
    local p  = (area.CFrame * CFrame.new(dx, 0, dz)).Position
    return CFrame.new(p.X, y, p.Z)
end
_G.AE_EXP_RANDCF = randomPayloadCF

-- วางตัวที่มีในช่องแบบสุ่ม (ใช้ตอนไม่มีตัวตามที่ฟิคไว้)
-- ⭐ ช่องตัวละคร "ในด่าน" (HotbarData ที่ PlacementAllowed / MaxSlots มากสุด)
--    ต่างจาก PlayerData.HotbarData ซึ่งเป็นทีมในล็อบบี้ (6 ช่อง)
local function gameHotbarSlots()
    if not registry then return {} end
    local bestData
    for _, rep in pairs(registry) do
        local ok, tok = pcall(function() return rep.Token end)
        if ok and tok == "HotbarData" then
            local okd, d = pcall(function() return rep.Data end)
            if okd and type(d) == "table" and type(d.Slots) == "table" then
                if d.PlacementAllowed == true then bestData = d; break end
                if not bestData or (tonumber(d.MaxSlots) or 0) > (tonumber(bestData.MaxSlots) or 0) then
                    bestData = d
                end
            end
        end
    end
    local out = {}
    if not bestData then return out end
    for k, v in pairs(bestData.Slots) do
        local n = tonumber(k)
        if n and type(v) == "table" and tostring(v.AssetType) == "Unit" then
            local id = type(v.ID) == "string" and v.ID or ""
            local asset = id:match('"Asset"%s*:%s*"([^"]+)"')      -- ตัวจ้าง (JSON)
            if asset and asset:find("Equipment") then
                for a in id:gmatch('"Asset"%s*:%s*"([^"]+)"') do
                    if not a:find("Equipment") then asset = a; break end
                end
            end
            asset = asset or id:gsub("#.*$", "")
            out[n] = { cost = tonumber(v.PlacementCost) or 0, asset = asset }
        end
    end
    return out
end


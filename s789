-- อ่านจากป้าย "Map Progress 6 / 10" (เห็นเฉพาะตอนเปิดแผนที่)
local function mapProgressUI()
    for _, g in ipairs(player.PlayerGui:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled then
            for _, l in ipairs(g:GetDescendants()) do
                if (l:IsA("TextLabel") or l:IsA("TextButton")) and l.Visible then
                    local a, b = tostring(l.Text):gsub("<[^>]->", ""):match("Map%s*Progress%s*(%d+)%s*/%s*(%d+)")
                    if a then return tonumber(a), tonumber(b) end
                end
            end
        end
    end
    return nil
end

-- ⭐ อ่านจาก GameState — ระวัง! NodeQueue = "โหนดที่เหลือ" ไม่ใช่ทั้งหมด
--    ของจริง: ทั้งหมด = NodeHistory + NodeQueue  (เดิมใช้ NodeQueue เป็นตัวหาร → 5/5 = จบรันมั่ว)
local function mapProgressState()
    local gs = getReplica("GameState")
    local d = gs and gs.Data
    if type(d) ~= "table" then return nil end
    local left, done = 0, 0
    if type(d.NodeQueue)   == "table" then for _ in pairs(d.NodeQueue)   do left = left + 1 end end
    if type(d.NodeHistory) == "table" then for _ in pairs(d.NodeHistory) do done = done + 1 end end
    local total = tonumber(d.TotalNodes)
    if not total or total <= 0 then total = done + left end
    if total <= 0 then return nil end
    return done, total
end

local function mapProgress()
    local a, b = mapProgressUI()
    if a then return a, b end
    return mapProgressState()
end
_G.AE_EXP_PROGRESS = mapProgress


local function rankOf(h)
    -- เทียบทั้งชื่อ asset (KenpachiEVO) และชื่อที่โชว์ในเกม (8th Sword (Berserk))
    local u = (tostring(h.unit) .. " " .. tostring(h.display or "")):lower()
    for i, p in ipairs(HIRE_PRIORITY) do
        if u:find(p:lower(), 1, true) then return i end
    end
    return HIRE_OTHERS and 100 or nil
end


--   การ์ดโผล่แล้วรัน:
--     _G.AE_CARD_LIST()  → อ่านการ์ด 3 ใบ (ชื่อ / สแต็ก / คำอธิบาย)
--     _G.AE_CARD_PICK(n) → กด Select Upgrade ใบที่ n (1-3)
--     _G.AE_CARD_BEST()  → เลือกใบที่ดีที่สุดตาม CARD_PRIORITY
--     _G.AE_CARD_AUTO()  → เฝ้าอัตโนมัติ (เกม auto-select ใน 10 วิ ต้องกดก่อน)
--     _G.AE_CARD_STOP()
--     _G.AE_CARD_DUMP()  → dump ละเอียด (ตอนเจอบัค)
--     _G.AE_CARD_SEEN()  → รายชื่อการ์ดทั้งหมดที่เคยเจอ (เอาไว้ตั้ง priority)
-- ============================================================
local MYGEN = _G.AE_SCRIPT_GEN   -- รุ่นสคริปต์ (โหลดใหม่ = ลูปเก่าตาย)
local player = game:GetService("Players").LocalPlayer
local VIM = game:GetService("VirtualInputManager")
local inset = game:GetService("GuiService"):GetGuiInset()

-- ============================================================
-- ⭐ ระบบให้คะแนนการ์ด
--   อันดับ 1 = เงิน (Yen)   อันดับ 2 = ดาเมจดอท (ยูตะตีติดดอท)   อันดับ 3 = เลือดรถ Payload
--   ให้คะแนนจาก "คำในชื่อ+คำอธิบาย" → การ์ดใหม่ที่ไม่เคยเจอก็คิดคะแนนได้
-- ============================================================
local WEIGHTS = {
    -- 🥇 เงิน
    { tag="💰 เงิน",    w=100, keys={"yen","money","gold","cash","income","coin","currency"} },
    -- 🥈 ดาเมจตัวละคร (มาแทนที่ดอท)
    { tag="⚔️ ดาเมจ",   w=80,  keys={"more damage","unit damage","attack damage","deal",
                                     "damage","critical","crit"} },
    -- 🥉 เลือดรถ
    { tag="❤️ เลือดรถ", w=60,  keys={"payload health","payload hp","restore","heal","repair",
                                     "payload"} },
    -- รองลงมา
    { tag="📏 ระยะ",    w=25,  keys={"range","reach"} },
    { tag="⚡ สปีด",    w=20,  keys={"attack speed","cooldown","faster","speed"} },
    -- 🔻 ดอท — ไม่เอาแล้ว (ให้คะแนนต่ำสุด เลือกก็ต่อเมื่อไม่มีอะไรดีกว่า)
    { tag="🔥 ดอท(ไม่เน้น)", w=8, keys={"damage over time","dot ","burn","burning","poison",
                                        "bleed","toxic","ignite","corrosion","decay","rot",
                                        "lingering","per second"} },
    { tag="🔮 อื่นๆ",   w=5,   keys={"health","buff","element"} },
}

-- ⭐ ชื่อการ์ดที่บังคับให้เอาก่อนเสมอ (บนสุด = ก่อน)
local CARD_PRIORITY = {
    "Extended Reach",   -- อันดับ 1 (+ระยะจาก buff ตัวอื่น)
    -- อันดับ 2 — การ์ด EXP (ชื่อต่างกันได้ จับจากคำอธิบาย)
    "exp gain",
    "player exp",
    "experience",
    "% exp",
}
local AVOID = {}         -- ชื่อการ์ดที่ไม่เอาเด็ดขาด

local SELECT_TEXT = "select upgrade"
local seenCards = {}     -- ชื่อการ์ดที่เคยเจอ

-- ---------- utils ----------
local function strip(s)                      -- ตัด rich text tag ออก
    s = tostring(s):gsub("<[^>]->", "")
    s = s:gsub("&lt;","<"):gsub("&gt;",">"):gsub("&amp;","&")
    return (s:gsub("^%s+",""):gsub("%s+$",""))
end
local function low(s) return strip(s):lower() end

local function clickHard(b)
    pcall(function() for _,c in ipairs(getconnections(b.MouseButton1Click)) do c:Fire() end end)
    pcall(function() for _,c in ipairs(getconnections(b.Activated)) do c:Fire() end end)
    task.wait(0.2)
    pcall(function()
        local cx = b.AbsolutePosition.X + b.AbsoluteSize.X/2
        local cy = b.AbsolutePosition.Y + b.AbsoluteSize.Y/2 + inset.Y
        VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
        task.wait(0.06)
        VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
    end)
end

local function isAncestor(a, d)
    local n = d
    while n do if n == a then return true end n = n.Parent end
    return false
end

-- ---------- หาปุ่ม Select Upgrade ----------
local function findSelectBtns()
    local out = {}
    local prompt = player.PlayerGui:FindFirstChild("Prompt")
    local scope = prompt or player.PlayerGui
    for _, b in ipairs(scope:GetDescendants()) do
        if b:IsA("GuiButton") and b.Visible and b.AbsoluteSize.X > 0 then
            local hit = b:IsA("TextButton") and low(b.Text):find(SELECT_TEXT, 1, true) ~= nil
            if not hit then
                for _, l in ipairs(b:GetDescendants()) do
                    if l:IsA("TextLabel") and low(l.Text):find(SELECT_TEXT, 1, true) then hit = true; break end
                end
            end
            if hit then table.insert(out, b) end
        end
    end
    table.sort(out, function(a,b) return a.AbsolutePosition.X < b.AbsolutePosition.X end)
    return out
end

-- ---------- หา "กล่องการ์ด" ของแต่ละปุ่ม (ใช้ common ancestor ของปุ่มทั้งหมด) ----------
local function cardRoots(btns)
    if #btns == 0 then return {} end
    if #btns == 1 then                       -- fallback: ขึ้นไป 3 ชั้น
        local n = btns[1]
        for _ = 1, 3 do if n.Parent and n.Parent:IsA("GuiObject") then n = n.Parent end end
        return { n }
    end
    -- แถวที่บรรจุปุ่มทุกใบ
    local row = btns[1].Parent
    while row do
        local all = true
        for i = 2, #btns do if not isAncestor(row, btns[i]) then all = false; break end end
        if all then break end
        row = row.Parent
    end
    if not row then return {} end
    -- การ์ด = ลูกตรงของ row ที่เป็นบรรพบุรุษของปุ่มนั้น
    local roots = {}
    for i, b in ipairs(btns) do
        local n = b
        while n and n.Parent ~= row do n = n.Parent end
        roots[i] = n or b
    end
    return roots
end

-- ---------- อ่านการ์ด 1 ใบ ----------
local function readCard(btn, root)
    local labels = {}
    for _, l in ipairs(root:GetDescendants()) do
        if l:IsA("TextLabel") and l.Visible then
            local t = strip(l.Text)
            if t ~= "" then
                table.insert(labels, { t = t, size = l.TextSize,
                    y = l.AbsolutePosition.Y, x = l.AbsolutePosition.X })
            end
        end
    end
    table.sort(labels, function(a, b)
        if math.abs(a.y - b.y) > 6 then return a.y < b.y end
        return a.x < b.x
    end)

    local title, stack, cur, max = nil, nil, nil, nil
    local descWords = {}
    local bestSize = -1
    for _, e in ipairs(labels) do
        local tl = e.t:lower()
        local a, b = e.t:match("^(%d+)%s*/%s*(%d+)$")
        if tl:find(SELECT_TEXT, 1, true) or tl:find("reroll", 1, true) then
            -- ข้าม
        elseif a then
            if not stack then stack, cur, max = e.t, tonumber(a), tonumber(b) end
        elseif e.size > bestSize then
            if title then table.insert(descWords, title) end   -- ตัวเก่ากลายเป็นคำอธิบาย
            bestSize, title = e.size, e.t
        else
            table.insert(descWords, e.t)
        end
    end
    local desc = table.concat(descWords, " "):gsub("%s+", " ")
    if title then seenCards[title] = true end
    return { btn = btn, root = root, title = title or "?", desc = desc,
             stack = stack, cur = cur, max = max, labels = labels }
end

local function listCards()
    local btns  = findSelectBtns()
    local roots = cardRoots(btns)
    local cards = {}
    for i, b in ipairs(btns) do
        if roots[i] then table.insert(cards, readCard(b, roots[i])) end
    end
    return cards
end

-- ---------- ให้คะแนน + เลือก ----------
local function scoreCard(c)
    local t = low(c.title .. " " .. c.desc)
    for _, a in ipairs(AVOID) do
        if t:find(low(a), 1, true) then return -9999, "🚫 ห้ามเอา" end
    end

    -- 1) ชื่อที่บังคับไว้ มาก่อนเสมอ
    for i, p in ipairs(CARD_PRIORITY) do
        if t:find(low(p), 1, true) then return 100000 - i, "📌 ลิสต์บังคับ #" .. i end
    end

    -- 2) หากลุ่มที่ตรง (เอากลุ่มคะแนนสูงสุดที่เจอ)
    local best, tag = 0, "❔ ไม่รู้จัก"

    -- ⭐ การ์ดดอทมักเขียนว่า "DoT Damage" → อย่าให้ไปนับเป็นกลุ่มดาเมจ
    --    เจอคำดอทเมื่อไหร่ = ล็อกเป็นกลุ่มดอท (คะแนนต่ำ) ทันที
    local DOT_KEYS = { "damage over time", "dot", "burn", "poison", "bleed", "toxic",
                       "ignite", "corrosion", "decay", "lingering", "per second" }
    for _, k in ipairs(DOT_KEYS) do
        if t:find(k, 1, true) then return 8 * 100 + 0, "🔥 ดอท(ไม่เน้น)" end
    end
    for _, g in ipairs(WEIGHTS) do
        for _, k in ipairs(g.keys) do
            if t:find(k, 1, true) and g.w > best then best, tag = g.w, g.tag; break end
        end
    end

    -- 3) ตัวเลข % ในการ์ด ใช้ตัดสินตอนกลุ่มเท่ากัน (เช่น +15% ชนะ +10%)
    local pct = 0
    for n in t:gmatch("%+(%d+)%%") do pct = math.max(pct, tonumber(n) or 0) end
    for n in t:gmatch("%+(%d+)")   do pct = math.max(pct, math.min(tonumber(n) or 0, 99)) end

    local s = best * 100 + pct

    -- 4) สแต็ก: ยังไม่เต็ม = ดี / เต็มแล้ว = เลือกไม่ได้ผล
    if c.cur and c.max then
        if c.cur >= c.max then s = s - 50000; tag = tag .. " (เต็มแล้ว)"
        elseif c.cur > 0  then s = s + 150;   tag = tag .. " (ต่อสแต็ก)" end
    end
    return s, tag
end

local function pickBest()
    local cards = listCards()
    if #cards == 0 then return false end
    local best, bestScore, bestI, bestTag = nil, -math.huge, 0, ""
    for i, c in ipairs(cards) do
        local s, tag = scoreCard(c)
        -- ⭐ โชว์ทั้ง 3 ใบเสมอ จะได้ตรวจได้ว่าทำไมเลือกใบนี้
        print(("[Card]    ใบ %d: %-22s %-5s %-18s score=%d"):format(
            i, c.title, c.stack or "", tag, s))
        if s > bestScore then best, bestScore, bestI, bestTag = c, s, i, tag end
    end
    print(("[Card] 🎴 เลือกใบ %d: %s %s  [%s]"):format(bestI, best.title, best.stack or "", bestTag))
    clickHard(best.btn)
    return true, best, bestTag
end

-- ---------- API ----------
_G.AE_CARD_LIST = function()

-- สุ่ม count ครั้ง (เท่าที่ currency พอ) — คืนจำนวนที่สุ่มจริง
function _G.AE_BOUNTY_SUMMON(count)
    count = tonumber(count) or 0
    if count <= 0 then L("count ต้อง > 0"); return 0 end
    L(("🎰 ต้องสุ่ม %d | villain %d, gem %d"):format(count, cur("VillainCurrency"), cur("Gem")))
    local done = 0
    for _, b in ipairs(BANNERS) do
        while done < count do
            local have = cur(b.cur)
            local canByCur = math.floor(have / COST)
            if canByCur <= 0 then break end                       -- currency หมดของ banner นี้
            local n = math.min(b.batch, count - done, canByCur)   -- ยิงเป็นก้อน
            if n <= 0 then break end
            if not fireSummon(b.key, n) then break end
            done = done + n
            L(("  ✅ %s x%d (%s เหลือ %d) รวม %d/%d"):format(b.key, n, b.cur, cur(b.cur), done, count))
            task.wait(0.6)   -- รอ server ประมวลผล + currency อัปเดต
        end
        if done >= count then break end
    end
    if done < count then
        L(("⚠️ สุ่มได้ %d/%d — currency หมด (ต้องฟาร์ม villain เติม)"):format(done, count))
    else
        L(("✅ สุ่มครบ %d"):format(done))
    end
    notify("🎰 Summon", ("สุ่ม %d/%d"):format(done, count), 5)
    return done
end


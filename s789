-- ⬆️ อัพเกรดเอง — เงินก่อน → ดาเมจ → ข้ามซัพ (ปิด auto-upgrade เกมก่อน)
-- ============================================================
-- unit ที่เราวางในสนาม (GameUnit replica) — ข้ามโคลนซัมมอน
local function getMyUnits()
    local mine, all = {}, {}
    if not registry then return mine end
    for _, rep in pairs(registry) do
        local ok, tok = pcall(function() return rep.Token end)
        if ok and tok == "GameUnit" then
            local okd, d = pcall(function() return rep.Data end)
            local isClone = okd and type(d) == "table" and (d.IsClone or d.Unupgradeable or d.HiddenUnitManager)
            if okd and type(d) == "table" and not isClone then
                local u = {
                    id = d.ID or d.Id, owner = tostring(d.Owner or ""),
                    asset = (d.UnitData and d.UnitData.Asset) or d.Asset or "",
                    upgrade = tonumber(d.Upgrade) or 0, maxUp = tonumber(d.MaxUpgrade) or 9,
                    cost = (d.NextStats and tonumber(d.NextStats.Cost)) or nil,
                }
                if u.id then
                    all[#all+1] = u
                    if u.owner == player.Name then mine[#mine+1] = u end
                end
            end
        end
    end
    return #mine > 0 and mine or all
end


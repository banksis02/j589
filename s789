            if hasParty then
                print("[AE Enter] ⏩ อยู่หน้า Private Party อยู่แล้ว → กด Start เลย")
                local startBtn = findBtnAnywhere("Start")
                if startBtn then
                    if fireButtonConns(startBtn) == 0 then

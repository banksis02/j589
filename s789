        -- 4: ใคโด loop toggle (ล็อบบี้, ทุก 60 วิ)
        local autoKd = makeToggle(btnKd, sKd, "kaido_state.txt", runKaido, "ใคโด", 60)

        -- 5-6: Action Flag Toggle (ล็อบบี้) — กด ON = ใช้ item 1 ครั้ง + แดงค้าง
        local autoNd = makeActionFlagToggle(btnNd, sNd, "naruto_door_state.txt", runNarutoDoor, "ประตูนารูโต๊ะ T4")
        local autoVd = makeActionFlagToggle(btnVd, sVd, "vegito_door_state.txt", runVegitoDoor, "ประตูเบจิโต้ T3")

        -- 7-8: Replay/NextMap flag toggle (ในเกม)
        local autoR  = makeFlagToggle(btnRp, sRp, "replay_state.txt",  "Replay",  "replay")
        local autoNm = makeFlagToggle(btnNm, sNm, "nextmap_state.txt", "NextMap", "nextMap")

        -- 9: คลิกกลางจอ loop toggle (ในเกม, ทุก 5 วิ)
        local autoCC = makeToggle(btnCC, sCC, "clickcenter_state.txt", clickCenter, "คลิกกลางจอ", 5)

        -- 10: แก้มัด loop toggle — สแกน Free Unit prompts ทุก 0.2 วิ
        local autoFU = makeToggle(btnFU, sFU, "freeunit_state.txt", freeUnit, "แก้มัด", 0.2)

        -- Hook MatchFinished → fire Replay/NextMap ตาม flag
        local LogServiceUI = game:GetService("LogService")
        local lastFireTime = 0

        -- หา MissionResultFrame โผล่มาแล้วหรือยัง (สู้ popup เช่น tamed beast)
        -- ⚠️ MissionResultFrame เป็น ScreenGui → ใช้ .Enabled (ไม่ใช่ .Visible)
        local function isResultVisible()
            local pg = game.Players.LocalPlayer:FindFirstChild("PlayerGui")
            local ui = pg and pg:FindFirstChild("GameUI")
            local mrf = ui and ui:FindFirstChild("MissionResultFrame")
            if not mrf then return false end
            local ok, result = pcall(function()
                if mrf:IsA("ScreenGui") then return mrf.Enabled end
                if mrf:IsA("GuiObject") then return mrf.Visible end
                return false
            end)
            return ok and result or false
        end

        -- ⭐ ปิด popup ที่บัง MissionResultFrame
        -- ScreenGui ที่มักโผล่บัง: Drops (item drop), UltraBossNotification, Resonance, etc.
        local VIM_UI = game:GetService("VirtualInputManager")
        local POPUP_NAMES = {
            "Drops",
            "UltraBossNotification",
            "Resonance",
            "UnrivaledGUI",
            "Dialogue",              -- ⭐ "Universal Gems Part" / cutscene popup
            "Rewards",
            "Finished",
            "BlackScreen",
        }

        local function forceDisablePopups()
            local closed = 0
            for _, name in ipairs(POPUP_NAMES) do
                local sg = player.PlayerGui:FindFirstChild(name)
                if sg then
                    -- ลองหาปุ่มปิด/skip/continue ใน popup ก่อน
                    local clicked = false
                    for _, btn in ipairs(sg:GetDescendants()) do
                        if btn:IsA("TextButton") or btn:IsA("ImageButton") then
                            local nm = btn.Name:lower()
                            local tx = (btn:IsA("TextButton") and btn.Text or ""):lower()
                            if nm:find("close") or nm:find("skip") or nm:find("continue")
                               or nm:find("ok") or nm:find("confirm") or nm:find("dismiss")
                               or tx:find("close") or tx:find("skip") or tx:find("continue")
                               or tx:find("ok") or tx:find("confirm") then
                                pcall(function()
                                    if firesignal then firesignal(btn.MouseButton1Click) end
                                end)
                                pcall(function()
                                    if firesignal then firesignal(btn.Activated) end
                                end)
                                clicked = true
                                break
                            end
                        end
                    end
                    -- fallback: disable ScreenGui เลย
                    if sg:IsA("ScreenGui") and sg.Enabled then
                        sg.Enabled = false
                        closed = closed + 1
                        print("[UI] 🚫 Force-closed popup:", name, clicked and "(via button)" or "(disabled)")
                    end
                end
            end
            return closed > 0
        end

        -- เช็ค popup ใดๆ ที่รู้จัก enabled อยู่
        local function anyPopupEnabled()
            for _, name in ipairs(POPUP_NAMES) do
                local sg = player.PlayerGui:FindFirstChild(name)
                if sg and sg:IsA("ScreenGui") and sg.Enabled then
                    return name
                end
            end
            return nil
        end

        local function dismissPopups(maxClicks)
            local cam = workspace.CurrentCamera
            if not cam then return false end
            for i = 1, maxClicks do
                -- ⭐ ปิด popup ที่รู้จัก "ก่อน" เสมอ (เพราะ Rewards/Drops ทับ MissionResult ได้)
                local popupName = anyPopupEnabled()
                if popupName then
                    print("[UI] 🔍 พบ popup blocking:", popupName, "→ ปิด")
                    forceDisablePopups()
                    task.wait(0.3)
                end

                -- เช็ค MissionResult — ถ้า visible และไม่มี popup ค้าง = พร้อม vote
                if isResultVisible() and not anyPopupEnabled() then
                    print("[UI] ✅ MissionResult พร้อมแล้ว (รอบ", i, ")")
                    return true
                end

                -- fallback: คลิกกลางจอ
                local size = cam.ViewportSize
                local cx, cy = size.X / 2, size.Y / 2
                VIM_UI:SendMouseButtonEvent(cx, cy, 0, true,  game, 0)
                task.wait(0.05)
                VIM_UI:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
                task.wait(0.5)
            end
            return isResultVisible() and not anyPopupEnabled()
        end

        local function waitForResultFrame(timeout)
            local elapsed = 0
            while elapsed < timeout do
                if isResultVisible() then return true end
                task.wait(0.3)
                elapsed = elapsed + 0.3
            end
            return false
        end

        local function fireVote(remoteName, label)
            -- ใช้ FindFirstChild ป้องกัน yield ค้าง ถ้า path ไม่มี
            local ok, err = pcall(function()
                local pkgs = RS_UI:WaitForChild("Packages", 5)
                if not pkgs then error("no Packages") end
                local idx = pkgs:WaitForChild("_Index", 5); if not idx then error("no _Index") end
                local knit = idx:WaitForChild("sleitnick_knit@1.7.0", 5):WaitForChild("knit", 5)
                local svc  = knit:WaitForChild("Services", 5):WaitForChild("WaveService", 5)
                local re   = svc:WaitForChild("RE", 5):WaitForChild(remoteName, 5)
                if not re then error("no remote " .. remoteName) end
                re:FireServer()
            end)
            if ok then print("[UI] ▶ " .. label .. " fired")
            else warn("[UI] ❌ " .. label .. " failed:", err) end
        end

        LogServiceUI.MessageOut:Connect(function(message)
            if not message:find("open MatchFinished") then return end
            local now = tick()
            if now - lastFireTime < 15 then return end
            lastFireTime = now

            task.spawn(function()
                -- คลิกกลางจอเพื่อปิด popup (tamed beast / item drop) ทีละอันจน MissionResultFrame โผล่
                local shown = dismissPopups(30)  -- คลิกได้สูงสุด 30 ครั้ง (~15 วิ)
                if not shown then
                    -- เผื่อ MissionResult โผล่ช้ากว่า popup หมด — รออีกหน่อย
                    shown = waitForResultFrame(10)
                end
                if not shown then
                    warn("[UI] MissionResultFrame ไม่โผล่ — ยังจะลองยิง")
                end
                task.wait(1.5) -- buffer ให้ vote UI ready

                -- ยิงซ้ำ 3 ครั้ง ห่างกัน 2 วิ กัน race กับ popup
                -- ⭐ ลำดับความสำคัญ: Replay > NextMap > Lobby(Kaido)
                local kaidoOn = loadFile("kaido_state.txt")
                for i = 1, 3 do
                    if autoFlags.replay then
                        fireVote("VoteReplay", "VoteReplay #" .. i)
                    elseif autoFlags.nextMap then
                        fireVote("NextMap", "NextMap #" .. i)
                    elseif kaidoOn then
                        fireVote("Lobby", "Lobby (Kaido auto) #" .. i)
                    else
                        break
                    end
                    task.wait(2)
                end
            end)
        end)

        -- Auto-restore toggle ที่เปิดไว้ก่อน rejoin
        task.wait(1)
        autoKd()  -- ใคโด (loop จะรันต่อ)
        autoNd()  -- ประตูนารูโต๊ะ T4 (แค่ visual)
        autoVd()  -- ประตูเบจิโต้ T3 (แค่ visual)
        autoR()   -- Replay
        autoNm()  -- NextMap
        autoCC()  -- คลิกกลางจอ (loop จะรันต่อ)
        autoFU()  -- แก้มัด (loop จะรันต่อ)
        print("[UI] Ready! PlaceId:", game.PlaceId)
    end
end


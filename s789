-- 🔁 เฝ้าตัวที่ยังไม่ได้วาง — วางซ้ำจนครบทุกตัว
--    เหตุ: โหนด Defense ตัวลงจากรถ / คิวที่จองไว้โดนยกเลิก / เงินไม่พอตอนแรก
--    พิกัดคำนวณจากตำแหน่งรถปัจจุบันเสมอ (liveCF) เลยวางกลางทางได้
-- ============================================================
-- ค่าวางของช่องนั้น (จาก HotbarData ในด่าน) — ใช้เช็คเงินก่อนยิงวาง
local function gameHotbarData()
    if not registry then return nil end
    local best
    for _, rep in pairs(registry) do
        local ok, tok = pcall(function() return rep.Token end)
        if ok and tok == "HotbarData" then
            local okd, d = pcall(function() return rep.Data end)
            if okd and type(d) == "table" and type(d.Slots) == "table" then
                -- hotbar ในด่าน = อันที่ช่องเยอะสุด (10 ช่อง) / วางได้
                if d.PlacementAllowed == true then return d end
                if not best or (tonumber(d.MaxSlots) or 0) > (tonumber(best.MaxSlots) or 0) then best = d end
            end
        end
    end
    return best
end

local function slotCost(slot)
    local d = gameHotbarData()
    if not d then return nil end
    local s = d.Slots[slot] or d.Slots[tostring(slot)]
    if type(s) ~= "table" then return nil end
    return tonumber(s.PlacementCost)
end

local keepOn = false
local function startPlaceKeeper()
    if keepOn then return end
    keepOn = true
    task.spawn(function()
        print("[Exp] 🔁 เฝ้าตัวที่ยังไม่ได้วาง (เรียงตามลำดับ + รอเงินพอค่อยวาง)")
        local lastTry, lastMsg = {}, 0
        while keepOn and MYGEN == _G.AE_SCRIPT_GEN do
            task.wait(3)
            local yen = getYen()

            -- 🎲 โหมดสุ่ม: ยังวางได้ไม่ครบทุกช่อง → วางเพิ่มเรื่อยๆ เมื่อเงินพอ
            local rep2 = getReplica("GamePlayerData")
            if _G.AE_EXP_RANDOM_MODE and rep2 then
                local hb = gameHotbarSlots()
                -- ⭐ ตัวไหนวางลงสนามแล้วบ้าง (เทียบด้วยชื่อ asset) → ช่องนั้นข้ามไป
                local mine = getMyGameUnits()
                local placedAsset, placedCount = {}, #mine
                for _, u in ipairs(mine) do
                    placedAsset[tostring(u.asset):lower():gsub("[^%w]", "")] = true
                end
                local left = {}
                for slot, info in pairs(hb) do
                    local key = tostring(info.asset or ""):lower():gsub("[^%w]", "")
                    if key ~= "" and not placedAsset[key] then left[slot] = info end
                end
                local nLeft = 0
                for _ in pairs(left) do nLeft = nLeft + 1 end
                if nLeft > 0 then
                    print(("[Exp] 🎲 ยังเหลือ %d ตัวยังไม่ได้วาง (เงิน ¥%d)"):format(nLeft, yen))
                    for slot, info in pairs(left) do
                        if not keepOn then break end
                        local a = info.asset or ""      -- ชื่อตัวในช่องนี้
                        if (info.cost or 0) <= yen then
                            -- ตัวหาเงิน/ระยะไกล → จุด 2 เสมอ (ห้ามยืนเดี่ยวหน้ารถ)
                            local zone = "back"
                            if isLongRange(a) then zone = "mid"
                            elseif not isFarmUnit(a) and placedCount >= 1
                                   and placedCount < FRONT_MAX + 1 then zone = "front" end
                            local cf = randomPayloadCF(zone)
                            if cf then
                                local zn = (zone == "back" and "จุด2") or (zone == "front" and "จุด1") or "กลางรถ"
                                print(("[Exp] 🎲 วางเพิ่ม %s (ช่อง %d ¥%d) → %s")
                                    :format(a ~= "" and a or "?", slot, info.cost or 0, zn))
                                selectSlot(slot)
                                task.wait(0.12)
                                pcall(function() rep2:FireServer("PlaceGameUnit", slot, cf) end)
                                yen = yen - (info.cost or 0)
                                placedCount = placedCount + 1
                                task.wait(0.5)
                            end
                        elseif tick() - lastMsg > 12 then
                            lastMsg = tick()
                            print(("[Exp] 💰 รอเงินวาง %s — ต้อง ¥%d มี ¥%d")
                                :format(a ~= "" and a or ("ช่อง " .. slot), info.cost or 0, yen))
                        end
                    end
                end
            end
            -- ⭐ ไล่ตามลำดับในลิสต์เสมอ: Cursed Student → Puppet → Ice Queen → ...
            --    ตัวไหนยังวางไม่ได้เพราะเงินไม่พอ → หยุดตรงนั้น เก็บเงินให้ตัวนั้นก่อน
            --    (โหมดสุ่มจัดการวางซ้ำด้านบนแล้ว — ข้ามลิสต์ฟิค)
            for _, e in ipairs(_G.AE_EXP_RANDOM_MODE and {} or EXP_PLACEMENTS) do
                if not keepOn then break end
                if not findMyUnit(e.assets) then
                    local slot = findSlotFor(e)
                    if not slot then
                        -- ลูกค้าไม่มีตัวนี้ในทีม → ข้ามไปตัวถัดไป
                    else
                        local cost = slotCost(slot) or 0
                        if cost > 0 and yen < cost then
                            if tick() - lastMsg > 10 then
                                lastMsg = tick()
                                print(("[Exp] 💰 รอเงินวาง %s — ต้อง ¥%d มี ¥%d (หยุดรอ ไม่วางตัวถัดไป)")
                                    :format(e.name, cost, yen))
                            end
                            break                       -- เก็บเงินให้ตัวนี้ ห้ามข้าม
                        end
                        if tick() - (lastTry[e.name] or 0) >= 5 then
                            lastTry[e.name] = tick()
                            local cf = liveCF(e)
                            print(("[Exp] 🔁 วาง %s (ช่อง %d ¥%d | มี ¥%d) → (%.1f, %.1f, %.1f)")
                                :format(e.name, slot, cost, yen,
                                        cf.Position.X, cf.Position.Y, cf.Position.Z))
                            placeOne(e)
                            yen = yen - cost
                            task.wait(0.4)
                        end
                    end
                end
            end
        end
        print("[Exp] ⏹️ หยุดเฝ้าการวางตัว")
    end)
end
local function stopPlaceKeeper() keepOn = false end


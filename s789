        end

        local placed      = false     -- วางตัวในด่านนี้แล้วหรือยัง
        local routeDone   = false     -- เลือกเส้นทาง + เริ่มเดินแล้วหรือยัง
        local runActive   = false     -- ⭐ กำลังเล่นอยู่ (ยังไม่แพ้/ชนะ) → ห้ามแตะแผนที่/รีเกม
        local lastGuard   = 0
        local mapOpenSince = nil       -- เวลาเริ่มเห็นแผนที่เปิดค้าง (ระหว่างเล่น)
        local lastState   = ""
        local otherSince  = tick()
        local failStreak  = 0

        while running and MYGEN == _G.AE_SCRIPT_GEN do
            local ok, err = pcall(function()
                -- ===== 🏁 จบรัน (Victory/Defeat) → อ่านผล + แจ้งเตือน + Repeat Stage =====
                if has("AE_EXP_ENDOPEN") and _G.AE_EXP_ENDOPEN() then
                    local res = _G.AE_EXP_ENDOPEN()
                    L("🏁 จบรัน: " .. tostring(res) .. " → อ่านผล + กด Repeat Stage")

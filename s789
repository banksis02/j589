    local function getSettingState(name)
        local btn = findToggleButton(name)
        if not btn then return nil end
        for _, g in ipairs(btn:GetDescendants()) do
            if g:IsA("UIGradient") then
                local c = g.Color.Keypoints[1].Value
                local r, gr = c.R * 255, c.G * 255
                if gr > 200 and r < 200 then return "on" end
                if r > 200 and gr < 100 then return "off" end
            end
        end
        return nil
    end

    local function setSettingState(name, wantOn)
        local state = getSettingState(name)
        if state == nil then
            warn("[AE Settings] ❌ ไม่เจอ/อ่านไม่ได้: " .. name)
            return false
        end
        local wantState = wantOn and "on" or "off"
        if state == wantState then
            print("[AE Settings] ✓ " .. name .. " = " .. state .. " (ตรงแล้ว)")
            return true
        end
        local btn = findToggleButton(name)
        fireButtonConns(btn)
        task.wait(0.6)
        local newState = getSettingState(name)
        print("[AE Settings] 🔄 " .. name .. ": " .. state .. " → " .. tostring(newState))
        return newState == wantState

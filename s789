        -- เรียงขวา→ซ้าย (เฟืองอยู่ทางขวา แต่ Exit ถูกกรองออกแล้ว)
        table.sort(btns, function(a, b) return a.AbsolutePosition.X > b.AbsolutePosition.X end)
        for _, btn in ipairs(btns) do
            fireButtonConns(btn)
            task.wait(1.2)
            if dismissExitConfirm() then
                -- ปุ่มนี้คือ Exit → ขึ้นบัญชีดำ ไม่กดอีกตลอด session

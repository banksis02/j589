                for _, d in ipairs(tb:GetChildren()) do
                    for _, dd in ipairs(d:GetDescendants()) do
                        if dd:IsA("ViewportFrame") then hasVPF = true; break end
                    end
                    if hasVPF then break end
                end
                if hasVPF then table.insert(slots, tb) end
            end
        end

        -- ค้นแต่ละ slot ว่า descendants มีชื่อยูนิต match
        for i, tb in ipairs(slots) do
            for _, d in ipairs(tb:GetDescendants()) do
                if d.Name:lower():find(lower) then
                    return i
                end
            end
        end
        return nil
    end


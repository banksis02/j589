-- ---------- สุ่มจุดวางบน Payload ----------
local function getUnitArea()
    local map = workspace:FindFirstChild("Map")
    local pm = map and map:FindFirstChild("PayloadModel")
    if not pm then return nil end
    return pm:FindFirstChild("UnitArea") or pm:FindFirstChild("Primary") or pm.PrimaryPart
end

local function unitsNear(pos, radius)
    local u = workspace:FindFirstChild("Units")
    if not u then return 0 end
    local n = 0
    for _, m in ipairs(u:GetChildren()) do
        local ok, p = pcall(function() return m:GetPivot().Position end)
        if ok and p and (p - pos).Magnitude <= radius then n = n + 1 end
    end
    return n
end

-- ⭐ ความสูงที่วางได้ = ผิวบนของ Base (ไม่ใช่ UnitArea ซึ่งต่ำกว่า 1.5)
--    ยืนยันจากของจริง: Base.topY = 1946.36 / จุดที่วางมือได้ = 1946.375
local function payloadTopY()
    local map = workspace:FindFirstChild("Map")
    local pm = map and map:FindFirstChild("PayloadModel")
    local base = pm and pm:FindFirstChild("Base")
    if base then return base.Position.Y + base.Size.Y / 2 + 0.015 end
    local area = getUnitArea()
    if area then return area.Position.Y + area.Size.Y / 2 + 1.5 end
    return nil
end

-- จุดที่วางไปแล้วรอบนี้ (workspace.Units ว่างเปล่าในโหมด Expedition เลยจำเอง)
local placedSpots = {}

-- ⭐ โซนวางบนรถ: หัวรถ (1) และท้ายรถ (2) เท่านั้น — ห้ามวางกลางรถ
--    กลางรถ = ช่วง |z| < MID_EXCLUDE เท่าของครึ่งความยาว
local MID_EXCLUDE  = 0.40   -- กันกลางรถ 40% ของครึ่งความยาว (ทั้งสองฝั่ง)
local HOT_SIDE_ODDS = 0.7   -- 70% วางฝั่งที่มอนมาเยอะ (ท้ายรถ/ฝั่งบอส)

-- ฝั่งไหนมอนเยอะ → ดูจากตำแหน่งมอนจริงเทียบแกนรถ
local function hotSideSign(area)
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil end
    local sum, n = 0, 0
    for _, m in ipairs(enemies:GetChildren()) do
        local ok, p = pcall(function() return m:GetPivot().Position end)
        if ok and p then
            local lp = area.CFrame:PointToObjectSpace(p)
            if math.abs(lp.Z) < 400 then sum = sum + lp.Z; n = n + 1 end
        end
    end
    if n == 0 then return nil end
    return (sum >= 0) and 1 or -1
end

local function randomPayloadCF()
    local area = getUnitArea()
    local y = payloadTopY()
    if not area or not y then return nil end
    local halfX = math.max(area.Size.X / 2 - 1.5, 0.5)
    local halfZ = math.max(area.Size.Z / 2 - 2.0, 0.5)
    local minZ  = halfZ * MID_EXCLUDE          -- ใกล้กว่านี้ = กลางรถ ห้ามวาง
    local hot   = hotSideSign(area)
    local best, bestGap = nil, -math.huge
    for _ = 1, 20 do
        local dx = (math.random() * 2 - 1) * halfX
        -- เลือกฝั่ง: เน้นฝั่งมอนเยอะ ถ้าไม่รู้ก็สุ่ม 50/50
        local sign
        if hot then sign = (math.random() < HOT_SIDE_ODDS) and hot or -hot
        else sign = (math.random() < 0.5) and 1 or -1 end
        local dz = sign * (minZ + math.random() * (halfZ - minZ))
        local p  = (area.CFrame * CFrame.new(dx, 0, dz)).Position
        local pos = Vector3.new(p.X, y, p.Z)
        -- ห่างจากตัวที่วางไปแล้ว (ทั้งที่จำไว้เอง และที่เจอใน workspace.Units)
        local gap = math.huge
        for _, sp in ipairs(placedSpots) do
            gap = math.min(gap, (Vector3.new(sp.X, 0, sp.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude)
        end
        if unitsNear(pos, 3) > 0 then gap = 0 end
        if gap >= 4 then return CFrame.new(pos) end
        if gap > bestGap then best, bestGap = CFrame.new(pos), gap end
    end
    return best
end

-- ---------- วางตัวบนรถ ----------
-- เช็คสำเร็จ 2 ทาง: (1) ช่องนั้นหายจาก hotbar  (2) มีตัวโผล่ใกล้จุดที่วาง
local function slotExists(slot)
    return scanSlots()[slot] ~= nil
end

local function placeOnPayload(slot, label)
    local gpd = getReplica("GamePlayerData")
    if not gpd then warn("[Hire] ❌ ไม่เจอ GamePlayerData"); return false end
    local hadSlot = slotExists(slot)
    for attempt = 1, 6 do
        local cf = randomPayloadCF()
        if not cf then warn("[Hire] ❌ ไม่เจอ UnitArea บน Payload"); return false end
        local before = unitsNear(cf.Position, 4)
        selectSlot(slot)
        task.wait(0.3)
        pcall(function() gpd:FireServer("PlaceGameUnit", slot, cf) end)
        print(("[Hire]    📤 ยิงวาง ช่อง %d → (%.2f, %.2f, %.2f)")
            :format(slot, cf.Position.X, cf.Position.Y, cf.Position.Z))
        task.wait(1.2)
        local gone = hadSlot and not slotExists(slot)
        if gone or unitsNear(cf.Position, 4) > before then
            table.insert(placedSpots, cf.Position)      -- จำไว้ กันวางทับรอบหน้า
            print(("[Hire] ✅ วาง %s (ช่อง %d) สำเร็จ %s")
                :format(label or "?", slot, gone and "(ช่องหายไปแล้ว)" or "(เจอตัวใหม่)"))
            return true
        end
        print(("[Hire] ↻ วางไม่ติด ลองจุดใหม่ (รอบ %d)"):format(attempt))
        task.wait(0.6)
    end
    warn("[Hire] ⚠️ วางไม่สำเร็จ (ช่อง " .. tostring(slot) .. ") → ลอง _G.AE_HIRE_AREA() ดูตัวเลข")
    return false
end

-- 🔍 ตรวจพื้นที่วางบนรถ (เทียบกับจุดที่วางมือได้จริง)
_G.AE_HIRE_AREA = function()
    local buf = {}
    local function p(s) print(s); table.insert(buf, s) end
    local map = workspace:FindFirstChild("Map")

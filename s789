                for _ in pairs(v) do n = n + 1 end
                p(("%s = <table %d>"):format(path, n))
                walk(v, path, depth + 1)
            else
                p(("%s = %s (%s)"):format(path, tostring(v), type(v)))
            end
        end
    end
    walk(gs.data.Helpers, "Helpers", 1)
    p("===== NPC ที่ checkpoint =====")
    for _, n in ipairs(getCheckpointNPCs()) do
        p(("  id=%s %s unit=%s name=%s"):format(tostring(n.id), n.part, n.unit, n.name))

            if L then
                lane = L
                print(("[Villain] 🎯 เลนที่มอนเดิน = '%s' (มอน %d/%d ตัวอยู่เลนนี้)"):format(L.name, sc, total))
                break
            end
            task.wait(1)
        end
        if not lane then
            -- ยังไม่เจอมอน → ใช้เลนแรกไปก่อน (เดี๋ยว round หลังหาใหม่)
            lane = lanes[1]
            print("[Villain] ⏳ ยังไม่เจอมอน → ใช้เลน '" .. lane.name .. "' ไปก่อน")
        end

        -- ⭐ วางทุกช่อง "เกาะกันแน่น" ที่ 55-65% ของเลนเดียว (ด่านยาก รวมพลัง)
        for round = 1, 40 do
            if not pileOn then break end
            -- อัปเดตเลนที่ถูกทุก 5 รอบ (เผื่อรอบแรกเดาผิด)
            if round % 5 == 0 then
                local L = findActiveLane(lanes)
                if L and L ~= lane then
                    lane = L
                    print("[Villain] 🔄 เปลี่ยนไปเลนที่มอนเยอะ = '" .. L.name .. "'")
                end
            end
            local slots = gameHotbarSlots()
            if #slots == 0 then task.wait(2); else
                local yen = 0
                pcall(function() local g = getReplica("GamePlayerData"); yen = g and g.Data and tonumber(g.Data.Yen) or 0 end)
                local didPlace = false
                for _, s in ipairs(slots) do
                    if not pileOn then break end
                    if s.cost <= yen then
                        -- เกาะกัน: จุดกลาง 60% + เยื้องเล็กน้อย (placeAt ลอง offset ให้อยู่แล้ว)
                        local frac = 0.55 + math.random() * 0.10   -- 55-65%
                        if placeAt(lane, s.slot, lane.total * frac) then
                            print(("[Villain] ✅ วาง%s ช่อง %d → เลน '%s' ~%.0f%% (¥%d)")
                                :format(s.money and "💰เงิน" or "⚔️ตัว", s.slot, lane.name, frac*100, s.cost))
                            yen = yen - s.cost
                            didPlace = true
                            task.wait(0.3)
                        end
                    end
                end
                if not didPlace then task.wait(2) end
            end
        end
        print("[Villain] 🏁 จบการวาง")
        pileOn = false
    end)
end

    -- ค้นหา token ใน registry ที่ให้มา — เอาตัวมี write_lib ก่อน (ยิงได้)
    local function aeSearchReplica(reg, token)
        if not reg then return nil end
        local cand
        for _, rep in pairs(reg) do
            local ok, t = pcall(function() return rep.Token end)
            if ok and t == token then
                if rawget(rep, "write_lib") then return rep end   -- ตัวเขียนได้ = ดีสุด
                cand = cand or rep
            end
        end
        return cand
    end

    local function aeGetReplica(token)
        -- ⭐ v9.30: เอาตัวที่ "ยิงได้" (write_lib) ไม่งั้นได้ read-only → FireServer พัง → fallback
        local r = aeSearchReplica(aeReplicaRegistry, token)
        -- ⭐ v9.34: ถ้าไม่เจอ "ตัวยิงได้" (write_lib) → registry อาจเก่าหลังเปลี่ยนแมตช์

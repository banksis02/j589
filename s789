    -- ========== End Screen (Prompt) Watcher — ส่งข้อมูลไปเว็บ ==========
    local function getEndScreenData()
        local prompt = player.PlayerGui:FindFirstChild("Prompt")
        if not prompt or not prompt.Enabled then return nil end
        local stats = {
            result = "N/A", clearTime = "N/A", yen = "N/A",
            kills = "N/A", damage = "N/A",
            stage = "N/A", mode = "N/A", difficulty = "N/A",
            rewards = {},  -- ⭐ list of {name, qty}
        }
        local hasEndText = false
        for _, d in ipairs(prompt:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text ~= "" then
                local t = d.Text
                if t == "Victory" or t == "Defeat" then
                    stats.result = t; hasEndText = true
                elseif t:find(" %- Act ") then stats.stage = t
                elseif t == "Story" or t == "Endless" or t == "Challenge" or t == "Raid" then stats.mode = t
                elseif t:find("Mode$") then stats.difficulty = t
                elseif t == "Clear Time" or t == "Total Yen" or t == "Total Kills" or t == "Total Damage" then
                    local parent = d.Parent
                    if parent then
                        for _, sib in ipairs(parent:GetChildren()) do
                            if sib:IsA("TextLabel") and sib ~= d and sib.Text ~= "" and sib.Text ~= t then
                                if t == "Clear Time" then stats.clearTime = sib.Text
                                elseif t == "Total Yen" then stats.yen = sib.Text
                                elseif t == "Total Kills" then stats.kills = sib.Text
                                elseif t == "Total Damage" then stats.damage = sib.Text end
                                break
                            end
                        end
                    end
                end
            end
        end

        -- ⭐ ดึง Gained Rewards จาก ScrollingFrame ที่มี frame ที่มี "Xx" pattern
        for _, sf in ipairs(prompt:GetDescendants()) do
            if sf:IsA("ScrollingFrame") then
                for _, frame in ipairs(sf:GetChildren()) do
                    if frame:IsA("Frame") then
                        local itemName, itemQty
                        for _, lbl in ipairs(frame:GetDescendants()) do
                            if lbl:IsA("TextLabel") and lbl.Text ~= "" then
                                local txt = lbl.Text
                                -- quantity: match "100x", "1,000x", "2x"
                                if txt:match("^[%d,]+x$") then
                                    itemQty = txt
                                -- name: skip Lvl/EXP/Gained/generic
                                elseif not txt:find("Lvl") and not txt:find("EXP")
                                    and not txt:find("Gained") and not txt:find("<font") then
                                    itemName = itemName or txt
                                end
                            end
                        end
                        if itemName and itemQty then
                            table.insert(stats.rewards, itemName .. " " .. itemQty)
                        end
                    end
                end
            end
        end

        if not hasEndText then return nil end
        return stats
    end

    local function sendAEDataToWeb(stats)
        local ts = os.date("!%Y-%m-%dT%H:%M:%SZ")
        local actFull = stats.stage
        if stats.mode ~= "N/A" then actFull = actFull .. " - " .. stats.mode end
        if stats.difficulty ~= "N/A" then actFull = actFull .. " " .. stats.difficulty end
        -- ⭐ ใช้ rewards ที่ได้จริง (Gem 100x, Gold 100x, ...)
        local rewardsStr = (#stats.rewards > 0) and table.concat(stats.rewards, ", ") or "N/A"
        local payload = {
            username     = player.Name,
            userId       = player.UserId,
            serviceName  = GAME_NAME,
            gameId       = GAME_ID,
            progress     = 0,
            currentStats = { level = 0, bp = 0 },
            matchInfo    = { map = stats.stage, wave = tonumber((stats.kills or ""):gsub(",","")) or 0 },
            endScreen    = {
                act      = actFull,
                file     = stats.stage,
                playTime = stats.clearTime,
                quantity = rewardsStr,      -- ⭐ rewards จริง
                damage   = stats.damage,
                yen      = stats.yen,
                kills    = stats.kills,
                result   = stats.result,
                rewards  = stats.rewards,   -- ⭐ list
            },
            recentLog = {
                act      = actFull,
                file     = stats.stage,
                playTime = stats.clearTime,
                quantity = rewardsStr,      -- ⭐ rewards จริง
                status   = stats.result == "Victory" and "COMPLETED" or "FAILED",
                time     = ts,
                rewards  = rewardsStr,      -- ⭐ rewards จริง
            },
        }
        local ok, resp = pcall(function()
            return HttpService:RequestAsync({
                Url = BACKEND_URL .. "/api/overload/update",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode(payload)
            })
        end)
        if ok and type(resp) == "table" and resp.Success then
            print("[AE] ✅ Sent to web!")
        else
            warn("[AE] ❌ Send FAIL:", type(resp) == "table" and resp.StatusCode or tostring(resp))
        end
    end


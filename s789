                    placeAllForStage(stage, isFarmingActive)
                    print("[AE Farm] ⏳ วางเสร็จ รอ match จบ...")
                    waitMatchEnd(isFarmingActive)
                    if farmingActive then
                        -- อ่าน data (ส่งเฉพาะถ้า watcher ยังไม่ส่ง — กันซ้ำ)
                        task.wait(1)
                        local s = getEndScreenData()
                        if s then

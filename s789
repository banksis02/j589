    while running and not inGame() and not endScreenUp() and tick()-t0 < enterT do task.wait(2) end
    if not inGame() and not endScreenUp() then QL("  ⚠️ ไม่เข้าด่านใน "..enterT.."s (ข้าม)"); return false end
    QL("  ▶ เข้าด่านแล้ว — เล่นจนจบ...")
    t0 = tick()
    while running and inGame() and tick()-t0 < playT do
        if endScreenUp() then QL("  🏁 เจอหน้าจบเกม → จบรอบ"); break end
        task.wait(3)
    end
    task.wait(2)
    return true
end

local function readBoard() return _G.AE_BOUNTY_READ and _G.AE_BOUNTY_READ() or nil end
local function bountyById(id)
    local board = readBoard(); if not board then return nil end
    for _,b in ipairs(board) do if b.id==id then return b end end
    return nil
end

-- ⭐ v9.50: หยุดทุกระบบเล่นก่อนเริ่มอันใหม่ (กันทับกัน — player เก่า + villain place/upgrade ค้าง)
local function stopAllGameplay()
    for _,fn in ipairs({ "AE_INF_STOP","AE_STORY_STOP","AE_RAID_STOP","AE_CHAL_STOP",
                         "AE_VILLAIN_RUN_STOP","AE_VILLAIN_PLACE_STOP","AE_VILLAIN_UPGRADE_STOP" }) do
        if _G[fn] then pcall(_G[fn]) end
    end
    task.wait(0.6)
    -- ⭐ v9.51: ต้อง "กลับล็อบบี้จริง" ก่อนเริ่มอันใหม่ (ไม่งั้นเข้าด่านผิด/ค้างหน้า Victory)
    --    backToLobby ปลอดภัย: เช็ค inLobby ก่อน คืนเร็วถ้าอยู่ล็อบบี้ + จัดการปุ่ม Exit/Confirm
    if (inGame() or endScreenUp()) and _G.AE_BACK_TO_LOBBY then
        QL("  🏠 ออกจากด่าน/หน้าจบเกม → กลับล็อบบี้ก่อน")
        pcall(_G.AE_BACK_TO_LOBBY)
        local t0 = tick()
        while (inGame() or endScreenUp()) and tick()-t0 < 30 do task.wait(2) end
    end
    task.wait(1)
end

-- ---------- ทำ 1 objective ----------
local function doObjective(o)
    stopAllGameplay()   -- ⭐ เคลียร์ระบบเก่า/ออกจากด่านฟามก่อน (ครั้งเดียว)
    if not running then return false end
    QL(("  🚪 อยู่ล็อบบี้แล้ว → กำลังนำทางเข้าด่านเควส (%s)..."):format(tostring(o.type)))
    if o.type == "Summon" then
        local need = tonumber(o.goal) or 1
        local total = 0   -- ⭐ v9.55: นับสะสมข้ามรอบ (ไม่ใช่ต่อ call)
        for attempt=1,6 do
            if not running then break end
            local want = need - total
            local done = 0
            if _G.AE_BOUNTY_SUMMON then local ok,r = pcall(_G.AE_BOUNTY_SUMMON, want); if ok then done = tonumber(r) or 0 end end
            total = total + done
            QL(("  🎰 Summon รวม %d/%d (+%d รอบ %d)"):format(total, need, done, attempt))
            if total >= need then break end
            -- currency ไม่พอ → ฟาร์ม Villain Act1 เก็บเหรียญ ~4 นาที แล้วกลับมาสุ่มต่อ
            QL("  🪙 currency ไม่พอ → ฟาร์ม Villain Act1 เก็บเหรียญ 4 นาที")
            if _G.AE_VILLAIN_RUN then pcall(_G.AE_VILLAIN_RUN, 1) end
            local t0=tick(); while running and tick()-t0<240 do task.wait(5) end
            if _G.AE_VILLAIN_RUN_STOP then pcall(_G.AE_VILLAIN_RUN_STOP) end
            task.wait(3)
            if _G.AE_BACK_TO_LOBBY then pcall(_G.AE_BACK_TO_LOBBY) end
            task.wait(6)
        end
        return true

    elseif o.type == "ClearWave" then
        local m = uiMap(o.map); local w = tonumber(o.wave) or 15
        QL(("  ⚔️ Infinite %s → wave %d"):format(m, w))
        if _G.AE_INF_RUN then pcall(_G.AE_INF_RUN, m, w) end
        return waitStageCycle(100, 900)   -- false = เข้าด่านไม่ได้

    elseif o.type == "FinishMap" then
        local gm = tostring(o.gamemode)
        if gm == "Raid" then
            local m, a = uiMap(o.map), actNum(o.actName)
            QL(("  🐉 Raid %s Act %d"):format(m, a))
            if _G.AE_RAID_RUN then pcall(_G.AE_RAID_RUN, m, a) end
            return waitStageCycle(100, 600)
        elseif gm == "Challenge" then
            local kind = (tostring(o.challengeType)=="Daily") and "Daily" or "Regular"
            QL(("  🏆 Challenge %s"):format(kind))
            if _G.AE_CHAL_RUN then pcall(_G.AE_CHAL_RUN, kind, 1) end
            return waitStageCycle(100, 600)   -- ⭐ false = ติด cooldown/เข้าไม่ได้ → ข้ามเควสนี้
        else  -- Story
            local m = uiMap(o.map)
            QL(("  📖 Story %s (%s)"):format(m, tostring(o.difficulty)))
            if _G.AE_STORY_RUN then pcall(_G.AE_STORY_RUN, m, 1) end
            return waitStageCycle(100, 600)
        end
    end
    QL("  ❓ objective ไม่รู้จัก: "..tostring(o.type))
    return false
end

-- ---------- ทำ 1 bounty (ทุก objective + เคลม) ----------
-- ⭐ v9.54: ObjectiveProgress ไม่น่าเชื่อถือ (นับสะสม → done หลอก) → ห้ามข้ามเพราะ done
--    กลยุทธ์: มี objective ที่ยัง "ไม่ done" → ทำมัน | ถ้าทุกตัวรายงาน done → ลองเคลม
--    ถ้าเคลมไม่ผ่าน (done หลอก จริงยังไม่เสร็จ) → ลงมือทำ objective จริงทุกตัว
local gaveUp = {}   -- ⭐ v9.60: เควสที่ทำครบทุก objective แล้วยังเคลมไม่ได้ (route ไม่ตรง/done หลอกที่ทำไม่ได้) → เลิกวนซ้ำ
local function tryClaim(id)
    if not _G.AE_BOUNTY_CLAIM then return false end
    pcall(_G.AE_BOUNTY_CLAIM, id); task.wait(2)
    local c = bountyById(id)
    return (not c) or c.claimed
end
local function doBounty(b)
    -- 🔎 v9.60 DIAG: โชว์ objective ทั้งหมดของเควสนี้ (type/cur/goal/done) — ดูว่าตัวไหน done หลอก
    local c0 = bountyById(b.id) or b
    local od = {}
    for _, o in ipairs(c0.objectives or {}) do
        od[#od+1] = ("%s %s(%s/%s)%s"):format(tostring(o.type), tostring(o.map or o.challengeType or ""),
            tostring(o.cur), tostring(o.goal), o.done and "✓" or "✗")
    end
    QL(("🎯 ทำเควส %s [★%d] — objective[%d]: %s"):format(b.id, b.rank, #(c0.objectives or {}), table.concat(od, " | ")))
    local n = #(c0.objectives or {})
    -- ⭐ v9.62: objective[0] = config เควสยังโหลดไม่ได้ → ข้ามรอบนี้ (ไม่ gaveUp, รอบหน้าลองใหม่ตอน config พร้อม)
    if n == 0 then QL("  ⚠️ objective[0] — config เควสยังไม่พร้อม → ข้ามรอบนี้ (ไม่เลิกถาวร)"); return end
    -- ⭐ v9.61: ทำ objective ทีละตัว "เรียงลำดับ" (ตัวที่ยังไม่ done) จนครบ → เคลม → จบเควสนี้
    for i = 1, n do
        if not running then return end
        local cur = bountyById(b.id); if not cur then return end
        if cur.completed or cur.claimed then break end
        local o = cur.objectives[i]
        if o and not o.done then
            QL(("  → objective %d/%d: %s"):format(i, n, tostring(o.text or o.type)))
            if not doObjective(o) then
                QL("  ⏭ objective นี้ยังทำไม่ได้ (cooldown/เข้าไม่ได้) → ข้ามเควสนี้ก่อน"); return
            end
        end
    end
    -- ครบทุก objective → เคลมรางวัล
    local cur = bountyById(b.id)
    if cur and not cur.claimed then
        if tryClaim(b.id) then QL("  ✅ เคลมรางวัลสำเร็จ")
        else QL("  ⚠️ ทำครบแล้วยังเคลมไม่ได้ → เลิกทำเควสนี้ (ไม่วนซ้ำ)"); gaveUp[b.id] = true end
    end
end

-- ---------- 1 รอบเควส: reroll<3★ → ทำ 3★+ ทุกอัน ----------
local function questCycle()
    local TH = tonumber(_G.AE_BOUNTY_DO_THRESHOLD) or 4   -- ⭐ ทำแค่ 4★ (Mythic)
    -- reroll ตัวต่ำกว่าเกณฑ์ — รอจน reroll จบจริง (busy flag) ไม่รอ 40s เปล่าเมื่อ reroll หมดโควต้า
    QL(("🎲 reroll เควสต่ำกว่า %d★..."):format(TH))
    if _G.AE_BOUNTY_REROLL_SUB then pcall(_G.AE_BOUNTY_REROLL_SUB) end
    local t0 = tick()
    while running and _G.AE_BOUNTY_REROLL_BUSY and tick()-t0 < 60 do task.wait(1) end
    -- ทำแต่ละ TH★+
    local board = readBoard()
    if not board then QL("❌ อ่าน board ไม่ได้"); return false end
    local didAny = false
    for _,b in ipairs(board) do
        if not running then break end
        if b.rank >= TH and not b.claimed and not gaveUp[b.id] then   -- ⭐ ข้ามเควสที่เลิกทำแล้ว
            if b.completed then
                if _G.AE_BOUNTY_CLAIM then pcall(_G.AE_BOUNTY_CLAIM, b.id); task.wait(2) end
            else
                doBounty(b); didAny = true
            end
        end
    end
    return didAny
end

-- ---------- ลอง Challenge ทุกตัว "รอบละ 1 ครั้ง" (มี cooldown ~10 นาที/ครบ limit = ข้าม) ----------
--   ครบ 10 รอบ/วัน จะทำได้เองเพราะวนกลับมาลองใหม่ทุกช่วง (สลับกับ fallback)
local function tryChallengesOnce()
    for idx=1,3 do
        if not running then return end
        QL(("  🏆 ลอง Regular #%d"):format(idx))
        stopAllGameplay()
        if _G.AE_CHAL_RUN then pcall(_G.AE_CHAL_RUN, "Regular", idx) end
        if waitStageCycle(45, 600) then task.wait(3)
        else QL(("  Regular #%d ยังไม่พร้อม (cooldown/ครบวันนี้) → ข้าม"):format(idx)) end
    end
    if not running then return end
    QL("  🏆 ลอง Daily")
    stopAllGameplay()
    if _G.AE_CHAL_RUN then pcall(_G.AE_CHAL_RUN, "Daily", 1) end
    waitStageCycle(45, 600)
end

-- ---------- fallback farm ----------
local function runFallback(fb)
    stopAllGameplay()   -- ⭐ เคลียร์ระบบเก่าก่อนเข้า fallback
    fb = tostring(fb or "villain")
    if fb=="villain" and _G.AE_VILLAIN_RUN then
        pcall(_G.AE_VILLAIN_RUN, tonumber(_G.AE_QUEST_FALLBACK_ACT) or 1)
    elseif fb=="expedition" and _G.AE_EXP_RUN then
        _G.AE_EXP_MAP = _G.AE_QUEST_FALLBACK_STAGE or "School Grounds"; _G.AE_EXP_DIFF = 3
        pcall(_G.AE_EXP_RUN)
    elseif fb=="story" and _G.AE_STORY_RUN then
        pcall(_G.AE_STORY_RUN, _G.AE_QUEST_FALLBACK_STAGE or "School Grounds", 1)
    else
        QL("⚠️ fallback ไม่รู้จัก/ไม่พร้อม: "..fb)
    end
end

-- ฟาม fallback เป็นช่วงเวลา (นาที) แล้วหยุด — ให้ challenge cooldown หมดพอดี
local function farmFallbackFor(mins)
    if not running then return end
    local fb = _G.AE_QUEST_FALLBACK_MODE or "villain"
    QL(("🌾 ฟาม fallback (%s) ~%d นาที (รอ challenge cooldown)"):format(tostring(fb), mins))
    runFallback(fb)   -- เริ่มฟาม (ลูป async)
    local t0 = tick()
    while running and tick()-t0 < mins*60 do task.wait(5) end
    stopAllGameplay()   -- หยุดฟามก่อนไปลอง challenge รอบใหม่
end

-- ---------- STOP ----------
_G.AE_QUEST_RUN_STOP = function()
    running = false; QL("⏹ หยุดโหมดทำเควส")
    for _,fn in ipairs({ "AE_INF_STOP","AE_STORY_STOP","AE_RAID_STOP","AE_CHAL_STOP","AE_VILLAIN_RUN_STOP" }) do
        if _G[fn] then pcall(_G[fn]) end
    end
end

-- ---------- RUN ----------
_G.AE_QUEST_RUN = function()
    if running then QL("กำลังทำงานอยู่"); return end
    running = true
    task.spawn(function()
        QL("🎯🎯 เริ่มโหมดทำเควส (Bounty Board)")
        notify("🎯 ทำเควส", "เริ่มทำเควสรายวัน", 5)
        -- เฟส 1: เควสรายวัน (ทำแค่ 4★) — หยุดเมื่อครบ หรือทำไม่คืบ 3 รอบติด
        local prevLeft, stall = math.huge, 0
        for cycle=1,25 do
            if not running or MYGEN ~= _G.AE_SCRIPT_GEN then break end
            local did = questCycle()
            local board = readBoard(); local left = 0
            local TH = tonumber(_G.AE_BOUNTY_DO_THRESHOLD) or 4
            if board then for _,b in ipairs(board) do if b.rank>=TH and not b.claimed then left=left+1 end end end
            QL(("📊 รอบ %d — เควส %d★+ ที่ยังไม่เคลมเหลือ %d"):format(cycle, TH, left))
            if left == 0 then QL("✅ เควสครบทุกอันแล้ว"); break end
            -- ⭐ v9.55: ถ้าจำนวนที่เหลือไม่ลดลง (ทำไม่คืบ/route ไม่ตรง/ติด cooldown) → กันวนเปล่า
            if left >= prevLeft then stall = stall + 1 else stall = 0 end
            prevLeft = left
            if stall >= 3 then
                QL("⚠️ ทำเควสไม่คืบ 3 รอบติด (route ไม่ตรง/ติด cooldown) → ไปเฟส 2 ก่อน เดี๋ยววนกลับมาใหม่")
                break
            end
            if not did then task.wait(10) end
        end
        if not running then return end
        -- ⭐ เฟส 2+: วนสลับ "ลอง Challenge (ที่พร้อม) → ซื้อ Trait Crystal (จนครบ 25/วัน) → ฟาม fallback ~10 นาที"
        --    Challenge มี cooldown ~10 นาที/รอบ + ครบ 10/วัน → ทยอยทำเองทุกช่วง จนหมดเวลาจ้าง
        QL("🔁 เฟส 2: วน เควส4★ค้าง + Challenge (cooldown ~10 นาที) + ซื้อ Trait Crystal + ฟาม fallback")
        notify("🎯 ทำเควส", "วนเควส + Challenge + ฟาม", 6)
        while running and MYGEN == _G.AE_SCRIPT_GEN do
            -- 0) กลับมาลองทำเควส 4★ ที่ยังค้าง (เมื่อก่อนติด cooldown/ทำไม่ได้ → ตอนนี้อาจทำได้แล้ว)
            questCycle()
            if not running then break end
            -- 1) ลอง challenge ทุกตัว (ตัวที่พ้น cooldown/ยังไม่ครบ = เข้าเล่น) — จบแล้วอยู่ล็อบบี้
            tryChallengesOnce()
            if not running then break end
            stopAllGameplay()   -- กลับล็อบบี้ (จำเป็นสำหรับอ่าน/ซื้อร้าน)
            -- 2) ซื้อ Trait Crystal — ซื้อเฉพาะเมื่อยังเหลือโควต้าวันนี้ (25/วัน) ไม่ใช่ทุกชั่วโมง
            local rem = _G.AE_SHOP_TRAIT_REMAIN and _G.AE_SHOP_TRAIT_REMAIN() or 0
            if rem and rem > 0 then
                QL(("🛒 ซื้อ Trait Crystal (เหลือโควต้าวันนี้ %d ชิ้น)"):format(rem))
                if _G.AE_SHOP_BUY then pcall(_G.AE_SHOP_BUY) end
            end
            if not running then break end
            -- 3) ฟาม fallback ~10 นาที (ให้ challenge cooldown หมดพอดี) แล้ววนกลับไปลองใหม่
            farmFallbackFor(10)
        end
        running = false
    end)
end


        return false
    end

    -- ⭐ ยิงวางเลย ไม่ต้องเช็ค/ลองซ้ำ — เงินไม่พอ เกมจะจองคิวไว้แล้ววางเองเมื่อเงินถึง
    local cf = liveCF(entry)
    selectSlot(slot)
    task.wait(0.12)
    pcall(function() rep:FireServer("PlaceGameUnit", slot, cf) end)
    print(("[Exp Place] 📤 %s (ช่อง %d)"):format(entry.name, slot))
    task.wait(0.2)      -- เว้นจังหวะเล็กน้อย กันยิง remote ถี่เกิน
    return true
end


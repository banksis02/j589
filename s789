                    if has("AE_EXP_CLOSEMAP") then call("AE_EXP_CLOSEMAP") end
                    task.wait(1.5)

                -- ===== ⚔️ อยู่ในด่าน — วางตัว + เล่นต่อเนื่อง (ไม่เปิดแผนที่/ไม่เช็ค 10/10) =====
                elseif state == "stage" then
                    -- ⭐ v9.33 โหมดวนด่าน: เริ่มจับเวลาด่านนี้ (ครั้งแรกที่เข้าด่าน)
                    if _G.AE_EXP_ROTATE and not rotMapStart then
                        rotMapStart = tick()
                        L(("🔄 เริ่มจับเวลาด่าน %s (ครบ %d นาที = เปลี่ยนด่าน)")
                            :format(expMap(), rotMinutes()))
                    end
                    -- ⭐ ครบเวลา → กลับล็อบบี้ เปลี่ยนไปด่านถัดไปในลิสต์
                    if _G.AE_EXP_ROTATE and rotMapStart
                       and (tick() - rotMapStart) >= rotMinutes() * 60 then
                        stopCombat()
                        local maps = rotMaps()
                        rotIdx = (rotIdx % #maps) + 1
                        rotMapStart = nil
                        placed, routeDone, runActive = false, false, false
                        L(("🔄 ครบ %d นาที → กลับล็อบบี้ เปลี่ยนไปด่าน %s")
                            :format(rotMinutes(), maps[((rotIdx - 1) % #maps) + 1]))
                        uiHide(true)
                        if _G.AE_BACK_TO_LOBBY then pcall(_G.AE_BACK_TO_LOBBY) end
                        uiHide(false)
                        otherSince = tick()   -- ให้ลูปล็อบบี้รอ 20 วิ ก่อนเข้าด่านใหม่
                        task.wait(2)
                        return
                    end
                    -- [1] ตั้งค่าก่อน: ปิด Auto-Upgrade / Auto Retry / Auto Next
                    if not settingsDone and has("AE_EXP_SETTINGS") then
                        L("[1] ตั้งค่า: ปิด Auto-Upgrade / Auto Retry / Auto Next")
                        call("AE_EXP_SETTINGS")
                        settingsDone = true
                        task.wait(1)
                    end
                    -- [2] วางตัว + อัพเกรด + เฝ้ากด Continue (เล่นไปเรื่อยๆ)
                    if not placed then
                        if has("AE_EXP_RESETRUN") then call("AE_EXP_RESETRUN") end
                        L("[2] วางตัวละคร + อัพเกรด + เฝ้ากด Continue")
                        call("AE_EXP_PLACE")
                        call("AE_EXP_PRIORITY")
                        call("AE_EXP_UPGRADE")
                        call("AE_EXP_AUTOCONT")
                        call("AE_EXP_KEEPER")
                        placed = true
                        L("   ✅ ระบบในด่านทำงานครบแล้ว")
                    else
                        task.wait(3)                     -- ปล่อยให้ลูปในด่านทำงาน
                    end

                -- ===== 🏠 ล็อบบี้ → เข้าด่านใหม่ =====
                else
                    -- ⭐ ต้องนิ่งจริงว่าอยู่ล็อบบี้ (เช็คซ้ำอีกครั้ง) ก่อนจะวาปเข้าด่าน
                    --    กันเคส wave 0 ที่สถานะยังอ่านไม่ออกแล้ววาปซ้ำจนพัง
                    if tick() - otherSince > 20 and call("AE_EXP_STATE") == "other" then
                        if has("AE_ENTER_RUN") then
                            L(("[0] อยู่ล็อบบี้ → เข้าด่าน %s ความยาก %d"):format(expMap(), expDiff()))
                            uiHide(true)
                            call("AE_ENTER_RUN", expMap(), expDiff())

                cachedSettingsBtn = btn
                print("[AE] ⚙️ เจอปุ่มเฟือง Settings แล้ว (จำไว้)")
                return true
            else
                fireButtonConns(btn); task.wait(0.5)   -- กดผิด (เมนู...) → กดปิด
            end
        end
        return settingsOpen()
    end


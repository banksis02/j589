-- ---------- 2) กด E (ProximityPrompt) ----------
local function findEnterPrompt()
    local best, bestDist
    local pos = ENTER_CFRAME.Position
    for _, p in ipairs(workspace:GetDescendants()) do
        if p:IsA("ProximityPrompt") and p.Enabled then
            local part = p.Parent
            local ok, ppos = pcall(function()
                return part:IsA("BasePart") and part.Position
                    or (part:IsA("Model") and part:GetPivot().Position)
            end)
            if ok and ppos then
                local d = (ppos - pos).Magnitude
                local hit = tostring(p.ObjectText):find("Expedition")
                         or tostring(p.ActionText):find("Gamemode")
                if hit and d < 200 then return p end
                if d < 60 and (not bestDist or d < bestDist) then best, bestDist = p, d end
            end
        end
    end
    return best
end

_G.AE_ENTER_PROMPT = function()
    local p = findEnterPrompt()
    if p then
        print(("[Enter] 🎯 เจอ prompt: %s / %s"):format(tostring(p.ObjectText), tostring(p.ActionText)))
        local ok = pcall(function() fireproximityprompt(p, 1) end)
        if ok then task.wait(0.8) end
    else
        print("[Enter] ⚠️ ไม่เจอ ProximityPrompt — กดปุ่ม E แทน")
    end
    -- กด E จริงด้วย (เผื่อ fireproximityprompt ใช้ไม่ได้)
    VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.9)
    VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)

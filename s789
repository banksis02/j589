    for slot, info in pairs(scanSlots()) do
        if isUnitSlot(info) then
            local name = tostring(info.asset):lower():gsub("[^%w]", "")
            if name == a then return slot end
            if name:find(a, 1, true) or a:find(name, 1, true) then best = best or slot end
        end
    end
    return best
end

-- ช่องของตัวจ้าง (IsHelper + เป็นตัวละคร) ที่ยังไม่ได้วาง — เผื่อชื่อ asset ไม่ตรง

    local function clickCraftButton(name, prefixMode)
        local root = craftGuiRoot()
        if not root then return false end
        local lowerTarget = string.lower(name)
        for _, btn in ipairs(root:GetDescendants()) do
            if (btn:IsA("TextButton") or btn:IsA("ImageButton")) and btn.Visible then
                local hit = false
                local function checkText(t)
                    t = t:lower()
                    if prefixMode then return t:sub(1, #lowerTarget) == lowerTarget end
                    return t == lowerTarget
                end
                if btn:IsA("TextButton") and btn.Text ~= "" and checkText(btn.Text) then hit = true end
                if not hit then
                    for _, l in ipairs(btn:GetDescendants()) do
                        if l:IsA("TextLabel") and l.Visible and l.Text ~= "" and checkText(l.Text) then
                            hit = true; break
                        end
                    end
                end
                if hit then return fireButtonConns(btn) > 0 end
            end
        end
        return false
    end

    -- ⭐ v8.1: อ่านจำนวน Grey แบบทนรูปแบบข้อความ
    --    ของจริงมีได้หลายแบบ: "125/125", "125x / 125x", "125x / 125x Owned", มี rich text ปนด้วย
    --    เดิมบังคับ "^125/125$" เป๊ะๆ → อ่านไม่ได้ = 0 → คิดว่าไม่เต็ม → ไม่คราฟ
    local function getGreyCount()
        local root = craftGuiRoot()
        if not root then return 0 end

        local exact, loose = {}, {}
        for _, l in ipairs(root:GetDescendants()) do
            if l:IsA("TextLabel") and l.Visible then
                local t = tostring(l.Text):gsub("<[^>]->", ""):gsub("^%s+", ""):gsub("%s+$", "")
                local h, m = t:match("^([%d,]+)/([%d,]+)$")            -- แบบเป๊ะ "125/125"
                if h then
                    table.insert(exact, { have = tonumber((h:gsub(",", ""))) or 0,
                                          max  = tonumber((m:gsub(",", ""))) or 0 })
                else
                    h, m = t:match("([%d,]+)%s*[xX]?%s*/%s*([%d,]+)")  -- "125x / 125x Owned"
                    if h then
                        table.insert(loose, { have = tonumber((h:gsub(",", ""))) or 0,
                                              max  = tonumber((m:gsub(",", ""))) or 0 })
                    end
                end
            end
        end

        -- ⭐ ตัวหารต้องเป็น 125 (ช่องเก็บ Grey) — กันไปหยิบเลขของไอเทมอื่น
        for _, list in ipairs({ exact, loose }) do
            for _, c in ipairs(list) do
                if c.max == CRAFT_GREY_FULL then return c.have end
            end
        end
        -- ไม่เจอที่หาร 125 → ใช้แบบเป๊ะตัวแรก (พฤติกรรมเดิมที่เคยใช้ได้)
        if exact[1] then return exact[1].have end
        return 0
    end

    -- debug: ดูว่าหน้าคราฟมีตัวเลขอะไรบ้าง (ตอนอ่าน Grey เพี้ยน)

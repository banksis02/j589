-- 🎯 ทำทั้งหมดที่ checkpoint: ไล่จ้างตามลำดับ + วางบนรถ
_G.AE_HIRE_RUN = function()
    local done = {}
    for round = 1, 6 do
        local list = getHelpers()
        if #list == 0 then
            if round == 1 then print("[Hire] ไม่มีตัวให้จ้างที่ checkpoint นี้") end
            break
        end
        -- คัดเฉพาะที่ยังไม่จ้าง + เงินพอ แล้วเรียงตามลำดับ (ลำดับเดียวกันเอาถูกก่อน)
        local pool = {}
        for _, h in ipairs(list) do
            local r = rankOf(h)
            if r and not done[h.key] and not h.hired then
                local cost = h.cost or math.huge
                if getYen() >= cost + KEEP_YEN then
                    h.rank = r; table.insert(pool, h)
                end
            end
        end
        if #pool == 0 then
            print(("[Hire] 💰 เงิน %d — ไม่มีตัวที่ซื้อได้แล้ว"):format(getYen()))
            break
        end
        table.sort(pool, function(a, b)
            if a.rank ~= b.rank then return a.rank < b.rank end
            return (a.cost or 0) < (b.cost or 0)
        end)
        local h = pool[1]
        print(("[Hire] 🛒 จ้าง %s [%s] (%s) ราคา %s | เงิน %d")
            :format(tostring(h.display or h.unit), tostring(h.unit), h.key, tostring(h.cost), getYen()))
        hireOne(h)
        done[h.key] = true
        task.wait(1)
    end
    -- 📖 มี Tome ติดมา → ใส่ให้ยูตะ
    if findTomeSlot() then
        _G.AE_TOME_USE(TOME_TARGET)
        task.wait(0.5)
    end

    -- 🧹 กวาดตัวจ้างที่ยังค้างในช่อง (วางไม่ติดตอนแรก) ให้ลงรถให้หมด
    closeTomePrompt()
    for round = 1, 4 do
        local slot, asset = findHelperSlot()
        if not slot then break end
        print(("[Hire] 🧹 ยังมีตัวจ้างค้างช่อง %d (%s) → วางลงรถ"):format(slot, tostring(asset)))
        if not placeOnPayload(slot, asset) then task.wait(1) end
        task.wait(0.5)
    end

    print("[Hire] 🏁 จบขั้นตอนจ้างตัวที่ checkpoint")
end


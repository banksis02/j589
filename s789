    local function findToggleButton(name)
        local s = player.PlayerGui:FindFirstChild("Settings")
        if not s then return nil end
        local label
        for _, l in ipairs(s:GetDescendants()) do
            if l:IsA("TextLabel") and l.Visible and l.Text == name then label = l; break end

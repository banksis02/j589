                end

                -- ⭐ มอนใหม่ spawn (ChildAdded ที่ Units folder) → ตรวจชื่อ ถ้าเป็นเลข = ศัตรู ซ่อนทันที
                myUnits.ChildAdded:Connect(function(unit)
                    task.wait(0.1)
                    if unit:IsA("Model") and not isPlayerUnit(unit) then
                        pcall(hideEnemyVisuals, unit)
                    end
                end)

                -- ปิด effect ของยูนิตเรา (ทุก descendant ใหม่)
                myUnits.DescendantAdded:Connect(function(d)
                    task.wait(0.05)
                    if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
                       or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles")
                       or d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
                        pcall(function() d.Enabled = false end)
                    end
                end)
            end

            -- Hook Ignore.Effects.ChildAdded สำหรับ effect runtime
            local effects = ignoreFolder:FindFirstChild("Effects")
            if effects then
                effects.DescendantAdded:Connect(function(d)
                    task.wait(0.05)
                    pcall(processInstance, d)
                end)
            end
        end

        -- ⭐ Hook Camera.ChildAdded → visual effects ของยูนิต spawn ใหม่ → ลบทันที
        local camFolder = workspace:FindFirstChild("Camera")
        if camFolder then
            camFolder.ChildAdded:Connect(function(child)
                task.wait(0.05)
                if child:IsA("Model") then
                    for _, d in ipairs(child:GetDescendants()) do
                        if d:IsA("BasePart") or d:IsA("MeshPart") then
                            pcall(function() d.Transparency = 1 end)
                            pcall(function() d.CastShadow = false end)
                        elseif d:IsA("Decal") or d:IsA("Texture") then
                            pcall(function() d.Transparency = 1 end)
                        elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") then
                            pcall(function() d.Enabled = false end)
                        end
                    end
                end
            end)
        end

        -- ⭐ Hook workspace.Map.ChildAdded → boss/มอน spawn ใหม่ใน Map → ซ่อนทันที
        local map = workspace:FindFirstChild("Map")
        if map then
            local KEEP = { Path=true, Spawns=true, Static1=true, Static2=true,
                          ActorSpawn=true, ActorSpawn2=true, ActorSpawn3=true }
            map.ChildAdded:Connect(function(child)
                task.wait(0.1)
                if child:IsA("Model") and not KEEP[child.Name] then
                    pcall(hideEnemyVisuals, child)
                end
            end)

            -- Hook Map.Decorations.DescendantAdded สำหรับ deco ที่ load ทีหลัง
            local deco = map:FindFirstChild("Decorations")
            if deco then
                deco.DescendantAdded:Connect(function(d)
                    task.wait(0.05)
                    if d:IsA("BasePart") or d:IsA("MeshPart") then
                        pcall(function() d.Transparency = 1 end)
                        pcall(function() d.CanCollide = false end)
                        pcall(function() d.CastShadow = false end)
                    end
                end)
            end
        end

        -- รีเฟรชเร็วขึ้นทุก 2 วิ (กัน Humanoid re-render)
        while true do
            task.wait(2)
            pcall(boostFPS)
        end
    end)

end


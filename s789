local function placeOne(entry)
    local rep = getReplica("GamePlayerData")
    if not rep then warn("[Exp Place] ❌ ไม่เจอ GamePlayerData"); return false end

    -- ⭐ หาช่องจากตัวละคร (asset) — ไม่เจอ = ข้าม (ไม่เดาช่อง กันวางผิดตัว)

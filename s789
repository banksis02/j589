                        elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
                           or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then
                            pcall(function() d.Enabled = false end)
                        end
                    end
                end
            end
        end

        -- 8) Terrain.TempVFX
        local tempVfx = workspace.Terrain:FindFirstChild("TempVFX")
        if tempVfx then
            for _, d in ipairs(tempVfx:GetDescendants()) do
                pcall(processInstance, d)

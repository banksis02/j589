-- ============================================================
-- AE Expedition END — จบรัน: อ่านผล/ไอเทมที่ได้ → แจ้งเตือน → กด Repeat Stage
--   _G.AE_EXP_ENDOPEN()  → จบรันหรือยัง (คืน "Victory"/"Defeat"/nil)
--   _G.AE_EXP_ENDDATA()  → อ่านผลทั้งหมด (สถิติ + ไอเทม)
--   _G.AE_EXP_REPEAT()   → กด Repeat Stage
--   _G.AE_EXP_ENDRUN()   → ทำทั้งชุด: อ่าน → แจ้งเตือน → Repeat
--   _G.AE_EXP_ON_END = function(data) ... end   ← สคริปต์หลักเอาไปส่งขึ้นเว็บ
-- ============================================================
local player = game:GetService("Players").LocalPlayer
local VIM    = game:GetService("VirtualInputManager")
local inset  = game:GetService("GuiService"):GetGuiInset()

local function clean(s)
    return (tostring(s):gsub("<[^>]->", ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

-- หา ScreenGui ของหน้าจบเกม (มีคำว่า Victory/Defeat + ปุ่ม Repeat Stage)
local function findEndGui()
    for _, g in ipairs(player.PlayerGui:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled then
            local result, hasRepeat = nil, false
            for _, l in ipairs(g:GetDescendants()) do
                if (l:IsA("TextLabel") or l:IsA("TextButton")) and l.Visible then
                    local t = clean(l.Text)
                    if t == "Victory" or t == "Defeat" then result = t end
                    if t == "Repeat Stage" then hasRepeat = true end
                end
            end
            if result and hasRepeat then return g, result end
        end
    end
    return nil
end

_G.AE_EXP_ENDOPEN = function()
    local _, result = findEndGui()
    return result
end

-- อ่านสถิติ + ไอเทมที่ได้
_G.AE_EXP_ENDDATA = function()
    local gui, result = findEndGui()
    if not gui then return nil end

    local labels = {}
    for _, l in ipairs(gui:GetDescendants()) do
        if l:IsA("TextLabel") and l.Visible then
            local t = clean(l.Text)
            if t ~= "" then
                table.insert(labels, { t = t, x = l.AbsolutePosition.X, y = l.AbsolutePosition.Y,
                                       w = l.AbsoluteSize.X, h = l.AbsoluteSize.Y })
            end
        end
    end
    table.sort(labels, function(a, b)
        if math.abs(a.y - b.y) > 8 then return a.y < b.y end
        return a.x < b.x
    end)

    -- สถิติ: ป้ายชื่อ + ค่าที่อยู่แถวเดียวกันทางขวา
    local WANT = { ["Clear Time"] = "clearTime", ["Total Yen"] = "yen",
                   ["Total Kills"] = "kills", ["Total Damage"] = "damage" }
    local stats = {}
    for i, e in ipairs(labels) do
        local key = WANT[e.t]
        if key then
            for j = i + 1, math.min(i + 4, #labels) do
                local n = labels[j]
                if math.abs(n.y - e.y) < 12 and n.x > e.x and not WANT[n.t] then
                    stats[key] = n.t; break
                end
            end
        end
    end

    -- ไอเทม: ป้าย "8x" คู่กับชื่อไอเทมที่อยู่ใต้/ใกล้ที่สุด
    local items = {}
    for i, e in ipairs(labels) do
        local n = e.t:match("^(%d+)x$")
        if n then
            local best, bestD
            for j = 1, #labels do
                local c = labels[j]
                if j ~= i and not c.t:match("^%d+x$") and not WANT[c.t] then
                    local dx, dy = c.x - e.x, c.y - e.y
                    if dy >= 0 and dy < 90 and math.abs(dx) < 80 then
                        local d = dy + math.abs(dx)
                        if not bestD or d < bestD then best, bestD = c.t, d end
                    end
                end
            end
            if best then
                items[best] = (items[best] or 0) + tonumber(n)
            end
        end
    end

    local data = { result = result, stats = stats, items = items,
                   map = nil, difficulty = nil, time = os.time() }
    -- ชื่อด่าน + ความยาก
    for _, e in ipairs(labels) do
        if e.t:find(" - Expedition", 1, true) then data.map = e.t end
        local d = e.t:match("^Difficulty%s*(%d+)$")
        if d then data.difficulty = tonumber(d) end
    end

    -- สรุปเป็นข้อความ
    local lines = { ("===== จบรัน: %s ====="):format(result) }
    if data.map then table.insert(lines, "ด่าน: " .. data.map ..
        (data.difficulty and ("  (ความยาก %d)"):format(data.difficulty) or "")) end
    table.insert(lines, ("เวลา %s | Yen %s | Kills %s | Damage %s")
        :format(stats.clearTime or "-", stats.yen or "-", stats.kills or "-", stats.damage or "-"))
    table.insert(lines, "ไอเทมที่ได้:")
    local names = {}
    for k in pairs(items) do table.insert(names, k) end
    table.sort(names, function(a, b) return items[a] > items[b] end)
    for _, k in ipairs(names) do table.insert(lines, ("   %-22s x%d"):format(k, items[k])) end
    data.text = table.concat(lines, "\n")
    return data
end

-- กดปุ่ม Repeat Stage
local function clickHard(b)
    pcall(function() for _, c in ipairs(getconnections(b.MouseButton1Click)) do c:Fire() end end)
    pcall(function() for _, c in ipairs(getconnections(b.Activated)) do c:Fire() end end)
    task.wait(0.25)
    pcall(function()
        local cx = b.AbsolutePosition.X + b.AbsoluteSize.X / 2
        local cy = b.AbsolutePosition.Y + b.AbsoluteSize.Y / 2 + inset.Y
        VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
        task.wait(0.06)
        VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
    end)
end

_G.AE_EXP_REPEAT = function()
    local gui = findEndGui()
    if not gui then warn("[End] ❌ ไม่ได้อยู่หน้าจบเกม"); return false end
    for _, b in ipairs(gui:GetDescendants()) do
        if b:IsA("GuiButton") and b.Visible then
            local hit = (b:IsA("TextButton") and clean(b.Text) == "Repeat Stage")
            if not hit then
                for _, l in ipairs(b:GetDescendants()) do
                    if l:IsA("TextLabel") and l.Visible and clean(l.Text) == "Repeat Stage" then hit = true; break end
                end
            end
            if hit then
                print("[End] 🔁 กด Repeat Stage")
                clickHard(b)
                task.wait(1.5)
                return true
            end
        end
    end
    warn("[End] ❌ ไม่เจอปุ่ม Repeat Stage")
    return false
end

-- ⭐ ชุดเต็ม: อ่านผล → แจ้งเตือน → Repeat
local lastEndAt = 0
_G.AE_EXP_ENDRUN = function()
    if not findEndGui() then return false end
    if tick() - lastEndAt < 20 then return false end     -- กันทำซ้ำจอเดิม
    lastEndAt = tick()

    local data = _G.AE_EXP_ENDDATA()
    if data then
        -- ⭐ โชว์บรรทัดเดียวสั้นๆ (ไม่ dump ยาว + ไม่ setclipboard — เดิมมันรบกวน ctrl+c)
        print(("[End] 🏁 %s | Yen %s | Kills %s")
            :format(tostring(data.result), tostring(data.stats and data.stats.yen or "-"),
                    tostring(data.stats and data.stats.kills or "-")))
        -- ส่งขึ้นเว็บ (คงไว้ — ระบบสั่งงานต้องใช้)
        if type(_G.AE_EXP_ON_END) == "function" then
            pcall(_G.AE_EXP_ON_END, data)
        end
    end
    task.wait(1)
    return _G.AE_EXP_REPEAT()
end

print("[End] ✅ พร้อม — _G.AE_EXP_ENDDATA() / _G.AE_EXP_REPEAT() / _G.AE_EXP_ENDRUN()")

end

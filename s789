local function inVillainStage()
    -- ⭐ อยู่ในด่าน = เจอ workspace.Map.Paths ที่มีเลน (waypoint) จริง
    --    (ล็อบบี้ไม่มี Map.Paths — ตัวนี้ชัวร์กว่าเช็ค GameState.Active ที่บางทีมาช้า)
    local map = workspace:FindFirstChild("Map")

-- ⭐ ยึดป้ายในแผนที่เป็นหลักเสมอ (ค่าจาก GameState เชื่อไม่ได้ 100%)
-- ⭐ เชื่อเฉพาะป้ายในแผนที่เท่านั้น (GameState ให้ 5/5 มั่วมาแล้ว 2 ครั้ง)
--    คืน nil = อ่านไม่ได้ → ห้ามถือว่าจบรัน (เดินต่อปลอดภัยกว่าจบก่อนเวลา)
local function progressViaMap()
    local cur, total = mapProgressUI()
    if cur then return cur, total end                -- แผนที่เปิดอยู่แล้ว
    for attempt = 1, 2 do
        if clickByText("Expedition Map", 3) then
            local t0 = tick()
            while tick() - t0 < 4 do                 -- รอแผนที่โหลด (ป้ายโผล่ช้า)
                cur, total = mapProgressUI()
                if cur then break end
                task.wait(0.4)
            end
            clickByText("Back", 3)                    -- ปิดกลับเสมอ
            task.wait(0.8)
            if cur then
                print(("[Exp] 🗺️ เช็คจากแผนที่: %d/%d โหนด"):format(cur, total or 10))
                return cur, total
            end
        end
        task.wait(1)
    end
    local sc, st = mapProgressState()
    if sc then print(("[Exp] 📊 (อ้างอิงเฉยๆ) GameState: %d/%d โหนด — ไม่ใช้ตัดสินใจ"):format(sc, st)) end
    return nil
end

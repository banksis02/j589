    --    2) Fallback: ถ้ายังไม่เคยเห็น ยิงช่วงกว้าง 64-70 (server ignore ตัวที่ผิด)
    local learnedOp = {}        -- action name -> opcode ล่าสุดที่เกมยิงเอง
    local scriptFiring = false  -- กันดักเลขที่สคริปต์ยิงเอง
    pcall(function()
        local replicaSig = game:GetService("ReplicatedStorage")
            :WaitForChild("RemoteEvents", 5):WaitForChild("ReplicaSignal", 5)
        -- ⭐ เรียนรู้เฉพาะเมื่อเห็น "เลขเดิมซ้ำ 2 ครั้งติด" — การยิงจริงของเกมใช้เลขเดิมตลอด
        --    ส่วนการยิงสเปรย์ fallback (66,64,65,67,...) เลขไม่ซ้ำติดกัน → ถูกกรองทิ้งเอง
        --    (กันทั้งของตัวเองและสคริปต์อื่นที่ยิงสเปรย์เหมือนกัน)
        local lastSeen = {}
        local oldNC
        oldNC = hookmetamethod(game, "__namecall", function(self, ...)
            if not scriptFiring and self == replicaSig
               and getnamecallmethod() == "FireServer" then
                local a1, a2 = ...
                if type(a1) == "number" and type(a2) == "string" then
                    if lastSeen[a2] == a1 then
